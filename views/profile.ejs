<%- include('partials/header') %>

<!-- Page-scoped root: declared in the template so the layout never depends on
     a route-local class (a long-running Node process can cache the old route). -->
<div class="profile-page">

<%
  // All values shown here come from the logged-in account. Every optional value
  // has a fallback so a missing field can never crash the whole profile page.
  function poText(value, fallback) {
    return (value === undefined || value === null || value === '') ? fallback : String(value);
  }

  var isActive = !!currentUser.active;
  var userCode = 'USR-' + String(currentUser.id || '').padStart(4, '0');
  var student = (typeof studentInfo !== 'undefined' && studentInfo) ? studentInfo : null;
  var isStudentAccount = currentUser.role === 'requester';
  // Student identity, grade and section come from the shared Student Directory
  // record. The account fields remain the source for contact/account details.
  var displayName = isStudentAccount && student
    ? poText(student.fullName || student.name, currentUser.name)
    : poText(currentUser.name, 'Unnamed account');
  var displayEmail = poText(currentUser.email, 'Not provided');
  var displayPhone = poText(currentUser.phone, 'Not provided');
  var displayAddress = poText(currentUser.address || (student && student.address), 'Not provided');
  var displayDepartment = poText(currentUser.department, 'Not specified');
  var displayStudentId = isStudentAccount
    ? poText((student && student.studentId) || currentUser.studentId, 'Not assigned')
    : '';
  var displayGradeLevel = isStudentAccount
    ? poText((student && student.gradeLevel) || currentUser.gradeLevel, 'Not specified')
    : '';
  var displaySection = isStudentAccount
    ? poText((student && student.section) || currentUser.section, 'None assigned')
    : '';
  var roleLabel = isStudentAccount && currentUser.accountKind === 'teacher' ? 'Teacher'
    : isStudentAccount ? 'Student' : (typeof C !== 'undefined' && C.ROLES && C.ROLES[currentUser.role])
    ? C.ROLES[currentUser.role] : poText(currentUser.role, 'Account');

  // Older cached route versions may not pass these locals; derive safe defaults.
  var scopeText = (typeof activityScope !== 'undefined' && activityScope) ? activityScope
    : (currentUser.role === 'technician' ? 'Requests assigned to you'
      : currentUser.role === 'admin' ? 'System-wide request activity across all accounts'
        : 'Requests you submitted');
  var activityStats = (typeof stats !== 'undefined' && stats) ? stats
    : { total: 0, pending: 0, approved: 0, completed: 0 };

  var editAction = `<button type="button" class="btn-banner-sub" data-open-profile-modal>${icon('edit')} Edit Profile</button>`;
%>
<%- include('partials/header-banner', {
  title: 'My Profile',
  subtitle: 'Your identity, account details, and request activity at a glance.',
  extraActions: editAction
}) %>

<!-- SECTION 1: PROFILE HEADER -->
<section class="po-hero" aria-label="Profile header">
  <div class="po-hero-body">
    <div class="po-identity">
      <%- include('partials/avatar', {
        user: currentUser,
        name: displayName,
        size: 'xl',
        showStatus: true,
        className: 'profile-hero-avatar'
      }) %>
      <div class="po-identity-text">
        <div class="po-name-row">
          <h2><%= displayName %></h2>
          <span class="po-role-badge"><%- icon('shield') %> <%= roleLabel %></span>
          <span class="badge <%= isActive ? 'badge-green' : 'badge-red' %>">
            <%- icon(isActive ? 'check-circle' : 'x-circle') %> <%= isActive ? 'Active' : 'Inactive' %>
          </span>
        </div>
        <div class="po-identity-chips">
          <span class="po-id-chip"><%- icon('id-card') %> User ID <strong class="po-mono"><%= userCode %></strong></span>
          <% if (isStudentAccount) { %>
            <span class="po-id-chip"><%- icon('award') %> Student ID <strong class="po-mono"><%= displayStudentId %></strong></span>
          <% } %>
        </div>
      </div>
    </div>
    <div class="po-profile-actions">
      <div class="po-department-box">
        <span class="po-department-label"><%- icon('building') %> Department / Office / Club</span>
        <strong><%= displayDepartment %></strong>
      </div>
    </div>
  </div>
</section>

<div class="po-detail-grid">
  <!-- SECTION 2: PERSONAL INFORMATION -->
  <section class="card po-panel po-info-panel" aria-labelledby="po-info-title">
    <div class="po-panel-head">
      <span class="po-panel-icon"><%- icon('user') %></span>
      <div>
        <h3 id="po-info-title">Personal Information</h3>
        <p>Read-only details from your account</p>
      </div>
    </div>
    <dl class="po-info-list">
      <div class="po-info-row">
        <dt><span class="po-info-icon"><%- icon('user') %></span><span class="po-info-label">Full Name</span></dt>
        <dd><%= displayName %></dd>
      </div>
      <% if (isStudentAccount) { %>
        <div class="po-info-row">
          <dt><span class="po-info-icon"><%- icon('id-card') %></span><span class="po-info-label">Student ID</span></dt>
          <dd class="po-mono"><%= displayStudentId %></dd>
        </div>
      <% } %>
      <div class="po-info-row">
        <dt><span class="po-info-icon"><%- icon('mail') %></span><span class="po-info-label">Email Address</span></dt>
        <dd><%= displayEmail %></dd>
      </div>
      <div class="po-info-row">
        <dt><span class="po-info-icon"><%- icon('phone') %></span><span class="po-info-label">Phone Number</span></dt>
        <dd><%= displayPhone %></dd>
      </div>
      <div class="po-info-row">
        <dt><span class="po-info-icon"><%- icon('map-pin') %></span><span class="po-info-label">Address</span></dt>
        <dd><%= displayAddress %></dd>
      </div>
      <% if (isStudentAccount) { %>
        <div class="po-info-row">
          <dt><span class="po-info-icon"><%- icon('cap') %></span><span class="po-info-label">Grade Level</span></dt>
          <dd><%= displayGradeLevel %></dd>
        </div>
        <div class="po-info-row">
          <dt><span class="po-info-icon"><%- icon('layers') %></span><span class="po-info-label">Section</span></dt>
          <dd><%= displaySection %></dd>
        </div>
      <% } else { %>
        <div class="po-info-row">
          <dt><span class="po-info-icon"><%- icon('building') %></span><span class="po-info-label">Department / Office / Club</span></dt>
          <dd><%= displayDepartment %></dd>
        </div>
      <% } %>
    </dl>
  </section>

  <!-- SECTION 3: ACCOUNT INFORMATION -->
  <section class="po-account-panel" aria-labelledby="po-account-title">
    <div class="po-panel-head po-account-head">
      <span class="po-panel-icon"><%- icon('shield') %></span>
      <div>
        <h3 id="po-account-title">Account Information</h3>
        <p>Your account registration and access details</p>
      </div>
    </div>
    <div class="po-account-grid">
      <article class="po-mini-card">
        <span class="po-mini-icon po-tone-<%= isActive ? 'green' : 'red' %>"><%- icon('shield') %></span>
        <div class="po-mini-body">
          <span class="po-mini-label">Account Status</span>
          <span class="badge <%= isActive ? 'badge-green' : 'badge-red' %>"><%= isActive ? 'Active' : 'Inactive' %></span>
        </div>
      </article>
      <article class="po-mini-card">
        <span class="po-mini-icon po-tone-blue"><%- icon('calendar') %></span>
        <div class="po-mini-body">
          <span class="po-mini-label">Date Registered</span>
          <strong class="po-mini-value"><%= currentUser.createdAt ? fmtDate(currentUser.createdAt) : '—' %></strong>
          <% if (currentUser.createdAt) { %><span class="po-mini-sub"><%= timeAgo(currentUser.createdAt) %></span><% } %>
        </div>
      </article>
      <article class="po-mini-card">
        <span class="po-mini-icon po-tone-amber"><%- icon('clock') %></span>
        <div class="po-mini-body">
          <span class="po-mini-label">Last Login</span>
          <strong class="po-mini-value"><%= currentUser.lastLoginAt ? fmtDateTime(currentUser.lastLoginAt) : 'Never' %></strong>
          <% if (currentUser.lastLoginAt) { %><span class="po-mini-sub"><%= timeAgo(currentUser.lastLoginAt) %></span><% } %>
        </div>
      </article>
      <article class="po-mini-card">
        <span class="po-mini-icon po-tone-maroon"><%- icon('user-check') %></span>
        <div class="po-mini-body">
          <span class="po-mini-label">Account Role</span>
          <strong class="po-mini-value"><%= roleLabel %></strong>
          <span class="po-mini-sub"><%= userCode %></span>
        </div>
      </article>
    </div>
  </section>
</div>

<!-- SECTION 4: ACCOUNT ACTIVITY -->
<section class="card po-panel po-activity-panel" aria-labelledby="po-activity-title">
  <div class="po-panel-head">
    <span class="po-panel-icon"><%- icon('chart') %></span>
    <div>
      <h3 id="po-activity-title">Account Activity</h3>
      <p><%= scopeText %></p>
    </div>
  </div>
  <div class="po-activity-grid">
    <article class="po-stat-card po-tone-maroon">
      <div class="po-stat-top">
        <span class="po-stat-icon"><%- icon('file') %></span>
        <span class="po-stat-label">Total Requests</span>
      </div>
      <strong class="po-stat-value"><%= poText(activityStats.total, 0) %></strong>
      <span class="po-stat-hint">All requests in this view</span>
    </article>
    <article class="po-stat-card po-tone-amber">
      <div class="po-stat-top">
        <span class="po-stat-icon"><%- icon('clock') %></span>
        <span class="po-stat-label">Pending Requests</span>
      </div>
      <strong class="po-stat-value"><%= poText(activityStats.pending, 0) %></strong>
      <span class="po-stat-hint"><%= currentUser.role === 'technician' ? 'Awaiting your action' : 'Awaiting review' %></span>
    </article>
    <article class="po-stat-card po-tone-blue">
      <div class="po-stat-top">
        <span class="po-stat-icon"><%- icon('check-circle') %></span>
        <span class="po-stat-label">Approved Requests</span>
      </div>
      <strong class="po-stat-value"><%= poText(activityStats.approved, 0) %></strong>
      <span class="po-stat-hint">Cleared to proceed</span>
    </article>
    <article class="po-stat-card po-tone-green">
      <div class="po-stat-top">
        <span class="po-stat-icon"><%- icon('check') %></span>
        <span class="po-stat-label">Completed Requests</span>
      </div>
      <strong class="po-stat-value"><%= poText(activityStats.completed, 0) %></strong>
      <span class="po-stat-hint">Successfully resolved</span>
    </article>
  </div>
</section>

<%- include('partials/profile-edit-modal') %>

</div><!-- /.profile-page -->

<%- include('partials/footer') %>
