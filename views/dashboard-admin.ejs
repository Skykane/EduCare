<%- include('partials/header') %>
<%
  // Canonical repair statuses (kept literal so views stay correct even before
  // shared constants are exposed to every render context).
  var S = {
    pendingApproval: 'Pending Approval',
    awaitingAssignment: 'Approved – Awaiting Assignment',
    assigned: 'Assigned',
    inProgress: 'In Progress',
    onHold: 'On Hold',
    completed: 'Completed',
    rejected: 'Rejected'
  };

  function rows(value) { return Array.isArray(value) ? value : []; }
  var pendingApprovalRows = rows(typeof pendingApproval !== 'undefined' ? pendingApproval : null);
  var awaitingRows = rows(typeof awaitingAssignment !== 'undefined' ? awaitingAssignment : null);
  var activeRows = rows(typeof activeTasks !== 'undefined' ? activeTasks : null);
  var completedRows = rows(typeof completedRequests !== 'undefined' ? completedRequests : null);
  var rejectedRows = rows(typeof rejectedRequests !== 'undefined' ? rejectedRequests : null);

  var techs = rows(typeof technicians !== 'undefined' ? technicians : null);
  if (!techs.length && typeof workload !== 'undefined' && Array.isArray(workload)) {
    techs = workload.map(function (w) {
      var t = w.tech || {};
      return { id: t.id, name: t.name, availability: t.availability, activeCount: w.active || 0 };
    }).filter(function (t) { return !!t.id; });
  }
  var availableTechs = techs.filter(function (t) { return t.availability === 'Available'; });
  var today = typeof todayISO === 'function' ? todayISO() : new Date().toISOString().slice(0, 10);

  function ic(name) { return typeof icon === 'function' ? icon(name) : ''; }
  function sc(status) { return typeof statusClass === 'function' ? statusClass(status) : 'badge badge-gray'; }
  function dt(value) { return typeof fmtDateTime === 'function' ? fmtDateTime(value) : String(value || ''); }
  function dtOnly(value) { return typeof fmtDate === 'function' ? fmtDate(value) : String(value || ''); }
  function statusUrl(status) { return '/requests?status=' + encodeURIComponent(status); }
  function requestName(r) {
    if (!r) return { title: 'Repair request', sub: '' };
    var eq = r.equipment;
    var cat = r.category ? r.category.name : '';
    var sub = eq
      ? [eq.code, eq.name].filter(Boolean).join(' · ')
      : [cat, r.location].filter(Boolean).join(' · ');
    return { title: r.title || (eq ? eq.name : 'Repair request'), sub: sub || 'General repair' };
  }
  function workSummary(r) {
    if (!r) return 'See completion report';
    return r.workPerformed || r.completionNotes ||
      (r.record && r.record.actionsTaken) ||
      (r.maintenanceRecord && r.maintenanceRecord.actionsTaken) ||
      'See completion report';
  }

  var adminExtraActions = '<a href="/requests/new" class="btn-banner-sub">' + ic('plus') + ' Submit Request</a>';
  var cards = [
    { label: 'Pending Approval', count: pendingApprovalRows.length, tone: 'amber', icon: 'clock', status: S.pendingApproval, note: 'Reports awaiting admin review' },
    { label: 'Awaiting Assignment', count: awaitingRows.length, tone: 'primary', icon: 'user-check', status: S.awaitingAssignment, note: 'Approved, ready to dispatch' },
    { label: 'Active Tasks', count: activeRows.length, tone: 'blue', icon: 'wrench', status: '', note: 'Assigned, in progress, or on hold' },
    { label: 'Completed Requests', count: completedRows.length, tone: 'green', icon: 'check-circle', status: S.completed, note: 'Repairs finished' },
    { label: 'Rejected Requests', count: rejectedRows.length, tone: 'red', icon: 'x-circle', status: S.rejected, note: 'Reviewed and declined' }
  ];
%>
<div class="admin-ui-page admin-ui-dashboard dash adm-dash adm-workflow-dash">
  <%- include('partials/header-banner', {
    breadcrumb: 'Home',
    title: 'Dashboard',
    subtitle: 'Repair workflow, dispatch queue, completion reports, and technician availability.',
    extraActions: adminExtraActions
  }) %>

  <!-- Compact workflow summary -->
  <div class="adm-summary adm-summary-cards">
    <% cards.forEach(function (c) { %>
      <a class="adm-stat" href="<%= c.status ? statusUrl(c.status) : '/requests' %>">
        <span class="adm-stat-ic tone-<%= c.tone %>"><%- ic(c.icon) %></span>
        <span class="adm-stat-body">
          <strong class="adm-stat-num"><%= c.count %></strong>
          <span class="adm-stat-label"><%= c.label %></span>
          <span class="adm-stat-note"><%= c.note %></span>
        </span>
      </a>
    <% }) %>
  </div>

  <!-- 1. Pending Approval -->
  <section class="adm-panel" id="pending-approval" aria-labelledby="adm-pending-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-amber"><%- ic('clipboard') %></span>
        <h2 id="adm-pending-title">Pending Approval</h2>
        <span class="adm-count"><%= pendingApprovalRows.length %></span>
      </div>
      <a class="adm-panel-link" href="<%= statusUrl(S.pendingApproval) %>">View all <%- ic('chevron-right') %></a>
    </div>
    <% if (!pendingApprovalRows.length) { %>
      <p class="adm-empty"><%- ic('check-circle') %> No reports are waiting for approval.</p>
    <% } else { %>
      <div class="wf-list">
        <% pendingApprovalRows.forEach(function (r) { var name = requestName(r); %>
          <div class="workflow-row adm-wf-row">
            <span class="wf-main">
              <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
              <strong><%= name.title %></strong>
              <span class="muted"><%= name.sub %></span>
            </span>
            <span class="wf-meta">
              <span class="<%= sc(S.pendingApproval) %>"><%= S.pendingApproval %></span>
              <span class="muted">From <%= r.requester ? r.requester.name : 'Requester' %> · <%= dt(r.submittedAt || r.reportedAt || r.createdAt) %></span>
            </span>
            <span class="wf-action"><a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Review <%- ic('chevron-right') %></a></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- 2. Awaiting Assignment (admin assigns inline) -->
  <section class="adm-panel" id="awaiting-assignment" aria-labelledby="adm-awaiting-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-primary"><%- ic('user-check') %></span>
        <h2 id="adm-awaiting-title">Awaiting Assignment</h2>
        <span class="adm-count"><%= awaitingRows.length %></span>
      </div>
      <a class="adm-panel-link" href="<%= statusUrl(S.awaitingAssignment) %>">View all <%- ic('chevron-right') %></a>
    </div>
    <% if (!awaitingRows.length) { %>
      <p class="adm-empty"><%- ic('check-circle') %> Nothing is waiting for a technician.</p>
    <% } else { %>
      <div class="wf-list">
        <% awaitingRows.forEach(function (r) { var name = requestName(r); %>
          <div class="workflow-row adm-wf-row">
            <span class="wf-main">
              <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
              <strong><%= name.title %></strong>
              <span class="muted"><%= name.sub %> · <%= r.requester ? r.requester.name : 'Requester' %> · <%= dt(r.approvedAt || r.submittedAt || r.createdAt) %></span>
            </span>
            <span class="wf-meta">
              <span class="<%= sc(S.awaitingAssignment) %>"><%= S.awaitingAssignment %></span>
              <% if (r.effectivePriority) { %><span class="muted"><%= r.effectivePriority %> priority</span><% } %>
            </span>
            <span class="wf-action">
              <% if (availableTechs.length) { %>
                <form method="post" action="/requests/<%= r.id %>/assign" class="wf-assign-form">
                  <label class="wf-label" for="assign-tech-<%= r.id %>">Technician</label>
                  <select data-ec-select="1" id="assign-tech-<%= r.id %>" name="technicianId" required>
                    <option value="">Choose available technician…</option>
                    <% availableTechs.forEach(function (t) { %>
                      <option value="<%= t.id %>"><%= t.name %> · <%= t.activeCount %> active<%= t.activeCount === 1 ? '' : 's' %></option>
                    <% }) %>
                  </select>
                  <label class="wf-label" for="assign-target-<%= r.id %>">Target date</label>
                  <input type="date" id="assign-target-<%= r.id %>" name="targetDate" min="<%= today %>" value="<%= r.targetDate || '' %>">
                  <button class="btn btn-primary btn-sm" type="submit"><%- ic('user-check') %> Assign</button>
                </form>
              <% } else { %>
                <span class="muted">No available technicians. <a href="/technicians">Manage team</a></span>
              <% } %>
              <a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Details</a>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- 3. Active Tasks -->
  <section class="adm-panel" id="active-tasks" aria-labelledby="adm-active-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-blue"><%- ic('wrench') %></span>
        <h2 id="adm-active-title">Active Tasks</h2>
        <span class="adm-count"><%= activeRows.length %></span>
      </div>
      <a class="adm-panel-link" href="/requests?status=active">View all <%- ic('chevron-right') %></a>
    </div>
    <% if (!activeRows.length) { %>
      <p class="adm-empty"><%- ic('check-circle') %> No repair work is currently active.</p>
    <% } else { %>
      <div class="wf-list">
        <% activeRows.forEach(function (r) { var name = requestName(r); %>
          <div class="workflow-row adm-wf-row">
            <span class="wf-main">
              <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
              <strong><%= name.title %></strong>
              <span class="muted"><%= name.sub %></span>
            </span>
            <span class="wf-meta">
              <span class="<%= sc(r.status) %>"><%= r.status %></span>
              <span class="muted"><%= r.technician ? r.technician.name : 'Unassigned' %><% if (r.targetDate) { %> · Due <%= dtOnly(r.targetDate) %><% } %></span>
            </span>
            <span class="wf-action"><a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Open <%- ic('chevron-right') %></a></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- 4. Completed Requests -->
  <section class="adm-panel" id="completed-requests" aria-labelledby="adm-completed-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-green"><%- ic('check-circle') %></span>
        <h2 id="adm-completed-title">Completed Requests</h2>
        <span class="adm-count"><%= completedRows.length %></span>
      </div>
      <a class="adm-panel-link" href="<%= statusUrl(S.completed) %>">View all <%- ic('chevron-right') %></a>
    </div>
    <% if (!completedRows.length) { %>
      <p class="adm-empty"><%- ic('check-circle') %> No completed repairs yet.</p>
    <% } else { %>
      <div class="wf-list">
        <% completedRows.forEach(function (r) { var name = requestName(r); %>
          <div class="workflow-row adm-wf-row">
            <span class="wf-main">
              <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
              <strong><%= name.title %></strong>
              <span class="muted">Completed <%= dt(r.completedAt) %> · <%= workSummary(r) %></span>
              <span class="wf-links">
                <a href="/requests/<%= r.id %>#docs"><%- ic('camera') %> Completion photos</a>
                <a href="/requests/<%= r.id %>#timeline"><%- ic('history') %> Full history</a>
              </span>
            </span>
            <span class="wf-meta">
              <span class="<%= sc(S.completed) %>"><%= S.completed %></span>
              <span class="<%= sc(r.verificationStatus || 'Not Submitted') %>"><%= r.verificationStatus || 'Not Submitted' %></span>
              <span class="muted"><%= r.technician ? r.technician.name : '—' %></span>
            </span>
            <span class="wf-action"><a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Report <%- ic('chevron-right') %></a></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- 5. Rejected Requests -->
  <section class="adm-panel" id="rejected-requests" aria-labelledby="adm-rejected-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-red"><%- ic('x-circle') %></span>
        <h2 id="adm-rejected-title">Rejected Requests</h2>
        <span class="adm-count"><%= rejectedRows.length %></span>
      </div>
      <a class="adm-panel-link" href="<%= statusUrl(S.rejected) %>">View all <%- ic('chevron-right') %></a>
    </div>
    <% if (!rejectedRows.length) { %>
      <p class="adm-empty"><%- ic('check-circle') %> No rejected requests.</p>
    <% } else { %>
      <div class="wf-list">
        <% rejectedRows.forEach(function (r) { var name = requestName(r); %>
          <div class="workflow-row adm-wf-row">
            <span class="wf-main">
              <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
              <strong><%= name.title %></strong>
              <span class="muted">Reason: <%= r.rejectionReason || 'No reason recorded' %></span>
            </span>
            <span class="wf-meta">
              <span class="<%= sc(S.rejected) %>"><%= S.rejected %></span>
              <span class="muted"><%= r.rejectedAt ? dt(r.rejectedAt) : '—' %></span>
            </span>
            <span class="wf-action"><a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Details <%- ic('chevron-right') %></a></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Technician availability summary -->
  <section class="adm-panel" id="technician-availability" aria-labelledby="adm-tech-title">
    <div class="adm-panel-head">
      <div class="adm-panel-title">
        <span class="adm-icon-chip tone-primary"><%- ic('users') %></span>
        <h2 id="adm-tech-title">Technician Availability</h2>
        <span class="adm-count"><%= techs.length %></span>
      </div>
      <a class="adm-panel-link" href="/technicians">Manage team <%- ic('chevron-right') %></a>
    </div>
    <% if (!techs.length) { %>
      <p class="adm-empty">No active technicians found.</p>
    <% } else { %>
      <% var maxLoad = techs.reduce(function (max, t) { return Math.max(max, Number(t.activeCount) || 0); }, 1); %>
      <div class="adm-tech-list">
        <% techs.forEach(function (t) { var load = Number(t.activeCount) || 0; %>
          <a class="adm-tech-row" href="/technicians/<%= t.id %>">
            <span class="adm-tech-id">
              <span class="adm-tech-name">
                <strong><%= t.name %></strong>
                <span class="<%= sc(t.availability || 'Unknown') %>"><%= t.availability || 'Unknown' %></span>
              </span>
              <span class="adm-tech-meta">Active assignments</span>
            </span>
            <span class="adm-tech-load" title="<%= load %> active assignment<%= load === 1 ? '' : 's' %>">
              <span class="adm-load-bar"><span style="width:<%= maxLoad ? (load / maxLoad * 100).toFixed(0) : 0 %>%"></span></span>
              <span class="adm-load-num"><%= load %></span>
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
