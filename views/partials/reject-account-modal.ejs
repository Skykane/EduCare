<!-- Shared rejection-reason dialog for pending account approvals. -->
<div id="reject-account-modal" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:120;align-items:center;justify-content:center;padding:16px;">
  <div class="modal-card card" style="max-width:480px;width:100%;margin:0;box-shadow:0 12px 36px rgba(0,0,0,0.3);">
    <div class="modal-head" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <h2 style="margin:0;color:var(--red);display:flex;align-items:center;gap:8px;font-size:16px;">
        <%- icon('alert') %> Reject Registration
      </h2>
      <button type="button" class="btn-link" onclick="closeRejectAccountModal()" style="font-size:18px;cursor:pointer;">✕</button>
    </div>
    <p style="font-size:13.5px;line-height:1.4;margin:0 0 14px;">
      Decline the registration for <strong id="reject-account-name">this user</strong>. A reason is required and will be recorded in the audit trail.
    </p>
    <form method="post" id="reject-account-form" action="">
      <div class="field">
        <label for="reject-account-reason">Reason for rejection *</label>
        <textarea id="reject-account-reason" name="reason" rows="3" maxlength="500" required placeholder="e.g. Student ID could not be verified"></textarea>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
        <button type="button" class="btn btn-light" onclick="closeRejectAccountModal()">Cancel</button>
        <button type="submit" class="btn btn-danger">Confirm Rejection</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectAccountModal(id, name) {
    var modal = document.getElementById('reject-account-modal');
    var form = document.getElementById('reject-account-form');
    if (!modal || !form) return;
    form.action = '/users/' + id + '/reject';
    document.getElementById('reject-account-name').textContent = name || 'this user';
    document.getElementById('reject-account-reason').value = '';
    modal.style.display = 'flex';
    document.getElementById('reject-account-reason').focus();
  }
  function closeRejectAccountModal() {
    var modal = document.getElementById('reject-account-modal');
    if (modal) modal.style.display = 'none';
  }
  // Delegated so refreshed user results keep working without a page reload.
  document.addEventListener('click', function (event) {
    var btn = event.target && event.target.closest ? event.target.closest('.js-reject-account') : null;
    if (!btn) return;
    openRejectAccountModal(btn.getAttribute('data-id'), btn.getAttribute('data-name'));
  });
</script>
