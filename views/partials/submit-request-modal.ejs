<% if (currentUser && currentUser.role !== 'technician') {
     var eqList = typeof allEquipment === 'function' ? allEquipment() : (typeof equipment !== 'undefined' ? equipment : []);
     var catList = typeof allCategories === 'function' ? allCategories() : (typeof categories !== 'undefined' ? categories : []);
     var locList = typeof allLocations === 'function' ? allLocations() : (typeof locations !== 'undefined' ? locations : [...new Set(eqList.map(function(e){ return e.location; }).filter(Boolean))].sort());
     var sev = {
       1: { label: 'Minor', help: 'Still usable', icon: 'check-circle' },
       2: { label: 'Moderate', help: 'Needs attention', icon: 'alert-circle' },
       3: { label: 'Major', help: 'Cannot be used', icon: 'alert' },
       4: { label: 'Critical', help: 'Safety risk', icon: 'octagon' },
     };
%>
<!-- Floating Card: Submit Repair Request Modal -->
<div id="submit-request-modal" class="submit-modal-backdrop" style="display:none;" onclick="closeSubmitRequestModal(event)">
  <div class="submit-modal-card" style="max-width:680px;" onclick="event.stopPropagation()">
    <!-- Floating Card Header -->
    <div class="submit-modal-header">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;">
          <span style="display:inline-grid;place-items:center;width:26px;height:26px;border-radius:8px;background:rgba(140,23,36,0.1);color:var(--primary);">
            <%- icon('plus') %>
          </span>
          <h2 style="margin:0;font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.3px;">Submit Request</h2>
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--muted);">Tell us which equipment is damaged and what is wrong.</p>
      </div>
      <button type="button" class="submit-modal-close" onclick="closeSubmitRequestModal()" aria-label="Close modal" title="Close (Esc)">&times;</button>
    </div>

    <!-- Floating Card Body: 3-Step Wizard -->
    <div class="submit-modal-body">
      <form method="post" action="/requests" enctype="multipart/form-data" class="wizard" id="modal-report-form">
        <ol class="stepper" aria-label="Steps">
          <li data-step-ind="1" class="current"><span class="step-dot"><span class="n">1</span><%- icon('check', 'done-ic') %></span><span class="step-name">Details</span></li>
          <li data-step-ind="2"><span class="step-dot"><span class="n">2</span><%- icon('check', 'done-ic') %></span><span class="step-name">Photo</span></li>
          <li data-step-ind="3"><span class="step-dot"><span class="n">3</span><%- icon('check', 'done-ic') %></span><span class="step-name">Review</span></li>
        </ol>

        <!-- Step 1: Issue Details -->
        <section class="wstep current" data-step="1">
          <h3 style="font-size:13px;font-weight:700;margin:0 0 10px 0;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;">Step 1: Issue Details</h3>
          
          <div class="field" style="margin-bottom:10px;">
            <label for="modal-title" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">What's the problem? <span class="req">*</span></label>
            <input type="text" id="modal-title" name="title" required maxlength="150" placeholder="e.g., Projector won't turn on, Aircon leaking water" style="width:100%;box-sizing:border-box;">
          </div>

          <div class="form-grid" style="gap:12px;margin-bottom:10px;">
            <div class="field" style="margin:0;">
              <label for="modal-equipment-location" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">Room / Location</label>
              <select id="modal-equipment-location" style="width:100%;box-sizing:border-box;">
                <option value="">All rooms / locations</option>
                <% if (typeof C !== 'undefined' && C.HIGH_SCHOOL_ROOMS) { %>
                  <% Object.keys(C.HIGH_SCHOOL_ROOMS).forEach(function (groupName) { %>
                    <optgroup label="<%= groupName %>">
                      <% C.HIGH_SCHOOL_ROOMS[groupName].forEach(function (room) { %>
                        <option value="<%= room %>"><%= room %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                  <% var otherLocs = (locList || []).filter(function (l) { return !C.HIGH_SCHOOL_LOCATIONS.includes(l); }); %>
                  <% if (otherLocs.length > 0) { %>
                    <optgroup label="Other Locations">
                      <% otherLocs.forEach(function (room) { %>
                        <option value="<%= room %>"><%= room %></option>
                      <% }) %>
                    </optgroup>
                  <% } %>
                <% } else { %>
                  <% locList.forEach(function (loc) { %><option value="<%= loc %>"><%= loc %></option><% }) %>
                <% } %>
              </select>
            </div>
            <div class="field" style="margin:0;">
              <label for="modal-equipment-category" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">Category</label>
              <select id="modal-equipment-category" style="width:100%;box-sizing:border-box;">
                <option value="">All categories</option>
                <% catList.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
              </select>
            </div>
          </div>

          <div class="field" style="margin-bottom:10px;">
            <label for="modal-equipmentId" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">Equipment <span class="req">*</span></label>
            <select id="modal-equipmentId" name="equipmentId" required style="width:100%;box-sizing:border-box;">
              <option value="">Select equipment…</option>
              <% eqList.forEach(function (e) { var cat = catList.find(function (c) { return c.id === e.categoryId; }); %>
                <option value="<%= e.id %>" data-category="<%= e.categoryId %>" data-category-name="<%= cat ? cat.name : '' %>" data-name="<%= e.name %>" data-code="<%= e.code %>" data-location="<%= e.location %>">
                  <%= e.name %> (<%= e.code %>)
                </option>
              <% }) %>
            </select>
          </div>

          <% if (currentUser && currentUser.role === 'admin') { %>
          <div class="field" style="margin-bottom:10px;">
            <span class="label" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:5px;">How serious is the problem?</span>
            <div class="sev-grid" role="radiogroup" aria-label="Severity">
              <% Object.keys(sev).forEach(function (k) { var s = sev[k]; var on = Number(k) === 2; %>
                <label class="sev sev-<%= k %> <%= on ? 'checked' : '' %>">
                  <input type="radio" name="severity" value="<%= k %>" <%= on ? 'checked' : '' %> onchange="this.closest('.sev-grid').querySelectorAll('.sev').forEach(function(el){el.classList.remove('checked')}); this.closest('.sev').classList.add('checked')">
                  <span class="sev-tick"><%- icon('check') %></span>
                  <span class="sev-ic"><%- icon(s.icon) %></span>
                  <strong><%= s.label %></strong>
                  <small><%= s.help %></small>
                </label>
              <% }) %>
            </div>
          </div>
          <% } %>

          <div class="field" style="margin-bottom:6px;">
            <label for="modal-description" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">Additional Details <span class="req">*</span></label>
            <textarea id="modal-description" name="description" required maxlength="1000" placeholder="Describe the issue in detail. What happened? When did it start? Any error messages, sounds, or smells?" style="width:100%;box-sizing:border-box;min-height:65px;height:72px;"></textarea>
            <div class="counter"><span data-count-for="modal-description">0</span> / 1000</div>
          </div>
        </section>

        <!-- Step 2: Photo Upload -->
        <section class="wstep" data-step="2">
          <h3 style="font-size:13px;font-weight:700;margin:0 0 4px 0;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;">Step 2: Add Photo</h3>
          <p class="muted" style="font-size:12px;margin-bottom:12px;">Attach clear photos of the issue (optional). Up to 6 photos, 5 MB each.</p>
          <input type="file" id="modal-photos" name="photos" accept="image/jpeg,image/png,image/gif,image/webp" multiple class="photos-input">
          <div class="js-only">
            <label class="dropzone" for="modal-pick-gallery" id="modal-dropzone">
              <span class="dz-ic"><%- icon('camera') %></span>
              <strong>Tap to take a photo</strong>
              <span>or choose from gallery — you can also drop images here</span>
            </label>
            <div class="photo-actions">
              <label class="tile-btn" for="modal-pick-camera"><%- icon('camera') %>Camera</label>
              <label class="tile-btn" for="modal-pick-gallery"><%- icon('image') %>Gallery</label>
              <button type="button" class="tile-btn" id="modal-photos-clear"><%- icon('trash') %>Clear</button>
            </div>
            <input type="file" id="modal-pick-camera" accept="image/*" capture="environment" hidden>
            <input type="file" id="modal-pick-gallery" accept="image/jpeg,image/png,image/gif,image/webp" multiple hidden>
            <p class="photo-msg" id="modal-photo-msg" role="status"></p>
            <div class="previews" id="modal-previews"></div>
          </div>
          <div class="field" style="margin-top:10px;">
            <label for="modal-photoNote" style="display:block;font-weight:600;font-size:12.5px;margin-bottom:4px;">Photo note <span class="hint">(optional)</span></label>
            <input type="text" id="modal-photoNote" name="photoNote" maxlength="1000" placeholder="e.g., Photo taken from the back of the unit" style="width:100%;box-sizing:border-box;">
          </div>
        </section>

        <!-- Step 3: Review Request -->
        <section class="wstep" data-step="3">
          <h3 style="font-size:13px;font-weight:700;margin:0 0 4px 0;color:var(--muted);text-transform:uppercase;letter-spacing:0.5px;">Step 3: Review Request</h3>
          <p class="muted js-only" style="font-size:12px;margin-bottom:12px;">Please review the details before submitting.</p>
          <ul class="review js-only">
            <li><%- icon('tag') %><span><small>Problem</small><strong data-review="title">—</strong></span><button type="button" class="link-btn" data-go="1">Edit</button></li>
            <li><%- icon('monitor') %><span><small>Equipment</small><strong data-review="equipment">—</strong></span></li>
            <li><%- icon('map-pin') %><span><small>Room / Area</small><strong data-review="location">—</strong></span></li>
            <li><%- icon('layers') %><span><small>Category</small><strong data-review="category">—</strong></span></li>
            <% if (currentUser && currentUser.role === 'admin') { %>
            <li><%- icon('alert') %><span><small>Severity</small><strong data-review="severity">—</strong></span></li>
            <% } %>
            <li><%- icon('file') %><span><small>Description</small><strong data-review="description" class="pre">—</strong></span></li>
            <li><%- icon('paperclip') %><span><small>Attached Photos</small><span data-review="photos" class="review-photos">No photo attached</span></span><button type="button" class="link-btn" data-go="2">Edit</button></li>
          </ul>
        </section>

        <!-- Navigation Buttons -->
        <div class="wizard-nav">
          <button type="button" class="btn btn-light" onclick="closeSubmitRequestModal()" data-nav="cancel"><%- icon('x') %>Cancel</button>
          <button type="button" class="btn btn-light js-only" data-nav="back"><%- icon('arrow-left') %>Back</button>
          <button type="button" class="btn js-only" data-nav="next">Next<%- icon('arrow-right') %></button>
          <button type="submit" class="btn btn-primary" data-nav="submit"><%- icon('send') %>Submit Request</button>
        </div>
      </form>
    </div>
  </div>
</div>
      </form>
    </div>
  </div>
</div>
<% } %>
