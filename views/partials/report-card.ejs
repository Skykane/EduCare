<%# One request as a card. Expects: r (enriched request). Optional: showTech, showRequester, showPriority %>
<% var eq = r.equipment; var catName = r.category ? r.category.name : ''; %>
<a class="rcard<%= r.overdue ? ' overdue' : '' %>" href="/requests/<%= r.id %>">
  <span class="rcard-thumb">
    <% if (r.photo) { %>
      <img src="/uploads/<%= r.photo.filename %>" alt="" loading="lazy">
    <% } else { %>
      <span class="rcard-ph"><%- icon(categoryIcon(catName)) %></span>
    <% } %>
  </span>
  <span class="rcard-body">
    <span class="rcard-title"><%= r.title %></span>
    <span class="rcard-sub"><%= eq ? eq.name : 'Equipment removed' %><%= eq && eq.location ? ' – ' + eq.location : '' %></span>
    <span class="rcard-meta">
      <span><%- icon('calendar') %><% var day = fmtDate(r.createdAt); %><%= day %> • <%= fmtDateTime(r.createdAt).slice(day.length).trim() %></span>
      <span class="mono"><%= r.code %></span>
    </span>
    <% if ((typeof showTech !== 'undefined' && showTech) || (typeof showRequester !== 'undefined' && showRequester)) { %>
    <span class="rcard-meta">
      <% if (typeof showRequester !== 'undefined' && showRequester && r.requester) { %><span><%- icon('user') %><%= r.requester.name %></span><% } %>
      <% if (typeof showTech !== 'undefined' && showTech) { %><span><%- icon('wrench') %><%= r.technician ? r.technician.name : 'Not assigned' %></span><% } %>
    </span>
    <% } %>
    <span class="rcard-chips">
      <span class="chip chip-<%= statusColor(r.status) %>"><%- icon(statusIcon(r.status)) %><%= r.status %></span>
      <% if (typeof showPriority !== 'undefined' && showPriority) { %><span class="chip chip-<%= statusColor(r.effectivePriority) %> soft"><%= r.effectivePriority %> priority</span><% } %>
      <% if (r.type === 'Preventive') { %><span class="chip chip-teal soft">Preventive</span><% } %>
      <% if (r.overdue) { %><span class="chip chip-red soft"><%- icon('alert') %>Overdue</span><% } %>
      <% if (currentUser && (currentUser.role === 'admin' || currentUser.id === r.requesterId) && r.status === 'Pending') { %>
        <span class="chip chip-amber soft" title="Can be edited or cancelled"><%- icon('edit') %>Editable</span>
      <% } %>
    </span>
  </span>
  <span class="rcard-go"><%- icon('chevron-right') %></span>
</a>
