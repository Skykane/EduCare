<div class="card">
  <div class="card-head">
    <h2>Preventive Maintenance Alerts</h2>
    <a href="/schedule" class="btn btn-light btn-sm">Schedule</a>
  </div>
  <% if (!pmAlerts.length) { %>
    <p class="muted">No inspections are overdue or due within the next 7 days.</p>
  <% } %>
  <% pmAlerts.forEach(function (s) { %>
    <div style="display:flex;justify-content:space-between;gap:10px;padding:8px 0;border-bottom:1px solid var(--border)">
      <div>
        <a href="/equipment/<%= s.equipment.id %>"><strong><%= s.equipment.name %></strong></a>
        <span class="sub muted" style="display:block;font-size:12px"><%= s.equipment.code %> · due <%= fmtDate(s.nextDue) %></span>
      </div>
      <div class="text-right">
        <span class="<%= statusClass(s.status) %>"><%= s.status %></span>
        <span style="display:block;font-size:12px" class="muted">
          <%= s.daysLeft < 0 ? Math.abs(s.daysLeft) + ' day(s) late' : s.daysLeft === 0 ? 'today' : 'in ' + s.daysLeft + ' day(s)' %>
        </span>
      </div>
    </div>
  <% }) %>
</div>
