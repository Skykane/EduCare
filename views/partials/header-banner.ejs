<%
  var bTitle = typeof title !== 'undefined' ? title : 'Dashboard';
  var bSubtitle = typeof subtitle !== 'undefined' ? subtitle : 'Campus equipment health, maintenance tracking, and work order dispatch.';
%>
<div class="dash-header-banner">
  <!-- Subtle EduCare logo watermark -->
  <div class="dash-banner-watermark" aria-hidden="true">
    <img src="/img/educare-logo.svg" alt="">
  </div>

  <div class="dash-banner-content">
    <div class="dash-banner-text">
      <h1><%= bTitle %></h1>
      <p><%= bSubtitle %></p>
    </div>

    <% if (typeof extraActions !== 'undefined' && extraActions) { %>
      <div class="dash-banner-actions">
        <%- extraActions %>
      </div>
    <% } %>
  </div>
</div>

<% if (typeof sectionTabs !== 'undefined' && sectionTabs && sectionTabs.length) { %>
  <nav class="section-tabs" aria-label="<%= typeof navActive !== 'undefined' && navActive ? navActive.label : 'Section tabs' %>" style="margin-top: 14px; margin-bottom: 20px;">
    <% sectionTabs.forEach(function (t) { %>
      <a href="<%= t.href %>" class="<%= t === tabActive ? 'active' : '' %>"<%- t === tabActive ? ' aria-current="page"' : '' %>>
        <%= t.label %><% if (t.badge && typeof pendingApprovalCount !== 'undefined' && pendingApprovalCount) { %><span class="tab-badge" style="display: inline-flex; align-items: center; justify-content: center; margin-left: 7px; background: #d97706; color: #fff; padding: 2px 7px; border-radius: 99px; font-size: 11px; font-weight: 800; line-height: 1;"><%= pendingApprovalCount %></span><% } %>
      </a>
    <% }) %>
  </nav>
<% } %>
