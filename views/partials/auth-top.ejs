<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · EduCare</title>
  <script>
    (function () {
      try {
        var t = localStorage.getItem('educare-theme');
        if (!t) {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/theme-toggle.css">
  <link rel="stylesheet" href="/css/alignment.css">
  <link rel="stylesheet" href="/css/typography.css">
  <link rel="stylesheet" href="/css/mobile-overrides.css?v=20260522-m1">
  <script src="/js/theme-toggle.js" defer></script>
</head>
<body>
<div class="auth">
  <!-- Decorative background layers only; never interactive. -->
  <div class="auth-bg" aria-hidden="true">
    <div class="auth-bg-glow auth-bg-glow-a"></div>
    <div class="auth-bg-glow auth-bg-glow-b"></div>
    <div class="auth-bg-rings"></div>
    <div class="auth-bg-grid"></div>
    <div class="auth-bg-dots"></div>
    <div class="auth-bg-shape auth-bg-shape-a"></div>
    <div class="auth-bg-shape auth-bg-shape-b"></div>
    <div class="auth-bg-shape auth-bg-shape-c"></div>
    <div class="auth-bg-orb auth-bg-orb-a"></div>
    <div class="auth-bg-orb auth-bg-orb-b"></div>
    <img class="auth-bg-shield" src="/img/educare-logo.svg" alt="">
    <img class="auth-bg-shield auth-bg-shield-sub" src="/img/educare-logo.svg" alt="">
    <div class="auth-bg-vignette"></div>
  </div>

  <main class="auth-side">
    <div class="auth-card">
      <%- include('theme-toggle', { cls: 'auth-theme-switch' }) %>
      <div class="auth-card-header">
        <div class="auth-logo-frame">
          <img class="auth-logo" src="/img/educare-logo.svg" alt="EduCare logo">
        </div>
        <h1 class="auth-brand">Edu<span>Care</span></h1>
      </div>
