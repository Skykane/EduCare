<% if (typeof adminDashboard !== 'undefined' && adminDashboard) { %>
<div class="card dispatch-side-card equipment-summary-card">
  <div class="card-head admin-panel-head">
    <div class="admin-panel-title">
      <%- icon('monitor') %>
      <h2>Equipment Status Summary</h2>
    </div>
    <a href="/equipment" class="btn btn-sm dispatch-head-link">View all</a>
  </div>
  <div class="equipment-status-list" title="Equipment by condition">
    <% var equipmentStatusIcons = { 'Operational': 'check-circle', 'Needs Repair': 'alert', 'Under Maintenance': 'wrench', 'Out of Service': 'x-circle' }; %>
    <% equipmentByStatus.forEach(function (s) { %>
      <a class="equipment-status-row equipment-status-<%= statusColor(s.status) %>" href="/equipment?status=<%= encodeURIComponent(s.status) %>">
        <span class="equipment-status-icon"><%- icon(equipmentStatusIcons[s.status] || 'monitor') %></span>
        <span class="equipment-status-name"><%= s.status %></span>
        <strong class="equipment-status-count"><%= s.count %></strong>
      </a>
    <% }) %>
  </div>
  <p class="equipment-total"><%= totalEquipment %> equipment item(s) in total.</p>
</div>
<% } else { %>
<div class="card">
  <div class="card-head">
    <h2>Equipment Status Summary</h2>
    <a href="/equipment" class="btn btn-light btn-sm">View all</a>
  </div>
  <div class="stack" title="Equipment by condition">
    <% equipmentByStatus.forEach(function (s) { if (s.count) { %>
      <span class="<%= statusColor(s.status) %>" style="width:<%= (s.count / Math.max(totalEquipment, 1) * 100).toFixed(1) %>%" title="<%= s.status %>: <%= s.count %>"></span>
    <% } }) %>
  </div>
  <% equipmentByStatus.forEach(function (s) { %>
    <div class="bar-row">
      <a href="/equipment?status=<%= encodeURIComponent(s.status) %>"><%= s.status %></a>
      <div class="bar"><span class="<%= statusColor(s.status) %>" style="width:<%= (s.count / Math.max(totalEquipment, 1) * 100).toFixed(1) %>%"></span></div>
      <strong class="text-right"><%= s.count %></strong>
    </div>
  <% }) %>
  <p class="muted" style="margin:8px 0 0"><%= totalEquipment %> equipment item(s) in total.</p>
</div>
<% } %>
