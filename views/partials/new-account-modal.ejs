<% if (currentUser && currentUser.role === 'admin') {
     var catList = typeof allCategories === 'function' ? allCategories() : (typeof categories !== 'undefined' ? categories : []);
%>
<!-- Floating Card: New User Account Modal -->
<div id="new-account-modal" class="submit-modal-backdrop" style="display:none;" onclick="closeNewAccountModal(event)">
  <div class="submit-modal-card" style="max-width:740px;max-height:min(92vh,760px);" onclick="event.stopPropagation()">
    <!-- Floating Card Header -->
    <div class="submit-modal-header">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;">
          <span style="display:inline-grid;place-items:center;width:28px;height:28px;border-radius:8px;background:rgba(140,23,36,0.1);color:var(--primary);">
            <%- icon('plus') %>
          </span>
          <h2 style="margin:0;font-size:19px;font-weight:800;color:var(--text);letter-spacing:-0.3px;">New User Account</h2>
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--muted);">Register a new administrator, technician, or student/staff requester.</p>
      </div>
      <button type="button" class="submit-modal-close" onclick="closeNewAccountModal()" aria-label="Close modal" title="Close (Esc)">&times;</button>
    </div>

    <!-- Floating Card Form: Scrollable Body + Pinned Footer -->
    <form method="post" action="/users" id="modal-user-form" class="submit-modal-form">
      <div class="submit-modal-body" style="padding:18px 22px;">
        <div class="form-grid" style="gap:12px 16px;">
          <div class="field">
            <label for="modal-user-name">Full Name *</label>
            <input type="text" id="modal-user-name" name="name" required maxlength="120" placeholder="e.g. Juan Dela Cruz">
          </div>
          <div class="field">
            <label for="modal-user-email">Email Address *</label>
            <input type="email" id="modal-user-email" name="email" required maxlength="200" placeholder="juan.delacruz@educare.local">
          </div>
          <div class="field">
            <label for="modal-user-role">Account Role *</label>
            <select id="modal-user-role" name="role">
              <% Object.keys(C.ROLES).forEach(function (k) { %>
                <option value="<%= k %>" <%= k === 'requester' ? 'selected' : '' %>><%= C.ROLES[k] %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="modal-user-password">Password *</label>
            <div class="input-icon-wrap">
              <input type="password" id="modal-user-password" name="password" minlength="8" required autocomplete="new-password" placeholder="Enter password">
              <button type="button" class="btn-toggle-pw" data-target="modal-user-password" title="Show / hide password" aria-label="Toggle password visibility"><%- icon('eye') %></button>
            </div>
          </div>
          <div class="field">
            <label for="modal-user-department">Department / Office</label>
            <input type="text" id="modal-user-department" name="department" maxlength="150" placeholder="e.g. College of ICT, Facilities">
          </div>
          <div class="field" id="modal-student-id-field">
            <label for="modal-user-studentId">Student ID</label>
            <input type="text" id="modal-user-studentId" name="studentId" placeholder="e.g. 2024-00101" maxlength="50">
          </div>
          <div class="field">
            <label for="modal-user-address">Address</label>
            <input type="text" id="modal-user-address" name="address" placeholder="e.g. 142 San Agustin St., Pasig City" maxlength="250">
          </div>
          <div class="field">
            <label for="modal-user-phone">Phone</label>
            <input type="tel" id="modal-user-phone" name="phone" maxlength="11" pattern="[0-9]{11}" inputmode="numeric" placeholder="09171234567" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)">
          </div>
        </div>

        <!-- Technician-only fields (hidden by default unless role is technician) -->
        <div id="modal-tech-fields" style="display:none;border-top:1px solid var(--border);padding-top:14px;margin-top:14px;">
          <h3 style="font-size:15px;font-weight:700;margin:0 0 10px 0;">Technician Profile</h3>
          <div class="field">
            <label style="margin-bottom:8px;">Specializations</label>
            <div class="checks" style="display:grid;grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));gap:8px;">
              <% catList.forEach(function (c) { %>
                <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;"><input type="checkbox" name="specializations" value="<%= c.id %>"> <%= c.name %></label>
              <% }) %>
            </div>
          </div>
          <div class="field" style="max-width:260px;margin-top:12px;margin-bottom:0;">
            <label for="modal-user-availability">Availability</label>
            <select id="modal-user-availability" name="availability">
              <% C.AVAILABILITY.forEach(function (a) { %><option value="<%= a %>" <%= a === 'Available' ? 'selected' : '' %>><%= a %></option><% }) %>
            </select>
          </div>
        </div>
      </div>

      <!-- Pinned Modal Actions Footer -->
      <div class="submit-modal-footer">
        <button type="button" class="btn btn-light" onclick="closeNewAccountModal()"><%- icon('x') %> Cancel</button>
        <button type="submit" class="btn btn-primary" style="padding:9px 22px;font-weight:700;"><%- icon('check') %> Create Account</button>
      </div>
    </form>
  </div>
</div>
<% } %>
