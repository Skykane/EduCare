<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#7d0c17">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>EduCare</title>
  <script>
    (function () {
      try {
        var t = localStorage.getItem('educare-theme');
        if (!t) {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');

        var sc = localStorage.getItem('educare-sidebar-collapsed');
        if (sc === 'true' && window.innerWidth > 860) {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/style.css?v=20260522-tech1">
  <link rel="stylesheet" href="/css/tables.css">
  <link rel="stylesheet" href="/css/theme-toggle.css">
  <link rel="stylesheet" href="/css/alignment.css">
  <link rel="stylesheet" href="/css/admin-ui.css">
  <link rel="stylesheet" href="/css/search-input.css">
  <link rel="stylesheet" href="/css/categories.css">
  <link rel="stylesheet" href="/css/students.css">
  <link rel="stylesheet" href="/css/locations.css">
  <link rel="stylesheet" href="/css/equipment-management-header.css">
  <link rel="stylesheet" href="/css/profile.css">
  <link rel="stylesheet" href="/css/auto-filter.css">
  <link rel="stylesheet" href="/css/student-dashboard.css?v=20260522-sc2">
  <link rel="stylesheet" href="/css/avatar.css?v=20260522-sf1">
  <link rel="stylesheet" href="/css/shared-dropdown.css?v=20260522-gs1">
  <link rel="stylesheet" href="/css/typography.css?v=20260522-ty2">
  <link rel="stylesheet" href="/css/mobile-overrides.css?v=20260522-m1">
  <link rel="stylesheet" href="/css/repair-workflow.css?v=20261123">
  <script src="/js/theme-toggle.js" defer></script>
</head>
<body class="<%= currentUser ? 'role-' + currentUser.role : '' %><%= typeof pageClass !== 'undefined' && pageClass ? ' ' + pageClass : '' %>">
<% if (currentUser) { %>
<%
  var bottomItems = bottomNavFor(currentUser.role);
  var bottomActive = activeItem(bottomItems.filter(function (i) { return i.href; }), currentPath);
%>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <a class="brand" href="/" title="EduCare - Home">
        <span class="brand-logo"><img src="/img/educare-logo.svg" alt="EduCare logo"></span>
        <span class="brand-text"><strong>Edu<span>Care</span></strong><small>School Equipment Maintenance and Repair Management System</small></span>
      </a>
    </div>
    <nav aria-label="Main menu">
      <% navItems.forEach(function (item) { %>
        <a href="<%= item.href %>" class="<%= item === navActive ? 'active' : '' %>"<%- item === navActive ? ' aria-current="page"' : '' %> data-tooltip="<%= item.label %>" title="<%= item.label %>">
          <%- icon(item.icon) %><span class="label"><%= item.label %></span>
          <% if (item.badge && unreadCount) { %><span class="count"><%= unreadCount %></span><% } %>
        </a>
      <% }) %>
    </nav>
    <div class="who">
      <a class="who-user-link" href="/profile" title="My Profile">
        <span class="who-user">
          <%- include('avatar', { user: currentUser, name: currentUser.name, size: 'sm', className: 'avatar' }) %>
          <span class="who-meta">
            <strong><%= currentUser.name %></strong>
            <small><%= C.ROLES[currentUser.role] %></small>
          </span>
        </span>
      </a>
      <div class="who-divider" aria-hidden="true"></div>
      <form method="post" action="/logout" class="who-logout">
        <button type="submit" class="who-signout-btn" title="Sign Out"><%- icon('logout') %><span>Sign Out</span></button>
      </form>
    </div>
  </aside>
  <nav class="bottom-nav" aria-label="Quick menu">
    <% bottomItems.forEach(function (item) { var on = item === bottomActive; %>
      <% if (item.menu) { %>
        <button type="button" class="bn-item menu-btn hamburger-btn" aria-controls="sidebar" aria-expanded="false"><%- icon(item.icon) %><span><%= item.label %></span></button>
      <% } else if (item.fab) { %>
        <a href="<%= item.href %>" class="bn-fab<%= on ? ' active' : '' %>" aria-label="<%= item.label %>" title="<%= item.label %>"><%- icon(item.icon) %></a>
      <% } else { %>
        <a href="<%= item.href %>" class="bn-item<%= on ? ' active' : '' %>"<%- on ? ' aria-current="page"' : '' %>>
          <span class="bn-ic"><%- icon(item.icon) %><% if (item.badge && unreadCount) { %><span class="dot"><%= unreadCount %></span><% } %></span>
          <span><%= item.label %></span>
        </a>
      <% } %>
    <% }) %>
  </nav>
  <div class="backdrop" id="backdrop"></div>
  <div class="main">
    <header class="topbar">
      <button type="button" class="topbar-hamburger-btn hamburger-btn" id="topbar-hamburger-btn" aria-controls="sidebar" aria-expanded="false" title="Toggle Sidebar Menu" aria-label="Toggle Sidebar Menu">
        <%- icon('menu') %>
      </button>
      <a href="/" class="brand-mini"><span class="brand-logo"><img src="/img/educare-logo.svg" alt=""></span><span>Edu<span>Care</span></span></a>
      <span class="spacer"></span>
      <%- include('theme-toggle') %>
      <a class="bell" href="/notifications" title="Notifications" aria-label="Notifications<%= unreadCount ? ' (' + unreadCount + ' unread)' : '' %>"><%- icon('bell') %><% if (unreadCount) { %><span class="dot"><%= unreadCount %></span><% } %></a>
    </header>
    <main class="content">
      <% if (flash) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.msg %></div>
      <% } %>
<% } else { %>
<div>
  <div>
    <main>
<% } %>
