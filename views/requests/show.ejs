<%- include('../partials/header') %>
<%
  var role = currentUser.role;
  var b = (r.rec && r.rec.breakdown) || {};

  // Canonical statuses; C.STATUS is preferred when the backend exposes it.
  var S = (typeof C !== 'undefined' && C.STATUS) ? {
    pendingApproval: C.STATUS.PENDING_APPROVAL || 'Pending Approval',
    awaitingAssignment: C.STATUS.APPROVED_AWAITING_ASSIGNMENT || 'Approved – Awaiting Assignment',
    assigned: C.STATUS.ASSIGNED || 'Assigned',
    inProgress: C.STATUS.IN_PROGRESS || 'In Progress',
    onHold: C.STATUS.ON_HOLD || 'On Hold',
    completed: C.STATUS.COMPLETED || 'Completed',
    rejected: C.STATUS.REJECTED || 'Rejected'
  } : {
    pendingApproval: 'Pending Approval',
    awaitingAssignment: 'Approved – Awaiting Assignment',
    assigned: 'Assigned',
    inProgress: 'In Progress',
    onHold: 'On Hold',
    completed: 'Completed',
    rejected: 'Rejected'
  };
  var activeTaskStatuses = (typeof C !== 'undefined' && Array.isArray(C.TECH_ACTIVE_STATUSES) && C.TECH_ACTIVE_STATUSES.length)
    ? C.TECH_ACTIVE_STATUSES
    : [S.assigned, S.inProgress, S.onHold];
  var openStatuses = (typeof C !== 'undefined' && Array.isArray(C.OPEN_STATUSES) && C.OPEN_STATUSES.length)
    ? C.OPEN_STATUSES
    : [S.pendingApproval, S.awaitingAssignment, S.assigned, S.inProgress, S.onHold];
  var SEVERITIES = (typeof C !== 'undefined' && C.SEVERITIES) ? C.SEVERITIES : { 1: 'Minor', 2: 'Moderate', 3: 'Major' };
  var PRIORITIES = (typeof C !== 'undefined' && C.PRIORITIES) ? C.PRIORITIES : ['Low', 'Medium', 'High'];
  var EQUIPMENT_STATUSES = (typeof C !== 'undefined' && C.EQUIPMENT_STATUSES) ? C.EQUIPMENT_STATUSES : ['Operational', 'Needs Repair', 'Under Maintenance', 'Out of Service'];
  var ROLE_LABELS = (typeof C !== 'undefined' && C.ROLES) ? C.ROLES : { admin: 'Administrator', technician: 'Maintenance Personnel', requester: 'Requester' };

  var isPendingApproval = r.status === S.pendingApproval;
  var isAwaitingAssignment = r.status === S.awaitingAssignment;
  var isAssigned = r.status === S.assigned;
  var isInProgress = r.status === S.inProgress;
  var isOnHold = r.status === S.onHold;
  var isCompleted = r.status === S.completed;
  var isRejected = r.status === S.rejected;
  // `isRework` is a render local; use a distinct name so it is not shadowed.
  var reworkPending = typeof isRework !== 'undefined' && isRework;

  var canAdminApprove = role === 'admin' && isPendingApproval;
  var canAdminReject = role === 'admin' && (isPendingApproval || isAwaitingAssignment || isAssigned);
  var canAdminAssign = role === 'admin' && (isAwaitingAssignment || isAssigned);
  var canTechnicianWork = (typeof canWork !== 'undefined' && canWork) && role === 'technician' &&
    (activeTaskStatuses.indexOf(r.status) !== -1 || (isCompleted && reworkPending));
  var technicianPool = [];
  if (typeof availableTechnicians !== 'undefined' && Array.isArray(availableTechnicians) && availableTechnicians.length) {
    technicianPool = availableTechnicians;
  } else if (typeof technicians !== 'undefined' && Array.isArray(technicians)) {
    technicianPool = technicians;
  }
  var assignableTechnicians = technicianPool.filter(function (t) { return t && t.availability === 'Available'; });
  var today = typeof todayISO === 'function' ? todayISO() : new Date().toISOString().slice(0, 10);
  function techLoad(t) {
    if (!t) return 0;
    if (typeof t.activeCount === 'number') return t.activeCount;
    if (typeof t.activeTasks === 'number') return t.activeTasks;
    return 0;
  }
%>
<div class="request-detail-page">
  <div class="rd-head card">
    <div class="rd-head-top">
      <div class="rd-head-left">
        <div class="rd-head-idline">
          <span class="rd-request-id mono"><%= r.code %></span>
          <span class="rd-head-sep" aria-hidden="true">·</span>
          <span class="rd-request-equip"><%= r.equipment ? r.equipment.name : (r.category ? r.category.name : r.title) %></span>
          <span class="rd-head-sep" aria-hidden="true">·</span>
          <span class="rd-head-equipid"><% if (r.equipment) { %>Equipment ID: <%= r.equipment.code %><% } else { %><%= [r.location, r.category ? r.category.name : ''].filter(Boolean).join(' · ') || 'General repair' %><% } %></span>
        </div>
        <div class="rd-badges">
          <span class="<%= statusClass(r.status) %>"><%= r.status %></span>
          <% if (r.type === 'Preventive') { %>
            <span class="badge badge-teal"><%- icon('shield') %> Preventive Maintenance Request</span>
          <% } else { %>
            <span class="badge badge-indigo"><%- icon('wrench') %> Corrective Repair Request</span>
          <% } %>
          <span class="<%= statusClass(r.effectivePriority) %>"><%= r.effectivePriority %> Priority (<%= r.priority ? 'Manual' : 'Calculated' %>)</span>
          <% if (r.submittedAt || r.reportedAt) { %><span class="badge badge-gray">Submitted <%= fmtManila(r.submittedAt || r.reportedAt) %></span><% } %>
          <% if (isCompleted && r.verificationStatus && r.verificationStatus !== 'Not Submitted') { %><span class="<%= statusClass(r.verificationStatus) %>"><%= r.verificationStatus %></span><% } %>
          <% if (r.startedAt) { %><span class="badge badge-blue">Started <%= fmtManila(r.startedAt) %></span><% } %>
          <% if (r.completedAt) { %><span class="badge badge-green">Completed <%= fmtManila(r.completedAt) %></span><% } %>
          <% if (r.completedAt && r.startedAt) { %><span class="badge badge-gray">Elapsed: <%= elapsedLabel %></span><% } %>
          <% if (r.overdue) { %><span class="badge badge-red">Overdue</span><% } %>
        </div>
      </div>
      <div class="rd-head-actions">
        <% if (typeof canEdit !== 'undefined' && canEdit) { %>
          <a class="btn btn-light rd-head-btn" href="/requests/<%= r.id %>/edit"><%- icon('edit') %> Edit Report</a>
        <% } %>
        <a class="btn btn-light rd-head-btn" href="/requests">Back to List</a>
      </div>
    </div>
  </div>

  <% if (isRejected) { %>
    <div class="rd-banner rd-banner-danger">
      <span class="rd-banner-icon"><%- icon('x-circle') %></span>
      <div class="rd-banner-body">
        <p class="rd-banner-title">This report was reviewed and rejected by the Administrator.</p>
        <span class="rd-banner-sub">Reason: <%= r.rejectionReason || 'Declined by administrator' %><% if (r.rejectedAt) { %> · <%= fmtDateTime(r.rejectedAt) %><% } %></span>
      </div>
    </div>
  <% } else if (isPendingApproval) { %>
    <div class="rd-banner rd-banner-info">
      <span class="rd-banner-icon"><%- icon('info') %></span>
      <div class="rd-banner-body">
        <p class="rd-banner-title"><%= S.pendingApproval %></p>
        <span class="rd-banner-sub">Submitted <%= fmtDateTime(r.submittedAt || r.reportedAt || r.createdAt) %>. An administrator will review and approve or reject this report.</span>
      </div>
    </div>
  <% } else if (isAwaitingAssignment) { %>
    <div class="rd-banner rd-banner-info">
      <span class="rd-banner-icon"><%- icon('user-check') %></span>
      <div class="rd-banner-body">
        <p class="rd-banner-title"><%= S.awaitingAssignment %></p>
        <span class="rd-banner-sub">Approved<% if (r.approvedAt) { %> <%= fmtDateTime(r.approvedAt) %><% } %>. An administrator will assign an available technician next.</span>
      </div>
    </div>
  <% } else if (isAssigned) { %>
    <div class="rd-banner rd-banner-info">
      <span class="rd-banner-icon"><%- icon('user-check') %></span>
      <div class="rd-banner-body">
        <p class="rd-banner-title">Technician Assigned</p>
        <span class="rd-banner-sub"><%= r.technician ? r.technician.name : 'A technician' %> is assigned<%= r.assignedAt ? ' since ' + fmtDateTime(r.assignedAt) : '' %>. Work has not started yet.</span>
      </div>
    </div>
  <% } else if (isInProgress || isOnHold) { %>
    <div class="rd-banner rd-banner-info">
      <span class="rd-banner-icon"><%- icon('wrench') %></span>
      <div class="rd-banner-body">
        <p class="rd-banner-title"><%= r.status %></p>
        <span class="rd-banner-sub"><%= r.technician ? r.technician.name : 'The assigned technician' %> <% if (isOnHold) { %>has paused work<% } else { %>is working on this repair<% } %><% if (r.startedAt) { %> since <%= fmtDateTime(r.startedAt) %><% } %>.</span>
      </div>
    </div>
  <% } %>

  <div class="rd-grid">
    <div class="rd-col rd-col-left">
      <div class="card rd-card rd-details-card" id="details">
        <div class="rd-details-header">
          <span class="rd-details-header-icon" aria-hidden="true"><%- icon('file-text') %></span>
          <h2>Request Details</h2>
        </div>
        <dl class="rd-dl rd-details-dl">
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('layers') %></span><span>Request Type</span></span></dt>
            <dd>
              <% if (r.type === 'Preventive') { %>
                <span class="badge badge-teal">Preventive Maintenance Request</span>
              <% } else { %>
                <span class="badge rd-badge-type">Corrective Repair Request</span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('check-circle') %></span><span>Approval Status</span></span></dt>
            <dd>
              <span class="<%= statusClass(r.status) %>"><%= r.status %></span>
              <% if (isPendingApproval) { %>
                <span class="rd-subtext">Awaiting administrator review.</span>
              <% } %>
              <% if (r.approvedAt) { %>
                <span class="rd-subtext">Approved <%= fmtDateTime(r.approvedAt) %><% if (r.approvedBy && typeof getUser === 'function' && getUser(r.approvedBy)) { %> by <%= getUser(r.approvedBy).name %><% } %></span>
              <% } %>
              <% if ((isAssigned || isInProgress || isOnHold || isCompleted) && r.technician) { %>
                <span class="rd-subtext">Assigned to <%= r.technician.name %><% if (r.assignedAt) { %> · <%= fmtDateTime(r.assignedAt) %><% } %></span>
              <% } %>
              <% if (isRejected && r.rejectionReason) { %>
                <span class="rd-subtext" style="color:var(--red)"><%= r.rejectionReason %></span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('monitor') %></span><span>Equipment</span></span></dt>
            <dd>
              <% if (r.equipment) { %>
                <a href="/equipment/<%= r.equipment.id %>"><%= r.equipment.code %> – <%= r.equipment.name %></a>
                <span class="badge <%= r.equipment.status === 'Needs Repair' ? 'rd-badge-pending' : statusClass(r.equipment.status) %>"><%= r.equipment.status %></span>
              <% } else { %>
                <span class="rd-na">Not provided</span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('map-pin') %></span><span>Category / Location</span></span></dt>
            <dd>
              <% var catName = r.category ? r.category.name : ''; var locName = r.location; %>
              <% if (catName || locName) { %>
                <%= catName || 'Not provided' %> · <%= locName || 'Not provided' %>
              <% } else { %>
                <span class="rd-na">Not provided</span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('file') %></span><span>Problem</span></span></dt>
            <dd class="rd-pre"><%= r.description ? r.description : '' %><% if (!r.description) { %><span class="rd-na">Not provided</span><% } %></dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('alert') %></span><span>Severity</span></span></dt>
            <dd>
              <% if (r.severity && SEVERITIES[r.severity]) { %>
                <span class="chip sev-chip-<%= r.severity %>"><%= SEVERITIES[r.severity] %></span>
              <% } else { %>
                <span class="badge rd-badge-pending">Pending Admin Assessment</span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('user') %></span><span>Requested By</span></span></dt>
            <dd>
              <% if (r.requester) { %>
                <%= r.requester.name %><% if (r.requester.department) { %> <span class="muted">(<%= r.requester.department %>)</span><% } %>
              <% } else { %>
                <span class="rd-na">Not provided</span>
              <% } %>
            </dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('calendar') %></span><span>Submitted</span></span></dt>
            <dd><%= r.submittedAt || r.reportedAt ? fmtDateTime(r.submittedAt || r.reportedAt) : (r.createdAt ? fmtDateTime(r.createdAt) : '') %><% if (!r.submittedAt && !r.reportedAt && !r.createdAt) { %><span class="rd-na">Not provided</span><% } %></dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('tool') %></span><span>Technician</span></span></dt>
            <dd><% if (r.technician) { %><%= r.technician.name %><% } else { %><span class="rd-na">Not provided</span><% } %></dd>
          </div>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('clock') %></span><span>Target Date</span></span></dt>
            <dd>
              <% if (r.targetDate) { %>
                <%= fmtDate(r.targetDate) %><% if (r.overdue) { %> <span class="badge badge-red">Overdue</span><% } %>
              <% } else { %>
                <span class="rd-na">Not provided</span><% if (r.overdue) { %> <span class="badge badge-red">Overdue</span><% } %>
              <% } %>
            </dd>
          </div>
          <% if (r.startedAt) { %>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('play') %></span><span>Work Started</span></span></dt>
            <dd><%= fmtDateTime(r.startedAt) %></dd>
          </div>
          <% } %>
          <% if (r.completedAt) { %>
          <div class="rd-dl-row">
            <dt><span class="rd-dl-label"><span class="rd-dl-icon"><%- icon('check') %></span><span>Completed</span></span></dt>
            <dd><%= fmtDateTime(r.completedAt) %></dd>
          </div>
          <% } %>
        </dl>
      </div>

      <% if (canTechnicianWork && !reworkPending) { %>
      <div class="card rd-card" id="progress">
        <div class="rd-card-head"><h2>Update Progress</h2></div>
        <form method="post" action="/requests/<%= r.id %>/status" enctype="multipart/form-data" class="rd-inline-form">
          <div class="field rd-field-grow">
            <label for="progress-note">Remarks <span class="hint">(required to start)</span></label>
            <input type="text" id="progress-note" name="note" maxlength="1000" placeholder="e.g. Started inspection, replacement part needed">
          </div>
          <div class="field rd-field-grow">
            <label for="start-proof">Picture proof <span class="hint">(optional)</span></label>
            <input type="file" id="start-proof" name="photos" accept="image/jpeg,image/png,image/gif,image/webp">
          </div>
          <div class="rd-inline-actions">
            <% if (isAssigned) { %><button class="btn" name="action" value="start" type="submit">▶ Start Repair</button><% } %>
            <% if (isInProgress) { %><button class="btn btn-light" name="action" value="hold" type="submit">⏸ Put On Hold</button><% } %>
            <% if (isOnHold) { %><button class="btn" name="action" value="resume" type="submit">▶ Resume Work</button><% } %>
          </div>
        </form>
      </div>
      <% } %>

      <% if (canTechnicianWork && reworkPending) { %>
        <div class="rd-banner rd-banner-danger">
          <span class="rd-banner-icon"><%- icon('alert') %></span>
          <div class="rd-banner-body">
            <p class="rd-banner-title">Returned for Rework</p>
            <span class="rd-banner-sub"><%= r.reworkReason || 'Administrator requested additional work.' %><% if (r.reworkAt) { %> · <%= fmtManila(r.reworkAt) %><% } %></span>
          </div>
        </div>
        <div class="card rd-card">
          <div class="rd-card-head"><h2>Resume Rework</h2></div>
          <form method="post" action="/requests/<%= r.id %>/rework/start" enctype="multipart/form-data">
            <div class="field"><label for="rework-remarks">Rework remarks *</label><input type="text" id="rework-remarks" name="remarks" required maxlength="1000"></div>
            <div class="field"><label for="rework-proof">Updated picture proof *</label><input type="file" id="rework-proof" name="photos" accept="image/jpeg,image/png,image/gif,image/webp" required></div>
            <button class="btn btn-danger" type="submit"><%- icon('refresh') %> Start New Rework Attempt</button>
          </form>
        </div>
      <% } %>

      <%- include('partials/materials-panel') %>

      <% if (canTechnicianWork && (isInProgress || isOnHold)) { %>
      <div class="card rd-card card-floating" id="complete">
        <div class="rd-card-head"><h2>Complete Repair</h2></div>
        <p class="muted rd-card-sub">Work performed and final remarks are required. Completion photos are optional. Materials: <%= formatMoney(materialTotals.subtotalCents) %>. Elapsed so far: <%= elapsedLabel %>. This saves a record to the equipment's maintenance history.</p>
        <form method="post" action="/requests/<%= r.id %>/complete" enctype="multipart/form-data">
          <div class="form-grid">
            <div class="field full">
              <label for="problem">Problem identified *</label>
              <input type="text" id="problem" name="problem" required maxlength="1000" value="<%= r.type === 'Preventive' ? 'Scheduled preventive maintenance' : '' %>">
            </div>
            <div class="field full">
              <label for="actionsTaken">Work performed / actions taken *</label>
              <textarea id="actionsTaken" name="actionsTaken" required maxlength="2000"></textarea>
            </div>
            <div class="field">
              <label for="partsReplaced">Parts replaced</label>
              <input type="text" id="partsReplaced" name="partsReplaced" maxlength="1000" placeholder="e.g. 1x HDMI port, 2x fuse">
            </div>
            <div class="field">
              <label for="serviceDate">Completion / service date *</label>
              <input type="date" id="serviceDate" name="serviceDate" value="<%= today %>" max="<%= today %>" required>
            </div>
            <div class="field">
              <label for="resultingStatus">Equipment condition after repair</label>
              <select data-ec-select="1" id="resultingStatus" name="resultingStatus">
                <% EQUIPMENT_STATUSES.forEach(function (s) { %><option <%= s === 'Operational' ? 'selected' : '' %>><%= s %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="remarks">Final completion remarks *</label>
              <input type="text" id="remarks" name="remarks" maxlength="1000" required>
            </div>
            <div class="field">
              <label for="after-photos">Completion photos <span class="hint">(optional)</span></label>
              <input type="file" id="after-photos" name="photos" accept="image/jpeg,image/png,image/gif,image/webp">
            </div>
            </div>
            <div class="field">
              <label for="photoNote">Photo note</label>
              <input type="text" id="photoNote" name="photoNote" maxlength="1000">
            </div>
          </div>
          <button class="btn btn-success" type="submit">✔ Mark as Completed</button>
        </form>
      </div>
      <% } %>

      <% if (record) { var rt = getUser(record.technicianId); %>
      <div class="card rd-card">
        <div class="rd-card-head"><h2>Maintenance Record</h2></div>
        <dl class="rd-dl">
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Service date</span></span></dt><dd><%= fmtDate(record.serviceDate) %></dd></div>
          <% if (r.completedAt) { %>
            <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Completed</span></span></dt><dd><%= fmtDateTime(r.completedAt) %></dd></div>
          <% } %>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Technician</span></span></dt><dd><%= rt ? rt.name : '—' %></dd></div>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Problem identified</span></span></dt><dd><%= record.problem %></dd></div>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Actions performed</span></span></dt><dd class="rd-pre"><%= record.actionsTaken %></dd></div>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Parts replaced</span></span></dt><dd><%= record.partsReplaced || '—' %></dd></div>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Condition after</span></span></dt><dd><span class="<%= statusClass(record.resultingStatus) %>"><%= record.resultingStatus %></span></dd></div>
          <% if (record.remarks) { %><div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Completion notes</span></span></dt><dd class="rd-pre"><%= record.remarks %></dd></div><% } %>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Completion photos</span></span></dt><dd><a href="#docs"><%= typeof after !== 'undefined' && Array.isArray(after) ? after.length : 0 %> photo(s) in Repair Documentation</a></dd></div>
        </dl>
      </div>
      <% } %>

      <div class="card rd-card" id="docs">
        <div class="rd-card-head"><h2>Repair Documentation</h2></div>
        <p class="muted rd-card-sub">Before-repair photos are captured when the request is submitted or while it is open. After-repair photos become available only once the repair is completed.</p>
        <%
          var canDeleteSavedPhoto = function (a, stage) {
            if (role === 'admin') return true;
            if (stage === 'before' && currentUser && String(r.requesterId) === String(currentUser.id) && openStatuses.indexOf(r.status) !== -1) return true;
            return false;
          };
        %>
        <div class="rd-doc-grid">
          <section class="rd-doc-section">
            <div class="rd-doc-section-head">
              <h3>Before Repair Photos</h3>
              <span class="rd-doc-count" data-rd-count="before"><%= before.length %></span>
            </div>
            <% if (!before.length) { %>
              <p class="rd-doc-empty" data-rd-empty="before">No before-repair photos yet.</p>
            <% } else { %>
              <div class="photos rd-photos" data-rd-gallery="before">
                <% before.forEach(function (a) { var au = getUser(a.userId); %>
                  <figure data-attachment-id="<%= a.id %>">
                    <a href="/uploads/<%= a.filename %>" target="_blank" rel="noopener"><img src="/uploads/<%= a.filename %>" alt="<%= a.originalName %>" loading="lazy"></a>
                    <% if (canDeleteSavedPhoto(a, 'before')) { %>
                      <button type="button" class="rd-photo-remove rd-saved-photo-remove" data-attachment-id="<%= a.id %>" data-stage="before" aria-label="Remove photo <%= a.originalName %>">&times;</button>
                    <% } %>
                    <figcaption><%= a.note || a.originalName %><br><%= au ? au.name : '' %> · <%= fmtDate(a.createdAt) %></figcaption>
                  </figure>
                <% }) %>
              </div>
              <p class="rd-doc-empty" data-rd-empty="before" style="display:none;">No before-repair photos yet.</p>
            <% } %>
          </section>
          <section class="rd-doc-section">
            <div class="rd-doc-section-head">
              <h3>After Repair Photos</h3>
              <span class="rd-doc-count" data-rd-count="after"><%= after.length %></span>
            </div>
            <% if (!after.length) { %>
              <p class="rd-doc-empty" data-rd-empty="after">After-repair photos appear here once the repair is completed.</p>
            <% } else { %>
              <div class="photos rd-photos" data-rd-gallery="after">
                <% after.forEach(function (a) { var au = getUser(a.userId); %>
                  <figure data-attachment-id="<%= a.id %>">
                    <a href="/uploads/<%= a.filename %>" target="_blank" rel="noopener"><img src="/uploads/<%= a.filename %>" alt="<%= a.originalName %>" loading="lazy"></a>
                    <% if (canDeleteSavedPhoto(a, 'after')) { %>
                      <button type="button" class="rd-photo-remove rd-saved-photo-remove" data-attachment-id="<%= a.id %>" data-stage="after" aria-label="Remove photo <%= a.originalName %>">&times;</button>
                    <% } %>
                    <figcaption><%= a.note || a.originalName %><br><%= au ? au.name : '' %> · <%= fmtDate(a.createdAt) %></figcaption>
                  </figure>
                <% }) %>
              </div>
              <p class="rd-doc-empty" data-rd-empty="after" style="display:none;">After-repair photos appear here once the repair is completed.</p>
            <% } %>
          </section>
        </div>
        <% var canAddBefore = openStatuses.indexOf(r.status) !== -1; %>
        <% var canAddAfter = isCompleted && canTechnicianWork; %>
        <% var showUploadForm = canAddAfter || (canAddBefore && !(role === 'admin' && (isPendingApproval || isAwaitingAssignment))); %>
        <% if (showUploadForm) { %>
        <form method="post" action="/requests/<%= r.id %>/attachments" enctype="multipart/form-data" class="rd-upload-form" id="rdUploadForm" data-request-id="<%= r.id %>" novalidate>
          <div class="rd-upload-top">
            <div class="field rd-upload-type">
              <label for="doc-stage">Photo Type</label>
              <select data-ec-select="1" id="doc-stage" name="stage" required>
                <% if (canAddBefore) { %><option value="before">Before Repair</option><% } %>
                <% if (canAddAfter) { %><option value="after">After Repair</option><% } %>
              </select>
              <% if (!canAddAfter) { %><small class="muted rd-upload-hint">After Repair photos are available when the repair status is Completed.</small><% } %>
            </div>
            <div class="field rd-upload-note">
              <label for="doc-note">Note <span class="muted">(optional)</span></label>
              <input type="text" id="doc-note" name="note" maxlength="1000" placeholder="Add an optional note about these photos">
            </div>
          </div>

          <div class="field rd-upload-photos">
            <label for="doc-photos-input">Photos</label>
            <div class="rd-photo-picker">
              <input type="file" id="doc-photos-input" name="photos" class="rd-photo-input" accept="image/jpeg,image/png,image/gif,image/webp" multiple required aria-describedby="doc-photos-help">
              <label for="doc-photos-input" class="btn btn-light rd-photo-choose" id="rdPhotoChooseBtn"><%- icon('camera') %> Choose Photos</label>
              <span class="rd-photo-picker-meta" id="doc-photos-help">JPG, PNG, GIF, or WEBP · up to 6 photos · 5 MB each</span>
            </div>
            <div class="rd-photo-previews" id="rdPhotoPreviews" aria-live="polite"></div>
          </div>

          <div class="rd-upload-status" id="rdUploadStatus" aria-live="polite"></div>

          <div class="rd-upload-actions">
            <% if (role === 'admin' && isPendingApproval) { %>
              <a class="btn btn-primary" href="#approve"><%- icon('check') %> Approve Request</a>
            <% } else if (role === 'admin' && isAwaitingAssignment) { %>
              <a class="btn btn-primary" href="#assign"><%- icon('user-check') %> Assign Technician</a>
            <% } else { %>
              <button class="btn btn-primary rd-upload-submit" type="submit" id="rdUploadSubmitBtn"><%- icon('upload') %> Upload Photos</button>
            <% } %>
          </div>
        </form>
        <script>
        (function () {
          var form = document.getElementById('rdUploadForm');
          if (!form) return;
          var input = document.getElementById('doc-photos-input');
          var chooseBtn = document.getElementById('rdPhotoChooseBtn');
          var previews = document.getElementById('rdPhotoPreviews');
          var statusBox = document.getElementById('rdUploadStatus');
          var submitBtn = document.getElementById('rdUploadSubmitBtn');
          var stageSelect = document.getElementById('doc-stage');
          var noteInput = document.getElementById('doc-note');
          var maxFiles = 6;
          var maxBytes = 5 * 1024 * 1024;
          var allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
          var selected = [];

          function setStatus(type, msg) {
            statusBox.className = 'rd-upload-status' + (type ? ' is-' + type : '');
            statusBox.textContent = msg || '';
          }

          function syncInput() {
            var dt = new DataTransfer();
            selected.forEach(function (item) { dt.items.add(item.file); });
            input.files = dt.files;
          }

          function renderPreviews() {
            previews.innerHTML = '';
            if (!selected.length) {
              previews.classList.remove('has-files');
              return;
            }
            previews.classList.add('has-files');
            selected.forEach(function (item, idx) {
              var card = document.createElement('div');
              card.className = 'rd-photo-preview';
              var img = document.createElement('img');
              img.src = item.url;
              img.alt = item.file.name;
              img.loading = 'lazy';
              var meta = document.createElement('div');
              meta.className = 'rd-photo-preview-meta';
              var name = document.createElement('span');
              name.className = 'rd-photo-preview-name';
              name.textContent = item.file.name;
              name.title = item.file.name;
              var size = document.createElement('span');
              size.className = 'rd-photo-preview-size';
              size.textContent = (item.file.size / 1024 / 1024).toFixed(2) + ' MB';
              meta.appendChild(name);
              meta.appendChild(size);
              var remove = document.createElement('button');
              remove.type = 'button';
              remove.className = 'rd-photo-remove';
              remove.setAttribute('aria-label', 'Remove ' + item.file.name);
              remove.innerHTML = '&times;';
              remove.addEventListener('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                URL.revokeObjectURL(item.url);
                selected.splice(idx, 1);
                syncInput();
                renderPreviews();
                setStatus('', '');
              });
              card.appendChild(img);
              card.appendChild(meta);
              card.appendChild(remove);
              previews.appendChild(card);
            });
          }

          function addFiles(fileList) {
            var errs = [];
            Array.prototype.forEach.call(fileList || [], function (file) {
              if (allowed.indexOf(file.type) === -1) { errs.push(file.name + ': only JPG, PNG, GIF, or WEBP images are allowed.'); return; }
              if (file.size > maxBytes) { errs.push(file.name + ': must be 5 MB or smaller.'); return; }
              if (selected.length >= maxFiles) { errs.push('You can upload up to ' + maxFiles + ' photos at a time.'); return; }
              var exists = selected.some(function (it) { return it.file.name === file.name && it.file.size === file.size && it.file.lastModified === file.lastModified; });
              if (exists) return;
              selected.push({ file: file, url: URL.createObjectURL(file) });
            });
            syncInput();
            renderPreviews();
            if (errs.length) setStatus('error', errs[0]);
            else setStatus('', '');
          }

          input.addEventListener('change', function () { addFiles(input.files); input.value = ''; syncInput(); });

          form.addEventListener('submit', function (e) {
            e.preventDefault();
            setStatus('', '');
            if (!selected.length) { setStatus('error', 'Please choose at least one photo.'); return; }
            if (stageSelect.value === 'after' && !<%= canAddAfter ? 'true' : 'false' %>) { setStatus('error', 'After Repair photos are available only when the repair status is Completed.'); return; }
            if (stageSelect.value === 'before' && !<%= canAddBefore ? 'true' : 'false' %>) { setStatus('error', 'Before Repair photos can only be added while the request is open.'); return; }

            var fd = new FormData();
            fd.append('stage', stageSelect.value);
            fd.append('note', noteInput.value || '');
            selected.forEach(function (item) { fd.append('photos', item.file); });

            var xhr = new XMLHttpRequest();
            xhr.open('POST', form.action);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.setRequestHeader('Accept', 'application/json');
            if (submitBtn) { submitBtn.disabled = true; submitBtn.classList.add('is-loading'); }
            setStatus('progress', 'Uploading 0%...');

            xhr.upload.onprogress = function (ev) {
              if (ev.lengthComputable) {
                var pct = Math.max(0, Math.min(100, Math.round((ev.loaded / ev.total) * 100)));
                setStatus('progress', 'Uploading ' + pct + '%...');
              }
            };
            xhr.onload = function () {
              if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('is-loading'); }
              var data = {};
              try { data = JSON.parse(xhr.responseText || '{}'); } catch (_) {}
              if (xhr.status >= 200 && xhr.status < 300 && data.ok) {
                setStatus('success', data.message || 'Photos uploaded successfully.');
                selected.forEach(function (item) { URL.revokeObjectURL(item.url); });
                selected = [];
                syncInput();
                renderPreviews();
                noteInput.value = '';
                setTimeout(function () { window.location.reload(); }, 900);
              } else {
                setStatus('error', data.error || 'Upload failed. Please try again.');
              }
            };
            xhr.onerror = function () {
              if (submitBtn) { submitBtn.disabled = false; submitBtn.classList.remove('is-loading'); }
              setStatus('error', 'Network error while uploading. Please check your connection and try again.');
            };
            xhr.send(fd);
          });
        })();
        </script>
        <% } %>
        <script>
        (function () {
          var buttons = document.querySelectorAll('.rd-saved-photo-remove[data-attachment-id]');
          if (!buttons.length) return;
          buttons.forEach(function (btn) {
            btn.addEventListener('click', async function (e) {
              e.preventDefault();
              e.stopPropagation();
              var attId = btn.getAttribute('data-attachment-id');
              var stage = btn.getAttribute('data-stage') || 'before';
              if (!attId) return;

              var confirmed = false;
              if (window.ecConfirmPhotoRemove) confirmed = await window.ecConfirmPhotoRemove();
              else if (window.ecConfirm) confirmed = await window.ecConfirm({ title: 'Remove Photo?', message: 'Are you sure you want to remove this photo? This action cannot be undone.', confirmLabel: 'Remove Photo', cancelLabel: 'Cancel', tone: 'danger', icon: 'trash' });
              else confirmed = window.confirm('Remove this photo permanently? This action cannot be undone.');
              if (!confirmed) return;

              btn.disabled = true;
              try {
                var res = await fetch('/requests/<%= r.id %>/attachments/' + encodeURIComponent(attId) + '/delete', {
                  method: 'POST',
                  headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });
                var data = await res.json().catch(function () { return {}; });
                if (!res.ok || !data.ok) {
                  btn.disabled = false;
                  if (window.ecAlert) await window.ecAlert(data.error || 'Could not remove photo.', { title: 'Could Not Remove Photo', tone: 'danger', icon: 'warning' });
                  else window.alert(data.error || 'Could not remove photo.');
                  return;
                }
                var figure = btn.closest('figure');
                var gallery = btn.closest('[data-rd-gallery]');
                if (figure) figure.remove();
                if (gallery) {
                  var remaining = gallery.querySelectorAll('figure').length;
                  var countEl = document.querySelector('[data-rd-count="' + stage + '"]');
                  if (countEl) countEl.textContent = String(remaining);
                  if (remaining === 0) {
                    gallery.style.display = 'none';
                    var empty = gallery.parentElement.querySelector('.rd-doc-empty[data-rd-empty="' + stage + '"]');
                    if (empty) empty.style.display = '';
                  }
                } else {
                  var countEl2 = document.querySelector('[data-rd-count="' + stage + '"]');
                  if (countEl2) countEl2.textContent = String(Math.max(0, parseInt(countEl2.textContent || '1', 10) - 1));
                }
              } catch (err) {
                btn.disabled = false;
                if (window.ecAlert) await window.ecAlert('Network error while removing photo.', { title: 'Connection Error', tone: 'danger', icon: 'warning' });
                else window.alert('Network error while removing photo.');
              }
            });
          });
        })();
        </script>
      </div>
    </div>

    <div class="rd-col rd-col-right">
      <% if (canAdminApprove) { %>
      <div class="card rd-card" id="approve">
        <div class="rd-card-head rd-card-head-between">
          <h2><%- icon('check-circle') %> Administrator Approval</h2>
          <span class="badge badge-amber">Action Required</span>
        </div>
        <p class="muted rd-card-sub">Review and triage this <strong><%= r.type === 'Preventive' ? 'Preventive Maintenance Request' : 'Corrective Repair Request' %></strong> filed by <strong><%= r.requester ? r.requester.name : 'Requester' %></strong>. Approving moves it to <strong><%= S.awaitingAssignment %></strong>; technician assignment is a separate step.</p>
        <p class="muted rd-card-sub">Calculated priority: <span class="<%= statusClass(r.rec.level) %>"><%= r.rec.level %> (<%= r.rec.score %>/100)</span> · from item/category importance, severity and waiting time.</p>
        <form method="post" action="/requests/<%= r.id %>/approve" data-confirm-title="Approve Request?" data-confirm="Are you sure you want to approve request <%= r.code %>? Its status will change and the requester will be notified." data-confirm-ok="Confirm Approval" data-confirm-cancel="Cancel" data-confirm-tone="success" data-confirm-icon="check">
          <div class="rd-admin-block">
            <div class="rd-admin-block-title">Triage &amp; Priority</div>
            <div class="field">
              <label for="appr-sev">Severity Assessment *</label>
              <select data-ec-select="1" id="appr-sev" name="severity" required>
                <% Object.keys(SEVERITIES).forEach(function (k) { %>
                  <option value="<%= k %>" <%= Number(r.severity || 2) === Number(k) ? 'selected' : '' %>><%= SEVERITIES[k] %></option>
                <% }) %>
              </select>
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="appr-prio">Priority</label>
              <select data-ec-select="1" id="appr-prio" name="priority">
                <option value="auto" <%= !r.priority ? 'selected' : '' %>>Automatic calculation (<%= r.rec.level %>)</option>
                <% PRIORITIES.forEach(function (p) { %><option <%= r.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="rd-admin-actions">
            <button class="btn btn-primary" type="submit"><%- icon('check') %> Approve Request</button>
          </div>
        </form>
      </div>
      <% } %>

      <div class="card rd-card" id="priority-card">
        <div class="rd-card-head"><h2>Priority</h2></div>
        <div class="rd-priority-top">
          <div class="rd-priority-score">
            <span class="rd-priority-num"><%= r.rec.score %></span>
            <span class="rd-priority-denom">/100</span>
          </div>
          <div class="rd-priority-meta">
            <div class="rd-priority-meta-row"><span class="rd-priority-meta-label">Recommended</span> <span class="<%= statusClass(r.rec.level) %>"><%= r.rec.level %></span></div>
            <div class="rd-priority-meta-row"><span class="rd-priority-meta-label">Current</span> <span class="<%= statusClass(r.effectivePriority) %>"><%= r.effectivePriority %></span> <span class="muted">(<%= r.priority ? 'set manually' : 'automatic' %>)</span></div>
          </div>
        </div>
        <div class="rd-breakdown">
          <% [['Importance', b.importance, 'indigo'], ['Severity', b.severity, 'amber'], ['Waiting time', b.waiting, 'blue']].forEach(function (x) { %>
            <div class="rd-bar-row">
              <div class="rd-bar-label">
                <span><%= x[0] %></span>
                <span class="rd-bar-sub"><%= x[1].label %></span>
              </div>
              <div class="rd-bar-track"><span class="rd-bar-fill <%= x[2] %>" style="width:<%= (x[1].points / x[1].max * 100).toFixed(0) %>%"></span></div>
              <div class="rd-bar-points"><%= x[1].points %>/<%= x[1].max %></div>
            </div>
          <% }) %>
        </div>
        <div class="rd-priority-note">
          Calculated automatically from item/category importance (40 pts), reported severity (40 pts) and waiting time (20 pts over 14 days). 70+ = High, 40–69 = Medium, below 40 = Low.
        </div>
        <% if (role === 'admin' && openStatuses.indexOf(r.status) !== -1 && !isPendingApproval) { %>
          <form method="post" action="/requests/<%= r.id %>/priority" class="rd-priority-form">
            <div class="field">
              <label for="severity">Set Severity</label>
              <select data-ec-select="1" id="severity" name="severity">
                <option value="" <%= !r.severity ? 'selected' : '' %>>-- Select Severity --</option>
                <% Object.keys(SEVERITIES).forEach(function (k) { %>
                  <option value="<%= k %>" <%= Number(r.severity) === Number(k) ? 'selected' : '' %>><%= SEVERITIES[k] %></option>
                <% }) %>
              </select>
            </div>
            <div class="field">
              <label for="priority">Set Priority</label>
              <select data-ec-select="1" id="priority" name="priority">
                <option value="auto" <%= !r.priority ? 'selected' : '' %>>Automatic (<%= r.rec.level %>)</option>
                <% PRIORITIES.forEach(function (p) { %><option <%= r.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </div>
            <button class="btn btn-light" type="submit">Update</button>
          </form>
        <% } %>
      </div>

      <% if (canAdminAssign) { %>
      <div class="card rd-card" id="assign">
        <div class="rd-card-head"><h2><%= isAssigned ? 'Reassign Technician' : 'Assign Technician' %></h2></div>
        <p class="muted rd-card-sub">Choose an available technician. The number beside each name is their current active workload.</p>
        <% if (!assignableTechnicians.length) { %>
          <p class="muted">No available technicians right now. <a href="/technicians">Manage the maintenance team</a>.</p>
        <% } else { %>
        <form method="post" action="/requests/<%= r.id %>/assign">
          <div class="field">
            <label for="technicianId">Technician *</label>
            <select data-ec-select="1" id="technicianId" name="technicianId" required>
              <option value="">Choose available technician…</option>
              <% assignableTechnicians.forEach(function (t) { %>
                <% if (isAssigned && r.technicianId && String(t.id) === String(r.technicianId)) { return; } %>
                <% var load = techLoad(t); %>
                <% var highLoad = typeof highWorkloadAt === 'number' && load >= highWorkloadAt; %>
                <option value="<%= t.id %>"><%= t.name %> · <%= load %> active<%= load === 1 ? '' : 's' %><% if (t.specNames && t.specNames.length) { %> · <%= t.specNames.join(', ') %><% } %><% if (highLoad) { %> · high workload<% } %></option>
              <% }) %>
            </select>
          </div>
          <div class="field">
            <label for="targetDate">Target completion date <span class="hint">(optional)</span></label>
            <input type="date" id="targetDate" name="targetDate" min="<%= today %>" value="<%= r.targetDate && r.targetDate >= today ? r.targetDate : '' %>">
          </div>
          <div class="field">
            <label for="assign-note">Instructions <span class="hint">(optional)</span></label>
            <input type="text" id="assign-note" name="note" maxlength="500">
          </div>
          <% if (isAssigned) { %>
          <div class="field">
            <label for="reassign-reason">Reason for reassignment *</label>
            <input type="text" id="reassign-reason" name="reassignReason" maxlength="500" required>
          </div>
          <% } %>
          <button class="btn btn-primary" type="submit"><%- icon('user-check') %> <%= isAssigned ? 'Reassign Technician' : 'Assign Technician' %></button>
        </form>
        <% } %>
      </div>
      <% } %>

      <% if (canAdminReject) { %>
      <div class="card rd-card" id="reject">
        <div class="rd-card-head"><h2>Reject Request</h2></div>
        <p class="muted rd-card-sub">Decline this request with a reason. The requester will be notified and this report will move to <strong><%= S.rejected %></strong>.</p>
        <button class="btn btn-danger btn-sm" type="button" onclick="openRejectModal()"><%- icon('x') %> Reject Request</button>
      </div>
      <% } %>

      <% if (isCompleted) { %>
      <div class="card rd-card" id="verification">
        <div class="rd-card-head"><h2>Repair Verification</h2></div>
        <dl class="rd-dl">
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Verification status</span></span></dt><dd><span class="<%= statusClass(r.verificationStatus || 'Not Submitted') %>"><%= r.verificationStatus || 'Not Submitted' %></span></dd></div>
          <% if (r.verifiedAt) { %><div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Verified at</span></span></dt><dd><%= fmtManila(r.verifiedAt) %> by <%= getUser(r.verifiedBy) ? getUser(r.verifiedBy).name : '—' %></dd></div><% } %>
          <% if (r.reworkReason) { %><div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Rework reason</span></span></dt><dd><%= r.reworkReason %></dd></div><% } %>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Elapsed repair time</span></span></dt><dd><%= elapsedLabel %></dd></div>
          <div class="rd-dl-row"><dt><span class="rd-dl-label"><span>Materials total</span></span></dt><dd><%= formatMoney(materialTotals.subtotalCents) %></dd></div>
        </dl>
        <a class="btn btn-sm btn-light" href="#timeline"><%- icon('history') %> View Timeline</a>

        <% if (role === 'admin' && typeof canVerify !== 'undefined' && canVerify) { %>
          <form method="post" action="/requests/<%= r.id %>/verify" data-confirm="Verify that this repair is complete?" class="verify-form">
            <input type="hidden" name="confirm" value="yes">
            <div class="field"><label for="verify-remarks">Verification remarks</label><input type="text" id="verify-remarks" name="remarks" maxlength="1000"></div>
            <button class="btn btn-success" type="submit"><%- icon('check-circle') %> Verify Completion</button>
          </form>
          <form method="post" action="/requests/<%= r.id %>/rework" class="verify-form" data-confirm="Return this repair for rework?" data-confirm-tone="warning">
            <div class="field"><label for="rework-reason">Reason for rework *</label><textarea id="rework-reason" name="reason" maxlength="1000" required></textarea></div>
            <button class="btn btn-danger" type="submit"><%- icon('alert') %> Return for Rework</button>
          </form>
        <% } %>
      </div>
      <% } %>

      <div class="card rd-card" id="timeline">
        <div class="rd-card-head"><h2>Activity History</h2></div>
        <p class="muted rd-card-sub">Complete repair timeline: reports, attempts, materials, proof, and verification decisions.</p>
        <ul class="rd-timeline">
          <% timeline.forEach(function (t) { %>
            <li class="rd-timeline-item">
              <span class="rd-timeline-dot" aria-hidden="true"></span>
              <div class="rd-timeline-content">
                <div class="rd-timeline-what"><%= t.title %><% if (t.previousStatus && t.newStatus) { %> <span class="muted">(<%= t.previousStatus %> → <%= t.newStatus %>)</span><% } %></div>
                <% if (t.details) { %><div class="rd-timeline-details"><%= t.details %></div><% } %>
                <div class="rd-timeline-meta"><span><%= fmtManila(t.at) %> · <%= t.kind %></span></div>
              </div>
            </li>
          <% }); %>
        </ul>
        <ul class="rd-timeline">
          <% activities.forEach(function (a) { var u = getUser(a.userId); %>
            <li class="rd-timeline-item">
              <span class="rd-timeline-dot" aria-hidden="true"></span>
              <div class="rd-timeline-content">
                <div class="rd-timeline-what"><%= a.action %><% if (a.fromStatus && a.toStatus) { %> <span class="muted">(<%= a.fromStatus %> → <%= a.toStatus %>)</span><% } %></div>
                <% if (a.details) { %><div class="rd-timeline-details"><%= a.details %></div><% } %>
                <div class="rd-timeline-meta">
                  <% if (u) { %><%- include('../partials/avatar', { user: u, name: u.name, size: 'xs' }) %><% } %>
                  <span><%= u ? u.name : 'System' %><% if (u) { %> (<%= ROLE_LABELS[u.role] || u.role %>)<% } %> · <%= fmtDateTime(a.createdAt) %></span>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>
        <form method="post" action="/requests/<%= r.id %>/notes" class="rd-note-form">
          <div class="field rd-field-grow">
            <label for="note">Add a note</label>
            <input type="text" id="note" name="note" maxlength="2000" required placeholder="Write a note...">
          </div>
          <button class="btn btn-light" type="submit">Add Note</button>
        </form>
      </div>
    </div>
  </div>

<% if (canAdminReject) { %>
<!-- Admin Reject Modal Dialog -->
<div id="reject-modal" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;align-items:center;justify-content:center;padding:16px;">
  <div class="modal-card card" style="max-width:500px;width:100%;margin:0;box-shadow:0 12px 36px rgba(0,0,0,0.3);">
    <div class="modal-head" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <h2 style="margin:0;color:var(--red);display:flex;align-items:center;gap:8px;font-size:16px;">
        <%- icon('alert') %> Reject Repair Request
      </h2>
      <button type="button" class="btn-link" onclick="closeRejectModal()" style="font-size:18px;cursor:pointer;">✕</button>
    </div>
    <p style="font-size:13.5px;line-height:1.4;margin:0 0 14px;">
      Decline repair request <strong><%= r.code %></strong>. The requester will be notified with your reason, and the equipment status will revert to Operational.
    </p>
    <form method="post" action="/requests/<%= r.id %>/reject">
      <div class="field">
        <label>Reason for rejection *</label>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:6px;font-size:13px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason_preset" value="Not school equipment / personal device not covered by maintenance" checked onchange="handleRejectPreset(this)">
            <span>Not school equipment (personal device)</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason_preset" value="Issue resolved / false alarm / user error" onchange="handleRejectPreset(this)">
            <span>Issue resolved / false alarm / user error</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason_preset" value="Duplicate report (already filed in another ticket)" onchange="handleRejectPreset(this)">
            <span>Duplicate report (already filed in another ticket)</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason_preset" value="Out of maintenance scope / requires replacement purchase" onchange="handleRejectPreset(this)">
            <span>Out of maintenance scope / requires replacement purchase</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason_preset" value="other" onchange="handleRejectPreset(this)">
            <span>Other (type custom explanation below)</span>
          </label>
        </div>
      </div>
      <div class="field" style="margin-top:10px;">
        <label for="reject-reason-text">Detailed explanation (sent to requester):</label>
        <textarea id="reject-reason-text" name="reason" rows="2" minlength="5" maxlength="1000" required style="width:100%;font-size:13px;">Not school equipment / personal device not covered by maintenance</textarea>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
        <button type="button" class="btn btn-light" onclick="closeRejectModal()">Keep Request</button>
        <button type="submit" class="btn btn-danger">Confirm Rejection</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRejectModal() {
    var modal = document.getElementById('reject-modal');
    if (modal) modal.style.display = 'flex';
  }
  function closeRejectModal() {
    var modal = document.getElementById('reject-modal');
    if (modal) modal.style.display = 'none';
  }
  function handleRejectPreset(radio) {
    var txt = document.getElementById('reject-reason-text');
    if (!txt) return;
    if (radio.value === 'other') {
      txt.value = '';
      txt.placeholder = 'Type custom reason here...';
      txt.focus();
    } else {
      txt.value = radio.value;
    }
  }
</script>
<% } %>
</div>

<%- include('../partials/footer') %>
