<%- include('../partials/header') %>
<% var sev = {
     1: { label: 'Minor', help: 'Still usable', icon: 'check-circle' },
     2: { label: 'Moderate', help: 'Needs attention', icon: 'alert-circle' },
     3: { label: 'Major', help: 'Cannot be used', icon: 'alert' },
     4: { label: 'Critical', help: 'Safety risk', icon: 'octagon' },
   }; %>
<div class="wizard-wrap">
<div class="page-head">
  <div>
    <h1>Submit Request</h1>
    <p>Tell us where the problem is and what is wrong. The maintenance team will be notified.</p>
  </div>
</div>

<%- include('../partials/errors', { errors: errors }) %>

<form method="post" action="/requests" enctype="multipart/form-data" class="card wizard card-floating" id="report-form">
  <ol class="stepper" aria-label="Steps">
    <li data-step-ind="1" class="current"><span class="step-dot"><span class="n">1</span><%- icon('check', 'done-ic') %></span><span class="step-name">Details</span></li>
    <li data-step-ind="2"><span class="step-dot"><span class="n">2</span><%- icon('check', 'done-ic') %></span><span class="step-name">Photo</span></li>
    <li data-step-ind="3"><span class="step-dot"><span class="n">3</span><%- icon('check', 'done-ic') %></span><span class="step-name">Review</span></li>
  </ol>

  <!-- Step 1: details -->
  <section class="wstep current" data-step="1">
    <h2>Issue Details</h2>
    <div class="field">
      <label for="title">What's the problem? <span class="req">*</span></label>
      <input type="text" id="title" name="title" value="<%= values.title || '' %>" required maxlength="150" placeholder="e.g., Projector won't turn on, Aircon leaking water">
    </div>
    <div class="form-grid" style="gap:12px;margin-bottom:12px;">
      <div class="field" style="margin:0;">
        <label for="equipment-location">Room / Location <span class="req">*</span></label>
        <select id="equipment-location" name="location" data-ec-select="1" required>
          <option value="">Select room / location</option>
          <% if (typeof C !== 'undefined' && C.CAMPUS_ROOMS) { %>
            <% Object.keys(C.CAMPUS_ROOMS).forEach(function (groupName) { %>
              <optgroup label="<%= groupName %>">
                <% C.CAMPUS_ROOMS[groupName].forEach(function (room) { %>
                  <option value="<%= room %>" <%= values.location === room ? 'selected' : '' %>><%= room %></option>
                <% }) %>
              </optgroup>
            <% }) %>

          <% } else { %>
            <% (typeof locations !== 'undefined' ? locations : []).forEach(function (loc) { %><option value="<%= loc %>" <%= values.location === loc ? 'selected' : '' %>><%= loc %></option><% }) %>
          <% } %>
        </select>
      </div>
      <div class="field" style="margin:0;">
        <label for="equipment-category">Category <span class="req">*</span></label>
        <select id="equipment-category" name="categoryId" data-ec-select="1" required>
          <option value="">Select category</option>
          <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= Number(values.categoryId) === Number(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
    </div>
    <% if (currentUser && currentUser.role === 'admin') { %>
    <div class="field">
      <span class="label">How serious is the problem?</span>
      <div class="sev-grid" role="radiogroup" aria-label="Severity">
        <% Object.keys(sev).forEach(function (k) { var s = sev[k]; var on = Number(values.severity) === Number(k); %>
          <label class="sev sev-<%= k %> <%= on ? 'checked' : '' %>">
            <input type="radio" name="severity" value="<%= k %>" <%= on ? 'checked' : '' %> onchange="document.querySelectorAll('.sev').forEach(function(el){el.classList.remove('checked')}); this.closest('.sev').classList.add('checked')">
            <span class="sev-tick"><%- icon('check') %></span>
            <span class="sev-ic"><%- icon(s.icon) %></span>
            <strong><%= s.label %></strong>
            <small><%= s.help %></small>
          </label>
        <% }) %>
      </div>
    </div>
    <% } %>
    <div class="field">
      <label for="description">Additional Details</label>
      <textarea id="description" name="description" maxlength="1000" placeholder="Describe the issue in detail. What happened? When did it start? Any error messages, sounds, or smells?"><%= values.description || '' %></textarea>
      <div class="counter"><span data-count-for="description">0</span> / 1000</div>
    </div>
  </section>

  <!-- Step 2: photo -->
  <section class="wstep" data-step="2">
    <div class="photo-step-heading"><div><h2>Step 2: Add Photo</h2><p>Attach a clear photo of the issue (optional). Up to 1 photo, 5 MB.</p></div></div>
    <input type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/gif,image/webp" class="photos-input">
    <div class="js-only">
      <div class="photo-dropzone dropzone" role="button" tabindex="0" aria-label="Take a photo or choose one from gallery">
        <%- icon('camera') %><strong>Tap to take a photo</strong>
        <span>or <button type="button" class="photo-gallery-trigger">choose from gallery</button> — you can also<br> drop images here</span>
      </div>
      <input type="file" id="pick-camera" accept="image/*" capture="environment" hidden>
      <input type="file" id="pick-gallery" accept="image/jpeg,image/png,image/gif,image/webp" hidden>
    </div>
    <div class="field photo-note-field">
      <label for="photoNote">Photo note <span class="hint">(optional)</span></label>
      <input type="text" id="photoNote" name="photoNote" value="<%= values.photoNote || '' %>" maxlength="1000" placeholder="e.g., Photo taken from the back of the unit">
    </div>
    <p class="photo-msg" id="photo-msg" role="status"></p>
    <div class="js-only"><div class="previews" id="previews"></div></div>
  </section>

  <!-- Step 3: review -->
  <section class="wstep" data-step="3">
    <h2>Review Request</h2>
    <p class="muted js-only">Please review the details before submitting.</p>
    <ul class="review js-only">
      <li><%- icon('tag') %><span><small>Problem</small><strong data-review="title">—</strong></span><button type="button" class="link-btn" data-go="1">Edit</button></li>
      <li><%- icon('map-pin') %><span><small>Room / Area</small><strong data-review="location">—</strong></span></li>
      <li><%- icon('layers') %><span><small>Category</small><strong data-review="category">—</strong></span></li>
      <% if (currentUser && currentUser.role === 'admin') { %>
      <li><%- icon('alert') %><span><small>Severity</small><strong data-review="severity">—</strong></span></li>
      <% } %>
      <li><%- icon('file') %><span><small>Description</small><strong data-review="description" class="pre">—</strong></span></li>
      <li><%- icon('paperclip') %><span><small>Attached Photos</small><span data-review="photos" class="review-photos">No photo attached</span></span><button type="button" class="link-btn" data-go="2">Edit</button></li>
    </ul>
  </section>

  <div class="wizard-nav">
    <a class="btn btn-light" href="/requests" data-nav="cancel"><%- icon('arrow-left') %>Cancel</a>
    <button type="button" class="btn btn-light js-only" data-nav="back"><%- icon('arrow-left') %>Back</button>
    <button type="button" class="btn js-only" data-nav="next">Next<%- icon('arrow-right') %></button>
    <button type="submit" class="btn" data-nav="submit"><%- icon('send') %>Submit Request</button>
  </div>
</form>
</div>
<%- include('../partials/footer') %>
