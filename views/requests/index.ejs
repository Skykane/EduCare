<%- include('../partials/header') %>
<% var role = currentUser.role; var advanced = role !== 'requester';
   // Exact canonical statuses; fall back if constants are not exposed to views.
   var S = (typeof C !== 'undefined' && C.STATUS) ? {
     pendingApproval: C.STATUS.PENDING_APPROVAL || 'Pending Approval',
     awaitingAssignment: C.STATUS.APPROVED_AWAITING_ASSIGNMENT || 'Approved – Awaiting Assignment',
     assigned: C.STATUS.ASSIGNED || 'Assigned',
     inProgress: C.STATUS.IN_PROGRESS || 'In Progress',
     onHold: C.STATUS.ON_HOLD || 'On Hold',
     completed: C.STATUS.COMPLETED || 'Completed',
     rejected: C.STATUS.REJECTED || 'Rejected'
   } : {
     pendingApproval: 'Pending Approval',
     awaitingAssignment: 'Approved – Awaiting Assignment',
     assigned: 'Assigned',
     inProgress: 'In Progress',
     onHold: 'On Hold',
     completed: 'Completed',
     rejected: 'Rejected'
   };
   var allStatuses = [
     S.pendingApproval, S.awaitingAssignment, S.assigned,
     S.inProgress, S.onHold, S.completed, S.rejected
   ];
   var pills = [{ label: 'All', status: '' }].concat(allStatuses.map(function (s) {
     return { label: s, status: s };
   }));
   var priorityOptions = (typeof C !== 'undefined' && Array.isArray(C.PRIORITIES) && C.PRIORITIES.length)
     ? C.PRIORITIES : ['Low', 'Medium', 'High'];
   var moreActive = ['priority', 'categoryId', 'location', 'technicianId', 'type', 'from', 'to', 'overdue'].some(function (k) { return f[k]; })
     || (f.status && !pills.some(function (p) { return p.status === f.status; })); %>
<%
  var reqExtraActions = '';
  if (role !== 'technician') {
    reqExtraActions += `<a class="btn-banner-sub" href="/requests/new" onclick="if(window.openSubmitRequestModal){openSubmitRequestModal();return false;}">${icon('plus')} Submit Request</a>`;
  }
  if (role === 'admin') {
    reqExtraActions += `<a class="btn-banner-sub" href="/reports/export/requests${qs({ from: f.from, to: f.to })}">${icon('upload')} Export CSV</a>`;
  }
  var activeFilters = [];
  function pushFilter(key, label, value) { if (value) activeFilters.push({ key: key, label: label, value: value }); }
  var statusLabelMap = { open: 'All open', active: 'Assigned / In progress / On hold' };
  if (f.status) pushFilter('status', 'Status', statusLabelMap[f.status] || f.status);
  if (f.priority) pushFilter('priority', 'Priority', f.priority);
  if (f.categoryId) { var _cf = (categories || []).find(function(c){ return c.id === f.categoryId; }); pushFilter('categoryId', 'Category', _cf ? _cf.name : f.categoryId); }
  if (f.location) pushFilter('location', 'Location', f.location);
  if (f.technicianId) { var _tf = (technicians || []).find(function(t){ return t.id === f.technicianId; }); pushFilter('technicianId', 'Technician', _tf ? _tf.name : f.technicianId); }
  if (f.type) pushFilter('type', 'Type', f.type);
  if (f.from) pushFilter('from', 'From', f.from);
  if (f.to) pushFilter('to', 'To', f.to);
  if (f.overdue) pushFilter('overdue', 'Overdue', 'Only');
  if (f.sort && f.sort !== 'priority') { var sortLabels = { newest: 'Newest', oldest: 'Oldest', target: 'Target date' }; pushFilter('sort', 'Sort', sortLabels[f.sort] || f.sort); }
  var activeFilterCount = activeFilters.length;
%>
<div class="admin-ui-page admin-ui-requests">
  <%- include('../partials/header-banner', {
    breadcrumb: '<a href="/">Home</a> &rsaquo; Maintenance Requests',
    title: 'Maintenance Requests',
    subtitle: 'Track incoming problem reports, technician dispatches, and equipment service status.',
    extraActions: reqExtraActions
  }) %>

  <nav class="admin-ui-pills" aria-label="Filter by status">
    <% pills.forEach(function (p) { var on = (f.status || '') === p.status; %>
      <a href="/requests<%= qs(f, { status: p.status, q: f.q }) %>" class="<%= on ? 'active' : '' %>"<%- on ? ' aria-current="true"' : '' %> data-auto-filter-link data-auto-results="#requests-results" data-filter-key="status" data-filter-value="<%= p.status %>"><%= p.label %></a>
    <% }) %>
  </nav>

  <form class="admin-ui-filter-card" method="get" action="/requests" data-auto-filter data-auto-results="#requests-results">
    <div class="admin-ui-filter-grid">
      <div class="admin-ui-field wide">
        <label for="request-search">Search</label>
        <span class="search-input">
          <span class="search-input-icon"><%- icon('search') %></span>
          <input type="search" id="request-search" name="q" value="<%= f.q %>" placeholder="Request ID, location, category, or description…" aria-label="Search requests">
        </span>
      </div>
      <div class="admin-ui-actions">
        <a class="btn btn-light" href="/requests" data-filter-clear>Clear</a>
        <% if (!advanced && f.status) { %><input type="hidden" name="status" value="<%= f.status %>"><% } %>
      </div>
      <% if (advanced) { %>
      <details class="admin-ui-more-filters"<%= moreActive ? ' open' : '' %>>
        <summary class="btn btn-light admin-ui-mf-summary"><%- icon('layers') %> More filters <span class="admin-ui-mf-count<%= activeFilterCount ? '' : ' is-zero' %>" data-filter-sync="mf-count" aria-label="<%= activeFilterCount %> active filters"><%= activeFilterCount %></span></summary>
        <div class="admin-ui-mf-backdrop" data-mf-close aria-hidden="true"></div>
        <div class="filters card admin-ui-more-filters-panel" role="dialog" aria-modal="true" aria-label="Filter Requests">
          <div class="admin-ui-mf-modal-head">
            <div>
              <h3 class="admin-ui-mf-modal-title">Filter Requests</h3>
              <p class="admin-ui-mf-modal-sub">Refine the task list with compact filters.</p>
            </div>
            <button type="button" class="admin-ui-mf-close" data-mf-close aria-label="Close filters"><%- icon('x') %></button>
          </div>
          <div class="admin-ui-mf-modal-body">
          <div class="admin-ui-mf-grid">
            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status" data-ec-select="1">
                <option value="">All</option>
                <option value="open" <%= f.status === 'open' ? 'selected' : '' %>>All open</option>
                <option value="active" <%= f.status === 'active' ? 'selected' : '' %>>Assigned / In progress / On hold</option>
                <% (typeof C !== 'undefined' && Array.isArray(C.REQUEST_STATUSES) ? C.REQUEST_STATUSES : allStatuses).forEach(function (s) { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="priority">Priority</label>
              <select id="priority" name="priority" data-ec-select="1">
                <option value="">All</option>
                <% priorityOptions.forEach(function (p) { %><option <%= f.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="categoryId">Category</label>
              <select id="categoryId" name="categoryId" data-ec-select="1">
                <option value="">All</option>
                <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= f.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="location">Location</label>
              <select id="location" name="location" data-ec-select="1">
                <option value="">All</option>
                <% if (typeof C !== 'undefined' && C.CAMPUS_ROOMS) { %>
                  <% Object.keys(C.CAMPUS_ROOMS).forEach(function (groupName) { %>
                    <optgroup label="<%= groupName %>">
                      <% C.CAMPUS_ROOMS[groupName].forEach(function (room) { %>
                        <option value="<%= room %>" <%= f.location === room ? 'selected' : '' %>><%= room %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                  <% var _selLoc = f.location || ''; %>
                  <% if (_selLoc && !C.CAMPUS_LOCATIONS.includes(_selLoc)) { %>
                    <option value="<%= _selLoc %>" selected><%= _selLoc %> (Current)</option>
                  <% } %>
                <% } else { %>
                  <% locations.forEach(function (l) { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
                <% } %>
              </select>
            </div>
            <% if (role === 'admin') { %>
            <div class="field admin-ui-mf-full" data-mf="technician">
              <label for="technicianId">Technician</label>
              <select id="technicianId" name="technicianId" data-ec-select="1">
                <option value="">All</option>
                <% technicians.forEach(function (t) { %><option value="<%= t.id %>" <%= f.technicianId === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
              </select>
            </div>
            <% } %>
            <div class="field" data-mf="type">
              <label for="type">Type</label>
              <select id="type" name="type" data-ec-select="1">
                <option value="">All</option>
                <% C.REQUEST_TYPES.forEach(function (t) { %><option <%= f.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
              </select>
            </div>
            <div class="field" data-mf="sort">
              <label for="sort">Sort By</label>
              <select id="sort" name="sort" data-ec-select="1">
                <option value="priority" <%= f.sort === 'priority' ? 'selected' : '' %>>Priority</option>
                <option value="newest" <%= f.sort === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="oldest" <%= f.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                <option value="target" <%= f.sort === 'target' ? 'selected' : '' %>>Target date</option>
              </select>
            </div>
          </div>

          <div class="admin-ui-mf-date-range">
            <span class="admin-ui-mf-group-label">Date Range</span>
            <div class="admin-ui-mf-date-grid">
              <div class="field">
                <label for="from">Submitted from</label>
                <input type="date" id="from" name="from" value="<%= f.from %>">
              </div>
              <div class="field">
                <label for="to">To</label>
                <input type="date" id="to" name="to" value="<%= f.to %>">
              </div>
            </div>
          </div>

          <div class="field admin-ui-check-field admin-ui-mf-overdue">
            <label class="admin-ui-check"><input type="checkbox" name="overdue" value="1" <%= f.overdue ? 'checked' : '' %>> Overdue only</label>
          </div>

          </div>
          <div class="actions admin-ui-filter-actions admin-ui-mf-actions">
            <a class="btn btn-light" href="/requests" data-filter-clear data-mf-close><span class="mf-btn-label-desktop">Clear</span><span class="mf-btn-label-mobile">Reset</span></a>
            <button type="button" class="btn btn-primary" data-filter-apply data-mf-close><span class="mf-btn-label-desktop">Apply</span><span class="mf-btn-label-mobile">Apply Filters</span></button>
          </div>
        </div>
      </details>
      <% } %>
    </div>
  </form>

  <div id="requests-results" data-auto-results>
    <% if (activeFilters.length) { %>
      <div class="admin-ui-mf-chips" aria-label="Active filters">
        <div class="admin-ui-mf-chips-list">
          <% activeFilters.forEach(function (af) { %>
            <span class="admin-ui-mf-chip">
              <span class="admin-ui-mf-chip-label"><%= af.label %>: <strong><%= af.value %></strong></span>
              <a href="/requests<%= qs(f, (function(){ var o={}; o[af.key]=''; return o; })()) %>" class="admin-ui-mf-chip-remove" data-auto-filter-link data-auto-results="#requests-results" data-filter-key="<%= af.key %>" data-filter-value="" aria-label="Remove <%= af.label %> filter">&times;</a>
            </span>
          <% }) %>
        </div>
        <a href="/requests" class="admin-ui-mf-chips-clear" data-filter-clear>Clear All</a>
      </div>
    <% } %>
    <% if (!rows.length) { %>
      <div class="admin-ui-card admin-ui-empty">
        <%- icon('search') %>
        <strong>No requests found</strong>
        <small><%= f.q || f.status || moreActive ? 'Try a different search or filter.' : 'Requests you submit will appear here.' %></small>
      </div>
    <% } else { %>
      <div class="admin-ui-card-head">
        <div>
          <h2>Requests (<%= rows.length %>)</h2>
          <p class="admin-ui-muted"><%= role === 'admin' ? 'Review reports, approve pending requests, and assign approved work to available technicians.' : 'Open a request to review details, update its status, or continue the workflow.' %></p>
        </div>
      </div>
      <% if (role === 'admin') { %>
        <div class="admin-ui-table-box rq-table-wrap">
          <table class="admin-ui-table rq-table">
            <thead>
              <tr>
                <th>Request ID</th>
                <th>Report Details</th>
                <th>Location</th>
                <th>Priority</th>
                <th>Date Submitted</th>
                <th class="au-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function (r) { %>
                <% var eq = r.equipment; var catName = r.category ? r.category.name : ''; %>
                <tr>
                  <td>
                    <div class="cell">
                      <strong class="mono"><%= r.code %></strong>
                      <span class="sub"><span class="chip chip-<%= statusColor(r.status) %>"><%- icon(statusIcon(r.status)) %><%= r.status %></span></span>
                    </div>
                  </td>
                  <td>
                    <div class="cell rq-report-cell">
                      <strong><%= r.title %></strong>
                      <span class="sub"><%= eq ? (eq.code + ' · ' + eq.name) : (catName || 'General repair') %><%= r.requester ? ' · ' + r.requester.name : '' %></span>
                      <span class="sub rq-desc"><%= (r.description || 'No description provided.').length > 110 ? (r.description || '').slice(0, 110) + '…' : (r.description || 'No description provided.') %></span>
                    </div>
                  </td>
                  <td><div class="cell"><span><%= r.location || '—' %></span><% if (catName) { %><span class="sub"><%= catName %></span><% } %></div></td>
                  <td>
                    <div class="cell">
                      <span class="chip chip-<%= statusColor(r.effectivePriority) %> soft"><%= r.effectivePriority %></span>
                      <% if (r.overdue) { %><span class="sub is-red">Overdue</span><% } %>
                    </div>
                  </td>
                  <td>
                    <div class="cell">
                      <span><%= fmtDate(r.createdAt) %></span>
                      <span class="sub"><%= fmtDateTime(r.createdAt).slice(fmtDate(r.createdAt).length).trim() %></span>
                    </div>
                  </td>
                  <td class="au-center">
                    <div class="rq-actions">
                      <a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">View</a>
                      <% if (r.status === S.pendingApproval) { %>
                        <button type="button" class="btn btn-primary btn-sm rq-approve-btn"
                          data-id="<%= r.id %>"
                          data-code="<%= r.code %>"
                          data-title="<%- (r.title || '').replace(/"/g, '&quot;') %>"
                          data-severity="<%= r.severity || 2 %>"
                          data-priority="<%= r.priority || '' %>">Approve</button>
                      <% } else if (r.status === S.awaitingAssignment) { %>
                        <button type="button" class="btn btn-primary btn-sm rq-assign-btn"
                          data-id="<%= r.id %>"
                          data-code="<%= r.code %>"
                          data-title="<%- (r.title || '').replace(/"/g, '&quot;') %>">Assign</button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="admin-ui-request-grid">
          <% rows.forEach(function (r) { %>
            <%- include('../partials/report-card', { r: r, showTech: role !== 'technician', showRequester: role !== 'requester', showPriority: role !== 'requester', adminUi: true }) %>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
<% if (role === 'admin') { %>
<style>
  .rq-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .rq-table { min-width: 980px; }
  .rq-report-cell .rq-desc { color: var(--muted); font-size: 12px; line-height: 1.4; max-width: 420px; }
  .rq-actions { display: inline-flex; gap: 8px; align-items: center; justify-content: center; flex-wrap: wrap; }
  .rq-actions .btn-sm { padding: 7px 12px; font-size: 12px; line-height: 1; border-radius: 8px; white-space: nowrap; }
  .rq-modal .submit-modal-card { max-width: 640px; }
  .rq-modal .rq-modal-body { padding: 18px 20px 20px; }
  .rq-modal .rq-modal-meta { font-size: 13px; color: var(--muted); margin: 0 0 14px; }
  .rq-modal .rq-modal-meta strong { color: var(--text); }
  .rq-modal .field { margin-bottom: 12px; }
  .rq-modal .field label { display:block; font-weight:600; font-size:12.5px; margin-bottom:4px; }
  .rq-modal .field input[type="text"],
  .rq-modal .field input[type="date"],
  .rq-modal .field select,
  .rq-modal .field textarea { width:100%; box-sizing:border-box; }
  .rq-modal .rq-modal-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:16px; flex-wrap:wrap; }
  .rq-modal .rq-reject-box { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
  .rq-modal .rq-reject-box h4 { margin: 0 0 8px; font-size: 13px; color: #b42318; }
  .rq-modal .rq-reject-box .muted { font-size: 12px; color: var(--muted); margin: 0 0 10px; }
  @media (max-width: 720px) {
    .rq-table { min-width: 860px; }
    .rq-modal .submit-modal-card { max-width: calc(100vw - 20px); }
    .rq-modal .rq-modal-actions .btn { flex: 1 1 auto; }
  }
</style>

<div id="rq-approve-modal" class="submit-modal-backdrop rq-modal" style="display:none;" onclick="rqCloseModal(event, 'rq-approve-modal')">
  <div class="submit-modal-card" onclick="event.stopPropagation()">
    <div class="submit-modal-header">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;">
          <span style="display:inline-grid;place-items:center;width:26px;height:26px;border-radius:8px;background:rgba(140,23,36,0.1);color:var(--primary);"><%- icon('check') %></span>
          <h2 style="margin:0;font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.3px;">Review Request</h2>
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--muted);">Approve or reject a pending repair request.</p>
      </div>
      <button type="button" class="submit-modal-close" onclick="rqHideModal('rq-approve-modal')" aria-label="Close modal">&times;</button>
    </div>
    <div class="rq-modal-body">
      <p class="rq-modal-meta"><strong id="rq-approve-code"></strong> <span id="rq-approve-title"></span></p>
      <form id="rq-approve-form" method="post">
        <div class="field">
          <label for="rq-approve-severity">Severity Assessment *</label>
          <select id="rq-approve-severity" name="severity" required>
            <% Object.keys(C.SEVERITIES).forEach(function (k) { %>
              <option value="<%= k %>"><%= C.SEVERITIES[k] %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="rq-approve-priority">Priority</label>
          <select id="rq-approve-priority" name="priority">
            <option value="auto">Automatic calculation</option>
            <% (C.PRIORITIES || []).forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label for="rq-approve-note">Approval note <span class="muted">(optional)</span></label>
          <textarea id="rq-approve-note" name="note" rows="2" maxlength="500" placeholder="Optional note for the requester/technician"></textarea>
        </div>
        <div class="rq-modal-actions">
          <button type="button" class="btn btn-light" onclick="rqHideModal('rq-approve-modal')">Cancel</button>
          <button type="submit" class="btn btn-primary"><%- icon('check') %> Approve Request</button>
        </div>
      </form>
      <div class="rq-reject-box">
        <h4>Reject Request</h4>
        <p class="muted">If this request should not proceed, provide a reason. Rejection is final for this request.</p>
        <form id="rq-reject-form" method="post">
          <div class="field">
            <label for="rq-reject-reason">Rejection reason *</label>
            <textarea id="rq-reject-reason" name="reason" rows="2" maxlength="1000" required placeholder="Explain why the request is being rejected"></textarea>
          </div>
          <div class="rq-modal-actions">
            <button type="submit" class="btn btn-light" style="color:#b42318;border-color:#f1c7c7;background:#fff7f7;">Reject Request</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<div id="rq-assign-modal" class="submit-modal-backdrop rq-modal" style="display:none;" onclick="rqCloseModal(event, 'rq-assign-modal')">
  <div class="submit-modal-card" onclick="event.stopPropagation()">
    <div class="submit-modal-header">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px;">
          <span style="display:inline-grid;place-items:center;width:26px;height:26px;border-radius:8px;background:rgba(140,23,36,0.1);color:var(--primary);"><%- icon('user-check') %></span>
          <h2 style="margin:0;font-size:18px;font-weight:800;color:var(--text);letter-spacing:-0.3px;">Assign Technician</h2>
        </div>
        <p style="margin:0;font-size:12.5px;color:var(--muted);">Assign an approved request to an available technician.</p>
      </div>
      <button type="button" class="submit-modal-close" onclick="rqHideModal('rq-assign-modal')" aria-label="Close modal">&times;</button>
    </div>
    <div class="rq-modal-body">
      <p class="rq-modal-meta"><strong id="rq-assign-code"></strong> <span id="rq-assign-title"></span></p>
      <% if (!availableTechnicians || !availableTechnicians.length) { %>
        <p class="muted">No available technicians right now. <a href="/technicians">Manage the maintenance team</a>.</p>
        <div class="rq-modal-actions"><button type="button" class="btn btn-light" onclick="rqHideModal('rq-assign-modal')">Close</button></div>
      <% } else { %>
      <form id="rq-assign-form" method="post">
        <div class="field">
          <label for="rq-assign-tech">Available technician *</label>
          <select id="rq-assign-tech" name="technicianId" required>
            <option value="">Choose available technician…</option>
            <% availableTechnicians.forEach(function (t) { %>
              <% var highLoad = typeof highWorkloadAt === 'number' && t.activeCount >= highWorkloadAt; %>
              <option value="<%= t.id %>"><%= t.name %> · <%= t.activeCount %> active<%= t.activeCount === 1 ? '' : 's' %><% if (t.specNames && t.specNames.length) { %> · <%= t.specNames.join(', ') %><% } %><% if (highLoad) { %> · high workload<% } %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="rq-assign-target">Target completion date <span class="muted">(optional)</span></label>
          <input type="date" id="rq-assign-target" name="targetDate" min="<%= today %>">
        </div>
        <div class="field">
          <label for="rq-assign-note">Instructions <span class="muted">(optional)</span></label>
          <textarea id="rq-assign-note" name="note" rows="2" maxlength="500" placeholder="Optional instructions for the technician"></textarea>
        </div>
        <div class="rq-modal-actions">
          <button type="button" class="btn btn-light" onclick="rqHideModal('rq-assign-modal')">Cancel</button>
          <button type="submit" class="btn btn-primary"><%- icon('user-check') %> Assign Technician</button>
        </div>
      </form>
      <% } %>
    </div>
  </div>
</div>
<script>
  function rqHideModal(id) { var m = document.getElementById(id); if (m) m.style.display = 'none'; }
  function rqCloseModal(e, id) { if (e.target && e.target.id === id) rqHideModal(id); }
  document.addEventListener('click', function (e) {
    var approveBtn = e.target.closest('.rq-approve-btn');
    if (approveBtn) {
      var id = approveBtn.getAttribute('data-id');
      document.getElementById('rq-approve-code').textContent = approveBtn.getAttribute('data-code') || '';
      document.getElementById('rq-approve-title').textContent = '— ' + (approveBtn.getAttribute('data-title') || '');
      document.getElementById('rq-approve-form').action = '/requests/' + id + '/approve';
      document.getElementById('rq-reject-form').action = '/requests/' + id + '/reject';
      document.getElementById('rq-approve-severity').value = approveBtn.getAttribute('data-severity') || '2';
      document.getElementById('rq-approve-priority').value = approveBtn.getAttribute('data-priority') || 'auto';
      document.getElementById('rq-approve-note').value = '';
      document.getElementById('rq-reject-reason').value = '';
      document.getElementById('rq-approve-modal').style.display = 'flex';
      return;
    }
    var assignBtn = e.target.closest('.rq-assign-btn');
    if (assignBtn) {
      var aid = assignBtn.getAttribute('data-id');
      document.getElementById('rq-assign-code').textContent = assignBtn.getAttribute('data-code') || '';
      document.getElementById('rq-assign-title').textContent = '— ' + (assignBtn.getAttribute('data-title') || '');
      var aform = document.getElementById('rq-assign-form');
      if (aform) {
        aform.action = '/requests/' + aid + '/assign';
        aform.reset();
        var tech = document.getElementById('rq-assign-tech');
        if (tech) tech.value = '';
      }
      document.getElementById('rq-assign-modal').style.display = 'flex';
    }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { rqHideModal('rq-approve-modal'); rqHideModal('rq-assign-modal'); }
  });
</script>
<% } %>
<script>
(function(){
  var details = document.querySelector('.admin-ui-more-filters');
  if (!details) return;
  var form = details.closest('form[data-auto-filter]');
  var snapshot = null;
  function isMobile(){ return window.matchMedia('(max-width: 860px)').matches; }
  function fields(){
    return Array.prototype.slice.call(form.querySelectorAll('input, select, textarea'));
  }
  function takeSnapshot(){
    snapshot = fields().map(function(el){
      if (el.type === 'checkbox' || el.type === 'radio') return { el: el, checked: el.checked };
      return { el: el, value: el.value };
    });
  }
  function restoreSnapshot(){
    if (!snapshot) return;
    snapshot.forEach(function(s){
      if ('checked' in s) s.el.checked = s.checked;
      else s.el.value = s.value;
      // Trigger change for ec-select/custom UI sync if needed
      var evt = document.createEvent('HTMLEvents');
      evt.initEvent('change', true, false);
      s.el.dispatchEvent(evt);
    });
  }
  function setSuspended(on){
    if (!form) return;
    if (on) form.dataset.autoFilterSuspended = '1';
    else delete form.dataset.autoFilterSuspended;
  }
  function syncBody(){
    var mobileOpen = isMobile() && details.open;
    document.body.classList.toggle('mf-modal-open', !!mobileOpen);
    setSuspended(mobileOpen);
    if (mobileOpen && !snapshot) takeSnapshot();
    if (!details.open) snapshot = null;
  }
  details.addEventListener('toggle', function(){
    if (isMobile() && details.open) takeSnapshot();
    syncBody();
  });
  window.addEventListener('resize', syncBody);
  details.querySelectorAll('[data-mf-close]').forEach(function(el){
    el.addEventListener('click', function(e){
      var isApply = el.hasAttribute('data-filter-apply');
      var isReset = el.tagName === 'A' && el.hasAttribute('data-filter-clear');
      if (isApply) {
        snapshot = null;
        setSuspended(false);
        setTimeout(function(){ details.open = false; syncBody(); }, 0);
        return;
      }
      if (isReset) {
        snapshot = null;
        setSuspended(false);
        setTimeout(function(){ details.open = false; syncBody(); }, 0);
        return;
      }
      e.preventDefault();
      if (isMobile()) restoreSnapshot();
      setSuspended(false);
      details.open = false;
      snapshot = null;
      syncBody();
    });
  });
  syncBody();
})();
</script>
