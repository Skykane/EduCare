<%- include('../partials/header') %>
<% var role = currentUser.role; var advanced = role !== 'requester';
   // Exact canonical statuses; fall back if constants are not exposed to views.
   var S = (typeof C !== 'undefined' && C.STATUS) ? {
     pendingApproval: C.STATUS.PENDING_APPROVAL || 'Pending Approval',
     awaitingAssignment: C.STATUS.APPROVED_AWAITING_ASSIGNMENT || 'Approved – Awaiting Assignment',
     assigned: C.STATUS.ASSIGNED || 'Assigned',
     inProgress: C.STATUS.IN_PROGRESS || 'In Progress',
     onHold: C.STATUS.ON_HOLD || 'On Hold',
     completed: C.STATUS.COMPLETED || 'Completed',
     rejected: C.STATUS.REJECTED || 'Rejected'
   } : {
     pendingApproval: 'Pending Approval',
     awaitingAssignment: 'Approved – Awaiting Assignment',
     assigned: 'Assigned',
     inProgress: 'In Progress',
     onHold: 'On Hold',
     completed: 'Completed',
     rejected: 'Rejected'
   };
   var allStatuses = [
     S.pendingApproval, S.awaitingAssignment, S.assigned,
     S.inProgress, S.onHold, S.completed, S.rejected
   ];
   var pills = [{ label: 'All', status: '' }].concat(allStatuses.map(function (s) {
     return { label: s, status: s };
   }));
   var priorityOptions = (typeof C !== 'undefined' && Array.isArray(C.PRIORITIES) && C.PRIORITIES.length)
     ? C.PRIORITIES : ['Low', 'Medium', 'High'];
   var moreActive = ['priority', 'categoryId', 'location', 'technicianId', 'type', 'from', 'to', 'overdue'].some(function (k) { return f[k]; })
     || (f.status && !pills.some(function (p) { return p.status === f.status; })); %>
<%
  var reqExtraActions = '';
  if (role !== 'technician') {
    reqExtraActions += `<a class="btn-banner-sub" href="/requests/new" onclick="if(window.openSubmitRequestModal){openSubmitRequestModal();return false;}">${icon('plus')} Submit Request</a>`;
  }
  if (role === 'admin') {
    reqExtraActions += `<a class="btn-banner-sub" href="/reports/export/requests${qs({ from: f.from, to: f.to })}">${icon('upload')} Export CSV</a>`;
  }
  var activeFilters = [];
  function pushFilter(key, label, value) { if (value) activeFilters.push({ key: key, label: label, value: value }); }
  var statusLabelMap = { open: 'All open', active: 'Assigned / In progress / On hold' };
  if (f.status) pushFilter('status', 'Status', statusLabelMap[f.status] || f.status);
  if (f.priority) pushFilter('priority', 'Priority', f.priority);
  if (f.categoryId) { var _cf = (categories || []).find(function(c){ return c.id === f.categoryId; }); pushFilter('categoryId', 'Category', _cf ? _cf.name : f.categoryId); }
  if (f.location) pushFilter('location', 'Location', f.location);
  if (f.technicianId) { var _tf = (technicians || []).find(function(t){ return t.id === f.technicianId; }); pushFilter('technicianId', 'Technician', _tf ? _tf.name : f.technicianId); }
  if (f.type) pushFilter('type', 'Type', f.type);
  if (f.from) pushFilter('from', 'From', f.from);
  if (f.to) pushFilter('to', 'To', f.to);
  if (f.overdue) pushFilter('overdue', 'Overdue', 'Only');
  if (f.sort && f.sort !== 'priority') { var sortLabels = { newest: 'Newest', oldest: 'Oldest', target: 'Target date' }; pushFilter('sort', 'Sort', sortLabels[f.sort] || f.sort); }
  var activeFilterCount = activeFilters.length;
%>
<div class="admin-ui-page admin-ui-requests">
  <%- include('../partials/header-banner', {
    breadcrumb: '<a href="/">Home</a> &rsaquo; Maintenance Requests',
    title: 'Maintenance Requests',
    subtitle: 'Track incoming problem reports, technician dispatches, and equipment service status.',
    extraActions: reqExtraActions
  }) %>

  <nav class="admin-ui-pills" aria-label="Filter by status">
    <% pills.forEach(function (p) { var on = (f.status || '') === p.status; %>
      <a href="/requests<%= qs(f, { status: p.status, q: f.q }) %>" class="<%= on ? 'active' : '' %>"<%- on ? ' aria-current="true"' : '' %> data-auto-filter-link data-auto-results="#requests-results" data-filter-key="status" data-filter-value="<%= p.status %>"><%= p.label %></a>
    <% }) %>
  </nav>

  <form class="admin-ui-filter-card" method="get" action="/requests" data-auto-filter data-auto-results="#requests-results">
    <div class="admin-ui-filter-grid">
      <div class="admin-ui-field wide">
        <label for="request-search">Search</label>
        <span class="search-input">
          <span class="search-input-icon"><%- icon('search') %></span>
          <input type="search" id="request-search" name="q" value="<%= f.q %>" placeholder="Request ID, location, category, or description…" aria-label="Search requests">
        </span>
      </div>
      <div class="admin-ui-actions">
        <a class="btn btn-light" href="/requests" data-filter-clear>Clear</a>
        <% if (!advanced && f.status) { %><input type="hidden" name="status" value="<%= f.status %>"><% } %>
      </div>
      <% if (advanced) { %>
      <details class="admin-ui-more-filters"<%= moreActive ? ' open' : '' %>>
        <summary class="btn btn-light admin-ui-mf-summary"><%- icon('layers') %> More filters <span class="admin-ui-mf-count<%= activeFilterCount ? '' : ' is-zero' %>" data-filter-sync="mf-count" aria-label="<%= activeFilterCount %> active filters"><%= activeFilterCount %></span></summary>
        <div class="admin-ui-mf-backdrop" data-mf-close aria-hidden="true"></div>
        <div class="filters card admin-ui-more-filters-panel" role="dialog" aria-modal="true" aria-label="Filter Requests">
          <div class="admin-ui-mf-modal-head">
            <div>
              <h3 class="admin-ui-mf-modal-title">Filter Requests</h3>
              <p class="admin-ui-mf-modal-sub">Refine the task list with compact filters.</p>
            </div>
            <button type="button" class="admin-ui-mf-close" data-mf-close aria-label="Close filters"><%- icon('x') %></button>
          </div>
          <div class="admin-ui-mf-modal-body">
          <div class="admin-ui-mf-grid">
            <div class="field">
              <label for="status">Status</label>
              <select id="status" name="status" data-ec-select="1">
                <option value="">All</option>
                <option value="open" <%= f.status === 'open' ? 'selected' : '' %>>All open</option>
                <option value="active" <%= f.status === 'active' ? 'selected' : '' %>>Assigned / In progress / On hold</option>
                <% (typeof C !== 'undefined' && Array.isArray(C.REQUEST_STATUSES) ? C.REQUEST_STATUSES : allStatuses).forEach(function (s) { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="priority">Priority</label>
              <select id="priority" name="priority" data-ec-select="1">
                <option value="">All</option>
                <% priorityOptions.forEach(function (p) { %><option <%= f.priority === p ? 'selected' : '' %>><%= p %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="categoryId">Category</label>
              <select id="categoryId" name="categoryId" data-ec-select="1">
                <option value="">All</option>
                <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= f.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
              </select>
            </div>
            <div class="field">
              <label for="location">Location</label>
              <select id="location" name="location" data-ec-select="1">
                <option value="">All</option>
                <% if (typeof C !== 'undefined' && C.CAMPUS_ROOMS) { %>
                  <% Object.keys(C.CAMPUS_ROOMS).forEach(function (groupName) { %>
                    <optgroup label="<%= groupName %>">
                      <% C.CAMPUS_ROOMS[groupName].forEach(function (room) { %>
                        <option value="<%= room %>" <%= f.location === room ? 'selected' : '' %>><%= room %></option>
                      <% }) %>
                    </optgroup>
                  <% }) %>
                  <% var _selLoc = f.location || ''; %>
                  <% if (_selLoc && !C.CAMPUS_LOCATIONS.includes(_selLoc)) { %>
                    <option value="<%= _selLoc %>" selected><%= _selLoc %> (Current)</option>
                  <% } %>
                <% } else { %>
                  <% locations.forEach(function (l) { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
                <% } %>
              </select>
            </div>
            <% if (role === 'admin') { %>
            <div class="field admin-ui-mf-full" data-mf="technician">
              <label for="technicianId">Technician</label>
              <select id="technicianId" name="technicianId" data-ec-select="1">
                <option value="">All</option>
                <% technicians.forEach(function (t) { %><option value="<%= t.id %>" <%= f.technicianId === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
              </select>
            </div>
            <% } %>
            <div class="field" data-mf="type">
              <label for="type">Type</label>
              <select id="type" name="type" data-ec-select="1">
                <option value="">All</option>
                <% C.REQUEST_TYPES.forEach(function (t) { %><option <%= f.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
              </select>
            </div>
            <div class="field" data-mf="sort">
              <label for="sort">Sort By</label>
              <select id="sort" name="sort" data-ec-select="1">
                <option value="priority" <%= f.sort === 'priority' ? 'selected' : '' %>>Priority</option>
                <option value="newest" <%= f.sort === 'newest' ? 'selected' : '' %>>Newest</option>
                <option value="oldest" <%= f.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
                <option value="target" <%= f.sort === 'target' ? 'selected' : '' %>>Target date</option>
              </select>
            </div>
          </div>

          <div class="admin-ui-mf-date-range">
            <span class="admin-ui-mf-group-label">Date Range</span>
            <div class="admin-ui-mf-date-grid">
              <div class="field">
                <label for="from">Submitted from</label>
                <input type="date" id="from" name="from" value="<%= f.from %>">
              </div>
              <div class="field">
                <label for="to">To</label>
                <input type="date" id="to" name="to" value="<%= f.to %>">
              </div>
            </div>
          </div>

          <div class="field admin-ui-check-field admin-ui-mf-overdue">
            <label class="admin-ui-check"><input type="checkbox" name="overdue" value="1" <%= f.overdue ? 'checked' : '' %>> Overdue only</label>
          </div>

          </div>
          <div class="actions admin-ui-filter-actions admin-ui-mf-actions">
            <a class="btn btn-light" href="/requests" data-filter-clear data-mf-close><span class="mf-btn-label-desktop">Clear</span><span class="mf-btn-label-mobile">Reset</span></a>
            <button type="button" class="btn btn-primary" data-filter-apply data-mf-close><span class="mf-btn-label-desktop">Apply</span><span class="mf-btn-label-mobile">Apply Filters</span></button>
          </div>
        </div>
      </details>
      <% } %>
    </div>
  </form>

  <div id="requests-results" data-auto-results>
    <% if (activeFilters.length) { %>
      <div class="admin-ui-mf-chips" aria-label="Active filters">
        <div class="admin-ui-mf-chips-list">
          <% activeFilters.forEach(function (af) { %>
            <span class="admin-ui-mf-chip">
              <span class="admin-ui-mf-chip-label"><%= af.label %>: <strong><%= af.value %></strong></span>
              <a href="/requests<%= qs(f, (function(){ var o={}; o[af.key]=''; return o; })()) %>" class="admin-ui-mf-chip-remove" data-auto-filter-link data-auto-results="#requests-results" data-filter-key="<%= af.key %>" data-filter-value="" aria-label="Remove <%= af.label %> filter">&times;</a>
            </span>
          <% }) %>
        </div>
        <a href="/requests" class="admin-ui-mf-chips-clear" data-filter-clear>Clear All</a>
      </div>
    <% } %>
    <% if (!rows.length) { %>
      <div class="admin-ui-card admin-ui-empty">
        <%- icon('search') %>
        <strong>No requests found</strong>
        <small><%= f.q || f.status || moreActive ? 'Try a different search or filter.' : 'Requests you submit will appear here.' %></small>
      </div>
    <% } else { %>
      <div class="admin-ui-card-head">
        <div>
          <h2>Requests (<%= rows.length %>)</h2>
          <p class="admin-ui-muted">Open a request to review details, update its status, or continue the workflow.</p>
        </div>
      </div>
      <div class="admin-ui-request-grid">
        <% rows.forEach(function (r) { %>
          <%- include('../partials/report-card', { r: r, showTech: role !== 'technician', showRequester: role !== 'requester', showPriority: role !== 'requester', adminUi: true }) %>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
<script>
(function(){
  var details = document.querySelector('.admin-ui-more-filters');
  if (!details) return;
  var form = details.closest('form[data-auto-filter]');
  var snapshot = null;
  function isMobile(){ return window.matchMedia('(max-width: 860px)').matches; }
  function fields(){
    return Array.prototype.slice.call(form.querySelectorAll('input, select, textarea'));
  }
  function takeSnapshot(){
    snapshot = fields().map(function(el){
      if (el.type === 'checkbox' || el.type === 'radio') return { el: el, checked: el.checked };
      return { el: el, value: el.value };
    });
  }
  function restoreSnapshot(){
    if (!snapshot) return;
    snapshot.forEach(function(s){
      if ('checked' in s) s.el.checked = s.checked;
      else s.el.value = s.value;
      // Trigger change for ec-select/custom UI sync if needed
      var evt = document.createEvent('HTMLEvents');
      evt.initEvent('change', true, false);
      s.el.dispatchEvent(evt);
    });
  }
  function setSuspended(on){
    if (!form) return;
    if (on) form.dataset.autoFilterSuspended = '1';
    else delete form.dataset.autoFilterSuspended;
  }
  function syncBody(){
    var mobileOpen = isMobile() && details.open;
    document.body.classList.toggle('mf-modal-open', !!mobileOpen);
    setSuspended(mobileOpen);
    if (mobileOpen && !snapshot) takeSnapshot();
    if (!details.open) snapshot = null;
  }
  details.addEventListener('toggle', function(){
    if (isMobile() && details.open) takeSnapshot();
    syncBody();
  });
  window.addEventListener('resize', syncBody);
  details.querySelectorAll('[data-mf-close]').forEach(function(el){
    el.addEventListener('click', function(e){
      var isApply = el.hasAttribute('data-filter-apply');
      var isReset = el.tagName === 'A' && el.hasAttribute('data-filter-clear');
      if (isApply) {
        snapshot = null;
        setSuspended(false);
        setTimeout(function(){ details.open = false; syncBody(); }, 0);
        return;
      }
      if (isReset) {
        snapshot = null;
        setSuspended(false);
        setTimeout(function(){ details.open = false; syncBody(); }, 0);
        return;
      }
      e.preventDefault();
      if (isMobile()) restoreSnapshot();
      setSuspended(false);
      details.open = false;
      snapshot = null;
      syncBody();
    });
  });
  syncBody();
})();
</script>
<%- include('../partials/footer') %>
