<%- include('../partials/header') %>
<% var sev = {
     1: { label: 'Minor', help: 'Still usable', icon: 'check-circle' },
     2: { label: 'Moderate', help: 'Needs attention', icon: 'alert-circle' },
     3: { label: 'Major', help: 'Cannot be used', icon: 'alert' },
     4: { label: 'Critical', help: 'Safety risk', icon: 'octagon' },
   }; %>

<div class="form-floating-wrap">
<div class="page-head">
  <div>
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
      <span class="mono badge badge-gray"><%= r.code %></span>
      <span class="<%= statusClass(r.status) %>"><%= r.status %></span>
    </div>
    <h1>Edit Report · <%= r.code %></h1>
    <p class="muted">Correct any mistakes in the location, category, issue description, or attached photos.</p>
  </div>
  <div class="actions">
    <a class="btn btn-light" href="/requests/<%= r.id %>"><%- icon('arrow-left') %> Back to Request</a>
  </div>
</div>

<div class="alert alert-info" style="margin-bottom:20px;display:flex;align-items:center;gap:10px;">
  <%- icon('info') %>
  <span>You can edit this request while it is still <strong>Pending</strong> review. Once a technician is assigned, details can no longer be changed.</span>
</div>

<%- include('../partials/errors', { errors: errors }) %>

<form method="post" action="/requests/<%= r.id %>/edit" enctype="multipart/form-data" class="card card-floating" id="edit-report-form">
  <h2>Report Information</h2>
  
  <div class="field">
    <label for="title">Issue Summary / Title <span class="req">*</span></label>
    <input type="text" id="title" name="title" value="<%= r.title || '' %>" required maxlength="150" placeholder="e.g., Projector won't turn on, Aircon leaking water">
    <small class="field-hint">A short headline explaining what is wrong.</small>
  </div>

  <div class="form-grid">
    <div class="field">
      <label for="edit-category">Category <span class="req">*</span></label>
      <select id="edit-category" name="categoryId" required data-ec-select="1">
        <option value="">Select category</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= r.category && r.category.id === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field">
      <label for="edit-location">Room / Location <span class="req">*</span></label>
      <select id="edit-location" name="location" required data-ec-select="1">
        <option value="">Select room / location</option>
        <% (typeof locations !== 'undefined' ? locations : []).forEach(function (loc) { %>
          <option value="<%= loc %>" <%= r.location === loc ? 'selected' : '' %>><%= loc %></option>
        <% }) %>
      </select>
      <small class="field-hint">Choose the room or area where the issue was reported.</small>
    </div>
  </div>

  <div class="field">
    <span class="label">How serious is the problem?</span>
    <div class="sev-grid sev-grid-3" role="group" aria-label="Severity">
      <% [1, 2, 3].forEach(function (k) { var s = sev[k]; var on = Number(r.severity) === Number(k) || (!r.severity && Number(k) === 2); %>
        <label class="sev sev-<%= k %> <%= on ? 'checked' : '' %>">
          <input type="checkbox" name="severity" value="<%= k %>" <%= on ? 'checked' : '' %>>
          <span class="sev-tick"><%- icon('check') %></span>
          <span class="sev-ic"><%- icon(s.icon) %></span>
          <strong><%= s.label %></strong>
          <small><%= s.help %></small>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="field">
    <label for="description">Detailed Description <span class="req">*</span></label>
    <textarea id="description" name="description" required maxlength="3000" rows="5" placeholder="Explain what happened, error codes, strange noises, when it started, etc."><%= r.description || '' %></textarea>
    <div class="counter" style="text-align:right;font-size:11px;color:var(--muted);margin-top:2px;">
      <span id="desc-count"><%= (r.description || '').length %></span> / 3000
    </div>
  </div>

  <!-- Existing Photos (if any) -->
  <% if (attachments && attachments.length) { %>
  <div class="field" style="border-top:1px solid var(--border);padding-top:16px;margin-top:16px;">
    <label>Current Attached Photos (<span id="edit-att-count"><%= attachments.length %></span>)</label>
    <p class="muted" style="margin:2px 0 10px;font-size:12.5px;">Click the <strong style="color:#dc2626;">X</strong> button on a photo to remove it. Saved photos require confirmation before permanent deletion.</p>
    <div class="edit-attachments-grid" id="edit-att-grid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(130px, 1fr));gap:12px;">
      <% attachments.forEach(function (a) { %>
        <div class="edit-att-card rd-photo-preview" data-attachment-id="<%= a.id %>" style="border:1px solid var(--border);border-radius:10px;overflow:hidden;background:var(--bg);position:relative;">
          <img src="/uploads/<%= a.filename %>" alt="<%= a.originalName %>" style="width:100%;height:100px;object-fit:cover;display:block;">
          <button type="button" class="rd-photo-remove rd-saved-photo-remove" data-attachment-id="<%= a.id %>" aria-label="Remove photo <%= a.originalName %>">&times;</button>
          <div class="rd-photo-preview-meta" style="padding:6px 8px;font-size:12px;background:var(--surface);">
            <span class="rd-photo-preview-name" title="<%= a.originalName %>"><%= a.originalName %></span>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <% } %>

  <!-- Add New Photos -->
  <div class="field" style="border-top:1px solid var(--border);padding-top:16px;margin-top:16px;">
    <label>Add Additional / Replacement Photos</label>
    <p class="muted" style="margin:2px 0 10px;font-size:12.5px;">Upload clearer photos of the damaged area (optional). Max 6 files, 5 MB each.</p>
    <label class="dropzone" for="photos" id="dropzone" style="cursor:pointer;">
      <span class="dz-ic"><%- icon('camera') %></span>
      <strong>Click to select new photos</strong>
      <span>JPG, PNG, GIF, WEBP up to 5 MB</span>
    </label>
    <input type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="display:none;">
    <div id="new-photos-preview" style="display:none;margin-top:10px;">
      <div id="preview-list" style="display:flex;flex-wrap:wrap;gap:10px;"></div>
    </div>
    <div class="field" style="margin-top:10px;">
      <label for="photoNote">Photo note <span class="hint">(optional)</span></label>
      <input type="text" id="photoNote" name="photoNote" maxlength="1000" placeholder="e.g. Taken from the side showing damaged power switch">
    </div>
  </div>

  <div class="profile-card-footer" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;border-top:1px solid var(--border);padding-top:18px;margin-top:18px;">
    <button type="submit" class="btn btn-primary">
      <%- icon('check') %> Save Changes
    </button>
    <a href="/requests/<%= r.id %>" class="btn btn-light">Discard Changes</a>
    <button type="button" class="btn btn-danger btn-sm" onclick="openCancelModal()" style="margin-left:auto;">
      <%- icon('trash') %> Cancel Report
    </button>
  </div>
</form>
</div>

<!-- Cancel Modal Dialog -->
<div id="cancel-modal" class="modal-backdrop" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;align-items:center;justify-content:center;padding:16px;">
  <div class="modal-card card" style="max-width:480px;width:100%;margin:0;box-shadow:0 12px 36px rgba(0,0,0,0.3);">
    <div class="modal-head" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <h2 style="margin:0;color:var(--red);display:flex;align-items:center;gap:8px;">
        <%- icon('alert') %> Cancel Report
      </h2>
      <button type="button" class="btn-link" onclick="closeCancelModal()" style="font-size:18px;cursor:pointer;">✕</button>
    </div>
    <p style="font-size:13.5px;line-height:1.4;margin:0 0 14px;">
      Are you sure you want to cancel request <strong><%= r.code %></strong>? Once cancelled, this ticket will be closed and technicians will not be dispatched.
    </p>
    <form method="post" action="/requests/<%= r.id %>/cancel">
      <div class="field">
        <label>Reason for cancellation:</label>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:6px;font-size:13px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason" value="Reported by mistake (wrong equipment or details)" checked>
            <span>Reported by mistake (wrong equipment or details)</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason" value="Problem is already resolved / working now">
            <span>Problem is already resolved / working now</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason" value="Duplicate report">
            <span>Duplicate report</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="radio" name="reason" value="" id="reason-other-radio">
            <span>Other reason (specify below)</span>
          </label>
        </div>
      </div>
      <div class="field" id="other-reason-field" style="margin-top:8px;">
        <input type="text" id="custom-reason" name="custom_reason" maxlength="500" placeholder="Type specific reason (optional)..." oninput="document.getElementById('reason-other-radio').value = this.value">
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px;">
        <button type="button" class="btn btn-light" onclick="closeCancelModal()">Keep Report</button>
        <button type="submit" class="btn btn-danger">Yes, Cancel Report</button>
      </div>
    </form>
  </div>
</div>

<script>
  (function () {
    // Character counter for description
    var desc = document.getElementById('description');
    var count = document.getElementById('desc-count');
    if (desc && count) {
      desc.addEventListener('input', function () {
        count.textContent = this.value.length;
      });
    }

    // New photo preview with remove (X)
    var photoInput = document.getElementById('photos');
    var previewWrap = document.getElementById('new-photos-preview');
    var previewList = document.getElementById('preview-list');
    if (photoInput && previewWrap && previewList) {
      var selected = [];
      var allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
      var maxFiles = 6;
      var maxBytes = 5 * 1024 * 1024;

      function syncInput() {
        var dt = new DataTransfer();
        selected.forEach(function (item) { dt.items.add(item.file); });
        photoInput.files = dt.files;
      }

      function renderPreviews() {
        previewList.innerHTML = '';
        previewWrap.style.display = selected.length ? 'block' : 'none';
        selected.forEach(function (item, idx) {
          var card = document.createElement('div');
          card.className = 'rd-photo-preview';
          card.style.width = '130px';

          var img = document.createElement('img');
          img.src = item.url;
          img.alt = item.file.name;
          img.loading = 'lazy';

          var meta = document.createElement('div');
          meta.className = 'rd-photo-preview-meta';
          var name = document.createElement('span');
          name.className = 'rd-photo-preview-name';
          name.textContent = item.file.name;
          name.title = item.file.name;
          var size = document.createElement('span');
          size.className = 'rd-photo-preview-size';
          size.textContent = (item.file.size / (1024 * 1024)).toFixed(item.file.size >= 1024 * 1024 ? 2 : 0) + (item.file.size >= 1024 * 1024 ? ' MB' : ' KB');
          if (item.file.size < 1024 * 1024) size.textContent = Math.max(1, Math.round(item.file.size / 1024)) + ' KB';
          meta.appendChild(name);
          meta.appendChild(size);

          var removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'rd-photo-remove';
          removeBtn.setAttribute('aria-label', 'Remove ' + item.file.name);
          removeBtn.innerHTML = '&times;';
          removeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            URL.revokeObjectURL(item.url);
            selected.splice(idx, 1);
            syncInput();
            renderPreviews();
          });

          card.appendChild(img);
          card.appendChild(meta);
          card.appendChild(removeBtn);
          previewList.appendChild(card);
        });
      }

      function addFiles(fileList) {
        Array.prototype.forEach.call(fileList || [], function (file) {
          if (allowed.indexOf(file.type) === -1) return;
          if (file.size > maxBytes) return;
          if (selected.length >= maxFiles) return;
          var exists = selected.some(function (it) { return it.file.name === file.name && it.file.size === file.size && it.file.lastModified === file.lastModified; });
          if (exists) return;
          selected.push({ file: file, url: URL.createObjectURL(file) });
        });
        syncInput();
        renderPreviews();
      }

      photoInput.addEventListener('change', function () { addFiles(photoInput.files); photoInput.value = ''; syncInput(); });
    }

    // Saved attachment delete (X) with confirmation
    document.querySelectorAll('.rd-saved-photo-remove[data-attachment-id]').forEach(function (btn) {
      btn.addEventListener('click', async function (e) {
        e.preventDefault();
        e.stopPropagation();
        var attId = btn.getAttribute('data-attachment-id');
        if (!attId) return;

        var confirmed = false;
        if (window.ecConfirmPhotoRemove) confirmed = await window.ecConfirmPhotoRemove();
        else if (window.ecConfirm) confirmed = await window.ecConfirm({ title: 'Remove Photo?', message: 'Are you sure you want to remove this photo? This action cannot be undone.', confirmLabel: 'Remove Photo', cancelLabel: 'Cancel', tone: 'danger', icon: 'trash' });
        else confirmed = window.confirm('Remove this photo permanently? This action cannot be undone.');
        if (!confirmed) return;

        btn.disabled = true;
        try {
          var res = await fetch('/requests/<%= r.id %>/attachments/' + encodeURIComponent(attId) + '/delete', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
          });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok || !data.ok) {
            btn.disabled = false;
            if (window.ecAlert) await window.ecAlert((data && data.error) || 'Could not remove photo.', { title: 'Could Not Remove Photo', tone: 'danger', icon: 'warning' });
            else window.alert((data && data.error) || 'Could not remove photo.');
            return;
          }
          var card = btn.closest('[data-attachment-id]');
          if (card) card.remove();
          var countEl = document.getElementById('edit-att-count');
          if (countEl) countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || '1', 10) - 1));
        } catch (err) {
          btn.disabled = false;
          if (window.ecAlert) await window.ecAlert('Network error while removing photo.', { title: 'Connection Error', tone: 'danger', icon: 'warning' });
          else window.alert('Network error while removing photo.');
        }
      });
    });
  })();

  function openCancelModal() {
    var modal = document.getElementById('cancel-modal');
    if (modal) modal.style.display = 'flex';
  }
  function closeCancelModal() {
    var modal = document.getElementById('cancel-modal');
    if (modal) modal.style.display = 'none';
  }
</script>

<%- include('../partials/footer') %>
