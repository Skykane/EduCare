<%- include('partials/header') %>
<%
  // Guard against legacy sample descriptions even if this view is rendered
  // from another route. The stored database value is never changed here.
  var DEMO_DESCRIPTION = /^\s*SAMPLE\/DEMO category created for the sample inventory\.\s*$/i;
  function visibleDescription(value) {
    var text = String(value || '').trim();
    return DEMO_DESCRIPTION.test(text) ? '' : text;
  }
  var catExtraActions = `
    <a class="btn-banner-sub" href="/equipment/new">${icon('plus')} Add Equipment</a>
  `;
%>
<%- include('partials/header-banner', {
  breadcrumb: '<a href="/">Home</a> &rsaquo; <a href="/equipment">Equipment Management</a> &rsaquo; Categories',
  title: 'Equipment Categories',
  subtitle: 'Group school equipment by category, track maintenance status, and organize items.',
  extraActions: catExtraActions
}) %>

<div class="stats category-status-stats" aria-label="Equipment status summary">
  <% C.EQUIPMENT_STATUSES.forEach(function (s) { %>
    <a class="stat category-stat <%= statusColor(s) %>" href="/equipment?status=<%= encodeURIComponent(s) %>">
      <span class="category-stat-icon"><%- icon(statusIcon(s)) %></span>
      <span class="label category-stat-label"><%= s %></span>
      <span class="value category-stat-value"><%= totals[s] %></span>
    </a>
  <% }) %>
</div>

<section class="card card-floating add-category-card">
  <div class="add-category-head">
    <h2 class="add-category-title">Add New Category</h2>
    <p class="add-category-subtitle">Create a category to organize equipment. The name is required; a short description is optional.</p>
  </div>

  <form method="post" action="/categories" class="add-category-form">
    <div class="field">
      <label for="name">Category Name *</label>
      <input type="text" id="name" name="name" required maxlength="100" placeholder="Enter category name" autocomplete="off">
    </div>
    <div class="field">
      <label for="description">Description <span class="hint">(optional)</span></label>
      <input type="text" id="description" name="description" maxlength="300" placeholder="Short description of items in this category" autocomplete="off">
    </div>
    <button class="btn btn-primary add-category-submit" type="submit">
      <%- icon('plus') %> Add Category
    </button>
  </form>
</section>

<section class="card categories-table-card">
  <div class="categories-table-head">
    <h2>Equipment Categories</h2>
    <p>Click a category name to filter equipment, or use Edit and Delete to manage it.</p>
  </div>

  <div class="table-wrap categories-table-wrap">
    <table class="stack-table categories-table">
      <colgroup>
        <col class="cat-col-category">
        <col class="cat-col-operational">
        <col class="cat-col-repair">
        <col class="cat-col-maintenance">
        <col class="cat-col-out">
        <col class="cat-col-total">
        <col class="cat-col-actions">
      </colgroup>
      <thead>
        <tr>
          <th class="col-left">Category &amp; Description</th>
          <% C.EQUIPMENT_STATUSES.forEach(function (s) { %>
            <th class="col-center"><%= s %></th>
          <% }) %>
          <th class="col-center">Total</th>
          <th class="col-center">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!categories.length) { %>
          <tr>
            <td colspan="7" class="empty">No categories recorded yet. Use the form above to add one.</td>
          </tr>
        <% } %>

        <% categories.forEach(function (c) { %>
          <% if (editId === c.id) { %>
            <tr>
              <td data-label="" colspan="7" class="category-edit-cell">
                <form method="post" action="/categories/<%= c.id %>" class="category-edit-form">
                  <div class="field">
                    <label for="edit-name-<%= c.id %>">Category Name *</label>
                    <input type="text" id="edit-name-<%= c.id %>" name="name" value="<%= c.name %>" required maxlength="100" autocomplete="off">
                  </div>
                  <div class="field">
                    <label for="edit-description-<%= c.id %>">Description <span class="hint">(optional)</span></label>
                    <input type="text" id="edit-description-<%= c.id %>" name="description" value="<%= visibleDescription(c.description) %>" maxlength="300" placeholder="Short description of items in this category" autocomplete="off">
                  </div>
                  <div class="category-edit-actions">
                    <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    <a class="btn btn-sm btn-light" href="/categories">Cancel</a>
                  </div>
                </form>
              </td>
            </tr>
          <% } else { %>
            <% var description = visibleDescription(c.description); %>
            <tr>
              <td data-label="Category &amp; Description" class="col-left">
                <span class="category-identity">
                  <a class="category-link" href="/equipment?categoryId=<%= c.id %>" title="Filter equipment in <%= c.name %>"><%= c.name %></a>
                  <span class="category-description<%= description ? '' : ' is-empty' %>"><%= description || 'No description provided' %></span>
                </span>
              </td>
              <% C.EQUIPMENT_STATUSES.forEach(function (s) { %>
                <td data-label="<%= s %>" class="col-center">
                  <span class="category-count <%= statusColor(s) %><%= c.counts[s] ? '' : ' category-zero' %>"><%= c.counts[s] %></span>
                </td>
              <% }) %>
              <td data-label="Total" class="col-center">
                <span class="category-total"><%= c.total %></span>
              </td>
              <td data-label="" class="col-center category-actions-cell">
                <span class="category-actions-inner">
                  <a class="btn btn-light btn-sm category-action-btn" href="/categories?edit=<%= c.id %>" aria-label="Edit category <%= c.name %>">
                    <%- icon('edit') %> <span class="category-action-label">Edit</span>
                  </a>
                  <form method="post" action="/categories/<%= c.id %>/delete" class="inline-form" data-confirm="Are you sure you want to delete category &quot;<%= c.name %>&quot;?">
                    <button class="btn btn-light btn-sm category-action-btn category-delete" type="submit" aria-label="Delete category <%= c.name %>" title="Delete <%= c.name %>">
                      <%- icon('trash') %> <span class="category-action-label">Delete</span>
                    </button>
                  </form>
                </span>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="card locations-link-card">
  <div class="locations-link-main">
    <span class="locations-link-icon"><%- icon('map-pin') %></span>
    <div>
      <h3>Campus Locations &amp; Rooms</h3>
      <p>Looking for equipment distribution by room or laboratory? Locations has its own dedicated tab.</p>
    </div>
  </div>
  <a href="/locations" class="btn btn-sm btn-primary">
    <%- icon('map-pin') %> Go to Locations Tab &rarr;
  </a>
</section>

<%- include('partials/footer') %>
