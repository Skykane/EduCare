<%- include('../partials/header') %>
<%
  var techExtraActions = `
    <a class="btn-banner-sub" href="/users/new?role=technician" onclick="if(window.openNewAccountModal){openNewAccountModal('technician');return false;}">${icon('plus')} Add Technician</a>
    <a class="btn-banner-sub" href="/reports/export/workload">${icon('upload')} Export Workload</a>
  `;
%>
<div class="admin-ui-page admin-ui-technicians">
  <%- include('../partials/header-banner', {
    breadcrumb: '<a href="/">Home</a> &rsaquo; Technicians',
    title: 'Technician Staff & Workload',
    subtitle: 'Profiles, specializations, real-time availability, and active work orders.',
    extraActions: techExtraActions
  }) %>

  <% if (!list.length) { %>
    <div class="admin-ui-card admin-ui-empty">
      <%- icon('users') %>
      <strong>No technician accounts yet.</strong>
      <small>Add a technician to start tracking workload and availability.</small>
    </div>
  <% } else { %>
    <div class="admin-ui-tech-grid<%= list.length === 1 ? ' is-single' : '' %>">
      <% list.forEach(function (s) { var t = s.tech; %>
        <article class="admin-ui-tech-card<%= t.active ? '' : ' inactive' %>">
          <div class="admin-ui-tech-top">
            <div class="admin-ui-tech-person">
              <%- include('../partials/avatar', { user: t, name: t.name, size: 'md', className: 'admin-ui-tech-avatar' }) %>
              <div>
                <a class="admin-ui-tech-name" href="/technicians/<%= t.id %>"><%= t.name %></a>
                <span class="admin-ui-tech-email"><%= t.email %><%= t.phone ? ' · ' + t.phone : '' %></span>
              </div>
            </div>
            <% if (!t.active) { %>
              <span class="badge badge-gray">Inactive</span>
            <% } else { %>
              <span class="<%= statusClass(t.availability) %>"><%= t.availability %></span>
            <% } %>
          </div>

          <div class="admin-ui-tech-tags">
            <% if (!s.specializations.length) { %><span class="admin-ui-tech-tag">General</span><% } %>
            <% s.specializations.forEach(function (c) { %><span class="admin-ui-tech-tag"><%= c.name %></span><% }) %>
          </div>

          <div class="admin-ui-metrics">
            <div class="admin-ui-metric">
              <strong><%= s.active.length %></strong>
              <span>Active</span>
            </div>
            <div class="admin-ui-metric is-red">
              <strong><%= s.overdue %></strong>
              <span>Overdue</span>
            </div>
            <div class="admin-ui-metric">
              <strong><%= s.completedCount %></strong>
              <span>Completed</span>
            </div>
            <div class="admin-ui-metric">
              <strong><%= s.avgDays === null ? '—' : s.avgDays.toFixed(1) %></strong>
              <span>Avg. days</span>
            </div>
          </div>

          <% if (t.active) { %>
            <div class="admin-ui-tech-actions">
              <form method="post" action="/technicians/<%= t.id %>/availability" class="admin-ui-inline-form">
                <input type="hidden" name="back" value="/technicians">
                <select data-ec-select="1" name="availability" aria-label="Availability">
                  <% C.AVAILABILITY.forEach(function (a) { %>
                    <option value="<%= a %>" <%= t.availability === a ? 'selected' : '' %>><%= a %></option>
                  <% }) %>
                </select>
                <button class="btn btn-light btn-sm" type="submit">Set</button>
              </form>
              <a class="btn btn-light btn-sm" href="/users/<%= t.id %>/edit">Edit profile</a>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
