<%- include('../partials/header') %>
<%
  var techExtraActions = `
    <a class="btn-banner-sub" href="/users/new?role=technician" onclick="if(window.openNewAccountModal){openNewAccountModal('technician');return false;}">${icon('plus')} Add Technician</a>
    <a class="btn-banner-sub" href="/reports/export/workload">${icon('upload')} Export Workload</a>
  `;
%>
<%- include('../partials/header-banner', {
  breadcrumb: '<a href="/">Home</a> &rsaquo; Technicians',
  title: 'Technician Staff & Workload',
  subtitle: 'Profiles, specializations, real-time availability, and active work orders.',
  extraActions: techExtraActions
}) %>

<% if (!list.length) { %><div class="card empty">No technician accounts yet.</div><% } %>
<div class="grid grid-3">
  <% list.forEach(function (s) { var t = s.tech; %>
    <div class="card tech-card" style="margin:0;<%= t.active ? '' : 'opacity:.6' %>">
      <div class="top">
        <div style="display:flex;gap:10px;align-items:center">
          <% if (t.avatar) { %>
            <span class="avatar avatar-has-img"><img src="/uploads/<%= t.avatar %>" alt="" class="avatar-img"></span>
          <% } else { %>
            <span class="avatar"><%= initials(t.name) %></span>
          <% } %>
          <div>
            <a href="/technicians/<%= t.id %>"><strong><%= t.name %></strong></a>
            <div class="muted" style="font-size:12px"><%= t.email %><%= t.phone ? ' · ' + t.phone : '' %></div>
          </div>
        </div>
        <% if (!t.active) { %><span class="badge badge-gray">Inactive</span><% } else { %><span class="<%= statusClass(t.availability) %>"><%= t.availability %></span><% } %>
      </div>
      <div>
        <% if (!s.specializations.length) { %><span class="tag">General</span><% } %>
        <% s.specializations.forEach(function (c) { %><span class="tag"><%= c.name %></span><% }) %>
      </div>
      <div class="meta">
        <div><strong><%= s.active.length %></strong><span class="muted">Active</span></div>
        <div><strong style="<%= s.overdue ? 'color:var(--red)' : '' %>"><%= s.overdue %></strong><span class="muted">Overdue</span></div>
        <div><strong><%= s.completedCount %></strong><span class="muted">Completed</span></div>
        <div><strong><%= s.avgDays === null ? '—' : s.avgDays.toFixed(1) %></strong><span class="muted">Avg. days</span></div>
      </div>
      <% if (t.active) { %>
      <form method="post" action="/technicians/<%= t.id %>/availability" class="filters mt">
        <input type="hidden" name="back" value="/technicians">
        <div class="field">
          <select name="availability" aria-label="Availability">
            <% C.AVAILABILITY.forEach(function (a) { %><option <%= t.availability === a ? 'selected' : '' %>><%= a %></option><% }) %>
          </select>
        </div>
        <button class="btn btn-light btn-sm" type="submit">Set</button>
        <a class="btn btn-light btn-sm" href="/users/<%= t.id %>/edit">Edit profile</a>
      </form>
      <% } %>
    </div>
  <% }) %>
</div>
<%- include('../partials/footer') %>
