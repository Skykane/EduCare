<%- include('partials/header') %>
<%
  var S = {
    assigned: 'Assigned',
    inProgress: 'In Progress',
    onHold: 'On Hold',
    completed: 'Completed',
    rework: 'Rework Required'
  };
  function rows(value) { return Array.isArray(value) ? value : []; }
  function ic(name) { return typeof icon === 'function' ? icon(name) : ''; }
  function sc(value) { return typeof statusClass === 'function' ? statusClass(value) : 'badge badge-gray'; }
  function dt(value) { return typeof fmtDateTime === 'function' ? fmtDateTime(value) : String(value || ''); }
  function dtOnly(value) { return typeof fmtDate === 'function' ? fmtDate(value) : String(value || ''); }
  function statusUrl(status) { return '/requests?status=' + encodeURIComponent(status); }
  function numberOr(value, fallback) { return typeof value === 'number' ? value : fallback; }

  var techSummary = (typeof summary !== 'undefined' && summary) ? summary : (typeof stats !== 'undefined' && stats ? stats : {});
  var techActiveTasks = rows(typeof activeTasks !== 'undefined' ? activeTasks : (typeof active !== 'undefined' ? active : null));
  var techCompletedTasks = rows(typeof completedTasks !== 'undefined' ? completedTasks : (typeof myCompleted !== 'undefined' ? myCompleted : null));
  var techSpecs = rows(typeof specs !== 'undefined' ? specs : null);
  var availabilityOptions = (typeof C !== 'undefined' && Array.isArray(C.AVAILABILITY)) ? C.AVAILABILITY : ['Available', 'Busy', 'On Leave'];
  var inProgressCount = techActiveTasks.filter(function (r) { return r && (r.status === S.inProgress || r.status === S.onHold); }).length;
  var assignedCount = techActiveTasks.filter(function (r) { return r && r.status === S.assigned; }).length;
  var overdueCount = numberOr(techSummary.overdue, techActiveTasks.filter(function (r) { return r && r.overdue; }).length);

  function taskName(r) {
    var eq = r && r.equipment;
    var cat = r && r.category ? r.category.name : '';
    return {
      title: r ? (r.title || (eq ? eq.name : 'Repair request')) : 'Repair request',
      sub: eq ? [eq.code, eq.name].filter(Boolean).join(' · ') : (cat || (r && r.location) || 'General repair')
    };
  }
%>
<div class="admin-ui-page admin-ui-dashboard dash adm-dash tech-dash">
  <%- include('partials/header-banner', {
    breadcrumb: 'Home',
    title: 'Dashboard',
    subtitle: 'Your assigned repair tasks, progress updates, and completion reports.'
  }) %>

  <!-- Technician status and availability -->
  <section class="card admin-ui-card tech-status-card" aria-label="Technician status">
    <div class="tech-status-main">
      <div class="tech-status-profile">
        <%- include('partials/avatar', { user: currentUser, name: currentUser.name, size: 'sm' }) %>
        <div class="tech-status-identity">
          <span class="tech-status-role"><%- ic('wrench') %> Technician</span>
          <strong class="tech-status-name"><%= currentUser.name %></strong>
        </div>
      </div>
      <div class="tech-status-meta">
        <span class="chip-role tech-status-availability"><%- ic('check-circle') %><span class="<%= sc(currentUser.availability) %>"><%= currentUser.availability %></span></span>
        <% if (currentUser.department) { %>
          <span class="chip-role ghost tech-status-dept"><%- ic('building') %><%= currentUser.department %></span>
        <% } %>
        <% techSpecs.forEach(function (c) { %>
          <span class="pill tech-status-spec"><%= c.name %></span>
        <% }) %>
      </div>
    </div>
    <form method="post" action="/technicians/<%= currentUser.id %>/availability" class="tech-status-form">
      <input type="hidden" name="back" value="/">
      <label for="availability" class="tech-status-label">Status</label>
      <select data-ec-select="1" name="availability" id="availability" class="tech-status-select">
        <% availabilityOptions.forEach(function (a) { %><option <%= currentUser.availability === a ? 'selected' : '' %>><%= a %></option><% }) %>
      </select>
      <button class="btn btn-sm btn-primary tech-status-update" type="submit"><%- ic('refresh') %> Update</button>
    </form>
  </section>

  <!-- Compact assigned-work summary -->
  <section class="adm-summary tech-summary" aria-label="Technician summary">
    <a class="adm-stat" href="<%= statusUrl(S.assigned) %>">
      <span class="adm-stat-ic tone-indigo"><%- ic('clipboard') %></span>
      <span class="adm-stat-body">
        <strong class="adm-stat-num"><%= numberOr(techSummary.assigned, assignedCount) %></strong>
        <span class="adm-stat-label">Assigned</span>
        <span class="adm-stat-note">Awaiting your inspection</span>
      </span>
    </a>
    <a class="adm-stat" href="<%= statusUrl(S.inProgress) %>">
      <span class="adm-stat-ic tone-blue"><%- ic('wrench') %></span>
      <span class="adm-stat-body">
        <strong class="adm-stat-num"><%= numberOr(techSummary.inProgress, inProgressCount) %></strong>
        <span class="adm-stat-label">In Progress / On Hold</span>
        <span class="adm-stat-note">Currently under repair</span>
      </span>
    </a>
    <a class="adm-stat<%= overdueCount ? ' tech-stat-alert' : '' %>" href="/requests?overdue=1">
      <span class="adm-stat-ic <%= overdueCount ? 'tone-red' : 'tone-gray' %>"><%- ic('alert') %></span>
      <span class="adm-stat-body">
        <strong class="adm-stat-num"><%= overdueCount %></strong>
        <span class="adm-stat-label">Overdue Tasks</span>
        <span class="adm-stat-note"><%= overdueCount ? 'Attention required immediately' : 'All tasks within schedule' %></span>
      </span>
    </a>
    <a class="adm-stat" href="<%= statusUrl(S.completed) %>">
      <span class="adm-stat-ic tone-green"><%- ic('check-circle') %></span>
      <span class="adm-stat-body">
        <strong class="adm-stat-num"><%= numberOr(techSummary.completedTasks, techCompletedTasks.length) %></strong>
        <span class="adm-stat-label">Completed</span>
        <span class="adm-stat-note">Repairs you finished</span>
      </span>
    </a>
  </section>

  <div class="adm-grid tech-grid">
    <div class="adm-main">
      <% if (overdueCount > 0) { %>
        <div class="alert alert-error tech-overdue-alert">
          <div class="tech-overdue-copy">
            <%- ic('alert') %>
            <span>You have <strong><%= overdueCount %></strong> overdue maintenance task<%= overdueCount === 1 ? '' : 's' %> past target completion date.</span>
          </div>
          <a href="/requests?overdue=1" class="btn btn-sm btn-danger">View Overdue</a>
        </div>
      <% } %>

      <!-- Active assigned tasks -->
      <section class="adm-panel" aria-labelledby="tech-active-heading">
        <div class="adm-panel-head">
          <div class="adm-panel-title">
            <span class="adm-icon-chip tone-blue"><%- ic('clipboard') %></span>
            <div>
              <h2 id="tech-active-heading">My Active Tasks (<%= techActiveTasks.length %>)</h2>
              <p class="muted tech-panel-sub">Only tasks assigned to you. Open a task to log work and progress.</p>
            </div>
          </div>
          <a href="/requests?status=active" class="adm-panel-link">All My Tasks <%- ic('arrow-right') %></a>
        </div>
        <div class="tech-panel-body">
          <% if (!techActiveTasks.length) { %>
            <div class="empty-state tech-empty-state">
              <span class="empty-ic"><%- ic('check-circle') %></span>
              <strong>All caught up!</strong>
              <small>No active repair tasks are assigned to you right now.</small>
            </div>
          <% } else { %>
            <div class="wf-list">
              <% techActiveTasks.forEach(function (r) { var name = taskName(r); %>
                <div class="workflow-row adm-wf-row tech-task-row">
                  <span class="wf-main">
                    <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
                    <strong><%= name.title %></strong>
                    <span class="muted"><%= name.sub %> · <%= r.requester ? r.requester.name : 'Requester' %></span>
                  </span>
                  <span class="wf-meta">
                    <span class="<%= sc(r.status) %>"><%= r.status %></span>
                    <span class="muted"><%= r.targetDate ? 'Due ' + dtOnly(r.targetDate) : 'No target date' %></span>
                  </span>
                  <span class="wf-action tech-task-actions">
                    <% if (r.status === S.assigned) { %>
                      <a class="btn btn-primary btn-sm" href="/requests/<%= r.id %>#progress">▶ Start Repair</a>
                    <% } %>
                    <% if (r.status === S.inProgress) { %>
                      <a class="btn btn-light btn-sm" href="/requests/<%= r.id %>#progress"><%- ic('pause') %> Put On Hold</a>
                      <a class="btn btn-success btn-sm" href="/requests/<%= r.id %>#complete"><%- ic('check-circle') %> Complete</a>
                    <% } %>
                    <% if (r.status === S.onHold) { %>
                      <a class="btn btn-primary btn-sm" href="/requests/<%= r.id %>#progress">▶ Resume Work</a>
                      <a class="btn btn-success btn-sm" href="/requests/<%= r.id %>#complete"><%- ic('check-circle') %> Complete</a>
                    <% } %>
                    <a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Details</a>
                  </span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>

      <!-- Completed assigned tasks -->
      <section class="adm-panel" aria-labelledby="tech-completed-heading">
        <div class="adm-panel-head">
          <div class="adm-panel-title">
            <span class="adm-icon-chip tone-green"><%- ic('check-circle') %></span>
            <div>
              <h2 id="tech-completed-heading">Recently Completed (<%= techCompletedTasks.length %>)</h2>
              <p class="muted tech-panel-sub">Completion reports and verification decisions for your repairs.</p>
            </div>
          </div>
          <a href="<%= statusUrl(S.completed) %>" class="adm-panel-link">View History <%- ic('arrow-right') %></a>
        </div>
        <div class="tech-panel-body">
          <% if (!techCompletedTasks.length) { %>
            <p class="adm-empty">No completed repairs yet.</p>
          <% } else { %>
            <div class="wf-list">
              <% techCompletedTasks.forEach(function (r) { var name = taskName(r); %>
                <div class="workflow-row adm-wf-row">
                  <span class="wf-main">
                    <a class="mono wf-code" href="/requests/<%= r.id %>"><%= r.code %></a>
                    <strong><%= name.title %></strong>
                    <span class="muted">Completed <%= dt(r.completedAt) %></span>
                  </span>
                  <span class="wf-meta">
                    <span class="<%= sc(S.completed) %>"><%= S.completed %></span>
                    <span class="<%= sc(r.verificationStatus || 'Not Submitted') %>"><%= r.verificationStatus || 'Not Submitted' %></span>
                  </span>
                  <span class="wf-action">
                    <% if (r.verificationStatus === S.rework) { %>
                      <a class="btn btn-danger btn-sm" href="/requests/<%= r.id %>#verification">View Rework</a>
                    <% } %>
                    <a class="btn btn-light btn-sm" href="/requests/<%= r.id %>">Report</a>
                  </span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </section>
    </div>

    <div class="adm-side">
      <%- include('partials/pm-alerts') %>

      <section class="adm-panel" aria-label="My specializations">
        <div class="adm-panel-head">
          <div class="adm-panel-title">
            <span class="adm-icon-chip tone-teal"><%- ic('tag') %></span>
            <h2>My Specializations</h2>
          </div>
          <a href="/profile/edit" class="adm-panel-link">Edit in Profile <%- ic('arrow-right') %></a>
        </div>
        <div class="tech-panel-body">
          <p class="muted tech-panel-sub">Your skills help administrators match new requests to your queue.</p>
          <div class="spec-chips-wrap tech-spec-chips">
            <% if (techSpecs.length) { %>
              <% techSpecs.forEach(function (c) { %>
                <span class="tag"><%- ic('tag') %> <%= c.name %></span>
              <% }) %>
            <% } else { %>
              <span class="tag">General Maintenance (Available for all categories)</span>
            <% } %>
          </div>
        </div>
      </section>

      <%- include('partials/equipment-status') %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
