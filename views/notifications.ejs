<%- include('partials/header') %>
<%
  var notifExtraActions = `<a class="btn-banner-sub" href="/notifications${show === 'all' ? '?show=unread' : ''}" data-auto-filter-link data-auto-results="#notifications-results" data-filter-key="show" data-filter-value="${show === 'all' ? 'unread' : 'all'}">${show === 'all' ? 'Show unread only' : 'Show all'}</a>`;
  if (unreadCount) {
    notifExtraActions += `
      <form method="post" action="/notifications/read-all" style="margin:0;">
        <button class="btn-banner-sub" type="submit" style="cursor:pointer;">Mark all as read</button>
      </form>
    `;
  }
%>
<%- include('partials/header-banner', {
  breadcrumb: '<a href="/">Home</a> &rsaquo; Notifications',
  title: 'Notifications & Alerts',
  subtitle: unreadCount ? unreadCount + ' unread notification(s) requiring your attention.' : 'You are all caught up! No unread notifications.',
  extraActions: notifExtraActions
}) %>

<div class="card" id="notifications-results" data-auto-results>
  <div class="ec-identity notif-owner">
    <%- include('partials/avatar', { user: currentUser, name: currentUser.name, size: 'sm' }) %>
    <span class="ec-identity__text">
      <strong class="ec-identity__name">Notifications for <%= currentUser.name %></strong>
      <span class="ec-identity__meta"><%= C.ROLES[currentUser.role] %></span>
    </span>
  </div>
  <% if (!list.length) { %><p class="empty">You're all caught up.</p><% } %>
  <% list.forEach(function (n) { %>
    <div class="notif type-<%= n.type %> <%= n.read ? '' : 'unread' %>">
      <span class="dot"></span>
      <div class="body">
        <div><%= n.message %></div>
        <div class="when"><%= fmtDateTime(n.createdAt) %> · <%= timeAgo(n.createdAt) %></div>
      </div>
      <% if (n.link) { %>
        <form method="post" action="/notifications/<%= n.id %>/open"><button class="btn btn-light btn-sm" type="submit">Open</button></form>
      <% } %>
    </div>
  <% }) %>
</div>
<%- include('partials/footer') %>
