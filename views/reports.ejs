    </div>
    <div class="reports-summary-card">
      <span class="reports-summary-icon amber"><%- icon('clock') %></span>
      <span class="reports-summary-copy"><span class="reports-summary-label">Pending Requests</span><strong class="reports-summary-value"><%= rep.summary.pendingRequests %></strong></span>
    </div>
    <div class="reports-summary-card">
      <span class="reports-summary-icon green"><%- icon('check-circle') %></span>
