<%- include('partials/header') %>
<%
  var range = qs({ from: f.from, to: f.to });
  var today = todayISO();
  var preset30From = addDays(today, -29);
  var presetMonthFrom = today.slice(0, 8) + '01';
  var avgText = rep.summary.avgResolutionDays === null ? '—' : Number(rep.summary.avgResolutionDays).toFixed(1) + ' days';
  var reqAvgText = rep.requestSummary.avgResolutionDays === null ? '—' : Number(rep.requestSummary.avgResolutionDays).toFixed(1) + ' days';
%>
<style>
/* =========================================================
   Maintenance Reports & Analytics — compact dashboard
   Scoped to this page only. Presentation layer: no report
   calculations, records, exports or print actions are changed.
   ========================================================= */
.reports-page, .reports-page * { text-align: left; }

/* Header: keep the maroon gradient, remove the extra height. */
.reports-page .dash-header-banner {
  padding: 10px 18px !important;
  min-height: 0 !important;
  margin-bottom: 14px !important;
  box-shadow: none !important;
  border-color: rgba(255, 255, 255, 0.14) !important;
}
.reports-page .dash-banner-watermark { display: none !important; }
.reports-page .dash-banner-content { justify-content: space-between !important; }
.reports-page .dash-banner-text h1 { font-size: 18px !important; }
.reports-page .dash-banner-text p { font-size: 12px !important; margin-top: 3px !important; }
.reports-page .dash-banner-actions { flex: 0 0 auto !important; }
.reports-page .dash-banner-actions .btn-banner-sub { padding: 6px 13px !important; font-size: 11.5px !important; }

/* Date range panel */
.reports-page .reports-filter-card {
  padding: 14px 16px !important;
  margin-bottom: 16px !important;
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05) !important;
}
.reports-page .reports-section-label {
  margin: 0 0 10px;
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}
.reports-page .reports-filter-form {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 12px;
}
.reports-page .reports-field { display: flex; flex-direction: column; min-width: 0; }
.reports-page .reports-field label {
  margin: 0 0 5px;
  font-size: 11.5px;
  font-weight: 700;
  color: var(--muted);
  text-align: left !important;
}
.reports-page .reports-field input[type='date'] {
  width: 168px !important;
  height: 38px !important;
  min-height: 38px !important;
  padding: 0 11px !important;
  border: 1px solid var(--border) !important;
  border-radius: 8px !important;
  background: var(--surface) !important;
  color: var(--text) !important;
  font-size: 12.5px !important;
  text-align: left !important;
  box-sizing: border-box !important;
}
.reports-page .reports-filter-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}
.reports-page .reports-filter-actions .btn,
.reports-page .reports-filter-actions .reports-preset {
  height: 38px !important;
  min-height: 38px !important;
  padding: 0 14px !important;
  border-radius: 8px !important;
  font-size: 12.5px !important;
  box-shadow: none !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
}
.reports-page .reports-filter-actions .reports-preset {
  border: 1px solid var(--border) !important;
  background: var(--surface) !important;
  color: var(--text) !important;
  text-decoration: none !important;
}
.reports-page .reports-filter-actions .reports-preset:hover { border-color: var(--primary) !important; color: var(--primary) !important; }
.reports-page .reports-filter-actions .reports-preset.current {
  border-color: var(--primary) !important;
  background: var(--primary-soft) !important;
  color: var(--primary) !important;
  font-weight: 700 !important;
}
.reports-page .reports-period-note {
  margin: 10px 0 0;
  font-size: 11.5px;
  color: var(--muted);
}

/* Top summary cards */
.reports-page .reports-summary-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}
.reports-page .reports-summary-card {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 12px 13px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
}
.reports-page .reports-summary-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  border-radius: 9px;
  color: var(--primary);
  background: var(--primary-soft);
}
.reports-page .reports-summary-icon .ic { width: 17px; height: 17px; }
.reports-page .reports-summary-icon.green { color: var(--green); background: var(--green-soft); }
.reports-page .reports-summary-icon.amber { color: var(--amber); background: var(--amber-soft); }
.reports-page .reports-summary-icon.red { color: var(--red); background: var(--red-soft); }
.reports-page .reports-summary-icon.blue { color: var(--blue); background: var(--blue-soft); }
.reports-page .reports-summary-icon.indigo { color: var(--indigo); background: var(--indigo-soft); }
.reports-page .reports-summary-icon.teal { color: var(--teal); background: var(--teal-soft); }
.reports-page .reports-summary-copy { display: flex; flex-direction: column; min-width: 0; }
.reports-page .reports-summary-label { font-size: 11px; font-weight: 600; color: var(--muted); line-height: 1.25; }
.reports-page .reports-summary-value { font-size: 19px; line-height: 1.2; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }

/* Report section cards */
.reports-page .reports-card {
  padding: 16px 18px !important;
  margin-bottom: 16px !important;
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05) !important;
}
.reports-page .reports-card-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 14px;
}
.reports-page .reports-card-head h2 { margin: 0; font-size: 15px; font-weight: 700; color: var(--text); }
.reports-page .reports-card-head .reports-head-left { display: flex; align-items: center; gap: 9px; min-width: 0; flex-wrap: wrap; }
.reports-page .reports-count-pill {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 2px 9px;
  border-radius: 999px;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.reports-page .reports-export {
  height: 32px !important;
  min-height: 32px !important;
  padding: 0 12px !important;
  border-radius: 8px !important;
  font-size: 11.5px !important;
  box-shadow: none !important;
  text-decoration: none !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6px !important;
}
.reports-page .reports-export .ic { width: 13px; height: 13px; }
.reports-page .reports-subhead { margin: 18px 0 10px; font-size: 13px; font-weight: 700; color: var(--text); }

/* Repair request KPIs and breakdown panels */
.reports-page .reports-kpis {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 14px;
}
.reports-page .reports-kpi {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
}
.reports-page .reports-kpi-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  flex: 0 0 auto;
  border-radius: 9px;
  color: var(--primary);
  background: var(--primary-soft);
}
.reports-page .reports-kpi-icon .ic { width: 18px; height: 18px; }
.reports-page .reports-kpi-copy { display: flex; flex-direction: column; min-width: 0; }
.reports-page .reports-kpi-label { font-size: 11.5px; font-weight: 600; color: var(--muted); }
.reports-page .reports-kpi-value { font-size: 20px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }

.reports-page .reports-panels {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr) minmax(0, 1.2fr);
  gap: 12px;
  align-items: start;
}
.reports-page .reports-side { display: grid; gap: 12px; min-width: 0; }
.reports-page .reports-panel {
  min-width: 0;
  padding: 13px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
}
.reports-page .reports-panel-title { margin: 0 0 10px; font-size: 12.5px; font-weight: 700; color: var(--text); }
.reports-page .reports-status-list { list-style: none; margin: 0; padding: 0; }
.reports-page .reports-status-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 29px;
  padding: 4px 0;
  border-bottom: 1px solid var(--border);
}
.reports-page .reports-status-row:last-child { border-bottom: 0; }
.reports-page .reports-status-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--gray, #94a3b8); }
.reports-page .reports-status-dot.green { background: var(--green); }
.reports-page .reports-status-dot.amber { background: var(--amber); }
.reports-page .reports-status-dot.blue { background: var(--blue); }
.reports-page .reports-status-dot.red { background: var(--red); }
.reports-page .reports-status-dot.indigo { background: var(--indigo); }
.reports-page .reports-status-dot.teal { background: var(--teal); }
.reports-page .reports-status-name { flex: 1; min-width: 0; font-size: 12px; color: var(--text); }
.reports-page .reports-status-count { font-size: 13px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
.reports-page .reports-mini-grid { display: grid; gap: 7px; }
.reports-page .reports-mini-card {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 42px;
  padding: 7px 10px;
  border: 1px solid var(--border);
  border-left-width: 4px;
  border-radius: 9px;
  background: var(--surface);
}
.reports-page .reports-mini-card.green { border-left-color: var(--green); }
.reports-page .reports-mini-card.amber { border-left-color: var(--amber); }
.reports-page .reports-mini-card.blue { border-left-color: var(--blue); }
.reports-page .reports-mini-card.red { border-left-color: var(--red); }
.reports-page .reports-mini-card.indigo { border-left-color: var(--indigo); }
.reports-page .reports-mini-card.teal { border-left-color: var(--teal); }
.reports-page .reports-mini-card.gray { border-left-color: var(--gray, #94a3b8); }
.reports-page .reports-mini-label { flex: 1; min-width: 0; font-size: 12px; font-weight: 600; color: var(--muted); }
.reports-page .reports-mini-value { font-size: 17px; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }

/* Compact grid tables */
.reports-page .reports-table-box {
  border: 1px solid var(--border);
  border-radius: 10px;
  overflow: hidden;
  background: var(--surface);
}
.reports-page .reports-table-box .table-wrap { overflow-x: auto; }
.app .reports-page table.reports-table {
  width: 100% !important;
  table-layout: fixed !important;
  margin: 0 !important;
  border-collapse: collapse !important;
}
.app .reports-page table.reports-table thead th {
  height: 38px !important;
  padding: 7px 9px !important;
  font-size: 10.5px !important;
  font-weight: 700 !important;
  color: #fff !important;
  background: #7d0c17 !important;
  text-align: center !important;
  vertical-align: middle !important;
  border-right: 1px solid rgba(255, 255, 255, 0.18) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18) !important;
  white-space: normal !important;
}
.app .reports-page table.reports-table thead th:last-child { border-right: 0 !important; }
.app .reports-page table.reports-table tbody td {
  padding: 7px 9px !important;
  font-size: 12px !important;
  color: var(--text);
  vertical-align: middle !important;
  border-right: 1px solid var(--border) !important;
  border-bottom: 1px solid var(--border) !important;
  white-space: normal !important;
  overflow-wrap: anywhere;
}
.app .reports-page table.reports-table tbody tr:last-child > td { border-bottom: 0 !important; }
.app .reports-page table.reports-table tbody td:last-child { border-right: 0 !important; }
.app .reports-page table.reports-table tbody tr:nth-child(even) > td { background-color: #fbf9fa !important; }
.app .reports-page table.reports-table tbody tr:hover > td { background-color: var(--primary-soft) !important; }
.app .reports-page table.reports-table tbody tr[hidden] { display: none !important; }

/* Column alignment — custom hooks survive table-align.js. */
.app .reports-page table.reports-table th.rep-left,
.app .reports-page table.reports-table td.rep-left,
.app .reports-page table.reports-table td.rep-left .cell { text-align: left !important; justify-content: flex-start !important; }
.app .reports-page table.reports-table th.rep-center,
.app .reports-page table.reports-table td.rep-center,
.app .reports-page table.reports-table td.rep-center .cell { text-align: center !important; justify-content: center !important; }
.app .reports-page table.reports-table td.rep-left .cell,
.app .reports-page table.reports-table td.rep-center .cell { max-width: 100% !important; }
.reports-page .reports-cell-main { display: block; line-height: 1.35; }
.reports-page .reports-cell-sub { display: block; margin-top: 2px; font-size: 10.5px; color: var(--muted); line-height: 1.3; }
.reports-page .reports-cell-main strong { font-weight: 700; }
.reports-page .reports-cell-main a { color: var(--primary); text-decoration: none; }
.reports-page .reports-cell-main a:hover { text-decoration: underline; }
.reports-page .reports-cell-num { font-variant-numeric: tabular-nums; font-weight: 700; }
.reports-page .reports-table .badge {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 10.5px !important;
  padding: 2px 7px !important;
  min-height: 19px !important;
  white-space: nowrap !important;
  margin: 0 !important;
}
.reports-page .reports-table .reports-edit-link {
  display: inline-flex;
  align-items: center;
  gap: 3px;
  margin-top: 3px;
  color: var(--amber);
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
}
.reports-page .reports-table .reports-edit-link .ic { width: 12px; height: 12px; }
.reports-page .reports-note { margin: 10px 0 0; font-size: 11.5px; color: var(--muted); }
.reports-page .reports-empty {
  padding: 16px !important;
  text-align: center !important;
  color: var(--muted);
  font-size: 12.5px;
}

/* Equipment condition cards */
.reports-page .reports-condition-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 14px;
}
.reports-page .reports-condition-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  min-width: 0;
  padding: 12px 10px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 11px;
  text-align: center !important;
}
.reports-page .reports-condition-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 8px;
  color: var(--green);
  background: var(--green-soft);
}
.reports-page .reports-condition-icon .ic { width: 16px; height: 16px; }
.reports-page .reports-condition-icon.amber { color: var(--amber); background: var(--amber-soft); }
.reports-page .reports-condition-icon.blue { color: var(--blue); background: var(--blue-soft); }
.reports-page .reports-condition-icon.red { color: var(--red); background: var(--red-soft); }
.reports-page .reports-condition-label { font-size: 11.5px; font-weight: 600; color: var(--muted); }
.reports-page .reports-condition-value { font-size: 21px; line-height: 1.1; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
.reports-page .reports-two-col {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

/* Pagination */
.reports-page .reports-pagination {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-top: 12px;
  margin-top: 12px;
  border-top: 1px solid var(--border);
}
.reports-page .reports-range-text { font-size: 11.5px; color: var(--muted); }
.reports-page .reports-pager { display: flex; align-items: center; gap: 8px; }
.reports-page .reports-page-text { font-size: 11.5px; color: var(--muted); min-width: 74px; text-align: center; }
.reports-page .reports-page-btn {
  height: 30px !important;
  min-height: 30px !important;
  padding: 0 10px !important;
  border-radius: 7px !important;
  font-size: 11.5px !important;
  box-shadow: none !important;
}
.reports-page .reports-page-btn:disabled { opacity: 0.45; cursor: not-allowed; }

/* Responsive */
@media (max-width: 1180px) {
  .reports-page .reports-summary-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .reports-page .reports-panels { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .reports-page .reports-category-panel { grid-column: 1 / -1; }
}
@media (max-width: 900px) {
  .app .reports-page table.reports-table tbody td,
  .app .reports-page table.reports-table tbody td .cell,
  .app .reports-page table.reports-table tbody td::before {
    text-align: left !important;
    justify-content: flex-start !important;
    align-items: flex-start !important;
  }
  .app .reports-page table.reports-table tbody td.rep-center .cell { justify-content: flex-start !important; }
}
@media (max-width: 760px) {
  /* Keep the banner compact; the shared banner rules wrap its action full-width. */
  .reports-page .dash-header-banner { padding: 8px 12px !important; }
  .reports-page .dash-banner-content { flex-wrap: nowrap !important; gap: 8px !important; }
  .reports-page .dash-banner-text { min-width: 0 !important; }
  .reports-page .dash-banner-text h1 { font-size: 15px !important; line-height: 1.15 !important; }
  .reports-page .dash-banner-text p { font-size: 10.5px !important; line-height: 1.25 !important; max-width: none !important; }
  .reports-page .dash-banner-actions { width: auto !important; flex: 0 0 auto !important; }
  .reports-page .dash-banner-actions .btn-banner-sub { padding: 5px 9px !important; font-size: 10.5px !important; }

  .reports-page .reports-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .reports-page .reports-condition-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .reports-page .reports-kpis { grid-template-columns: 1fr; }
  .reports-page .reports-panels { grid-template-columns: minmax(0, 1fr); }
  .reports-page .reports-category-panel { grid-column: auto; }
  .reports-page .reports-two-col { grid-template-columns: minmax(0, 1fr); }
  .reports-page .reports-field input[type='date'] { width: 100% !important; }
  .reports-page .reports-field { width: 100%; }
  .reports-page .reports-filter-actions { width: 100%; }
  .reports-page .reports-filter-actions .btn,
  .reports-page .reports-filter-actions .reports-preset { flex: 1 1 auto !important; }
  .reports-page .reports-pagination { justify-content: center; }
}
@media (max-width: 480px) {
  .reports-page .reports-summary-grid { grid-template-columns: minmax(0, 1fr); }
  .reports-page .reports-card { padding: 14px !important; }
}

/* Print: keep tables readable, repeat headers, avoid clipped columns. */
@media print {
  .reports-page .reports-filter-card,
  .reports-page .no-print,
  .reports-page .reports-pagination { display: none !important; }
  /* Pagination hides rows on screen; printing must include every filtered record.
     .app prefix is required to beat the screen-only scoped rules. */
  .app .reports-page table.reports-table tbody tr[hidden] { display: table-row !important; }
  .reports-page .reports-card { break-inside: auto !important; page-break-inside: auto !important; box-shadow: none !important; }
  .reports-page .reports-summary-grid { grid-template-columns: repeat(5, minmax(0, 1fr)) !important; }
  .reports-page .reports-condition-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
  .reports-page .reports-panels { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
  .app .reports-page table.reports-table { table-layout: auto !important; width: 100% !important; font-size: 9.5px !important; }
  .app .reports-page table.reports-table thead { display: table-header-group !important; }
  .app .reports-page table.reports-table tr { break-inside: avoid !important; page-break-inside: avoid !important; }
  .app .reports-page table.reports-table th,
  .app .reports-page table.reports-table td { padding: 4px 5px !important; }
  .reports-page .reports-two-col { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) !important; }
}
</style>

<div class="reports-page">
  <div class="no-print">
    <%- include('partials/header-banner', {
      breadcrumb: '<a href="/">Home</a> &rsaquo; Reports',
      title: 'Maintenance Reports & Analytics',
      subtitle: (f.from ? 'From ' + fmtDate(f.from) : 'From beginning') + ' to ' + (f.to ? fmtDate(f.to) : 'today') + '. All figures below use this period unless marked as current.',
      extraActions: `<button class="btn-banner-sub" type="button" onclick="window.print()" title="Print this report">${icon('file')} Print Report</button>`
    }) %>
  </div>

  <div class="print-only" style="margin-bottom:12px">
    <strong>EDUCARE: School Equipment Maintenance and Repair Management System</strong><br>
    Generated <%= fmtDateTime(generatedAt) %> by <%= currentUser.name %><br>
    Period: <%= f.from ? fmtDate(f.from) : 'Beginning' %> – <%= f.to ? fmtDate(f.to) : 'Today' %>
  </div>

  <div class="reports-filter-card no-print">
    <div class="reports-section-label">Date Range &amp; Filters</div>
    <form class="reports-filter-form" id="reportsFilterForm" method="get" action="/reports" data-auto-filter data-auto-results="#reports-results">
      <div class="reports-field">
        <label for="reportFrom">From</label>
        <input type="date" id="reportFrom" name="from" value="<%= f.from %>">
      </div>
      <div class="reports-field">
        <label for="reportTo">To</label>
        <input type="date" id="reportTo" name="to" value="<%= f.to %>">
      </div>
      <div class="reports-filter-actions">
