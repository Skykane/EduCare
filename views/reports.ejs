        <a class="reports-preset<%= (f.from === presetMonthFrom && f.to === today ? ' current' : '') %>" href="/reports<%= qs({ from: presetMonthFrom, to: today }) %>" data-from="<%= presetMonthFrom %>" data-to="<%= today %>" data-filter-sync="preset-month">This Month</a>
        <a class="reports-preset<%= (!f.from && !f.to ? ' current' : '') %>" href="/reports" data-from="" data-to="" data-filter-sync="preset-all">All Time</a>
      </div>
    </form>
