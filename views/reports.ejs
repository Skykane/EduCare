<script>
  // Preset ranges populate the date inputs and immediately refresh every report
  // through the same form, so all sections always use one selected period.
  (function () {
    var form = document.getElementById('reportsFilterForm');
    if (!form) return;
    Array.prototype.forEach.call(document.querySelectorAll('.reports-preset'), function (preset) {
      preset.addEventListener('click', function (e) {
        e.preventDefault();
        document.getElementById('reportFrom').value = preset.getAttribute('data-from');
        document.getElementById('reportTo').value = preset.getAttribute('data-to');
        if (window.educareApplyFilters) window.educareApplyFilters(form);
        else form.submit();
      });
    });
  })();

  // Client-side pagination over the already-filtered report rows. Rows are
  // hidden, never removed, and the CSV exports still use the full server data.
  // Exposed so automatically refreshed results re-bind correctly.
  window.educareInitReportPagination = function () {
    document.querySelectorAll('.reports-page [data-pagination]').forEach(function (bar) {
      if (bar.getAttribute('data-pagination-ready') === '1') return;
      var table = document.querySelector('.' + bar.getAttribute('data-pagination'));
      if (!table) return;
      var rows = Array.prototype.slice.call(table.querySelectorAll('tbody tr[data-row-index]'));
      if (!rows.length) return;
      var rangeText = bar.querySelector('[data-role="range"]');
      var pageText = bar.querySelector('[data-role="page"]');
      var prev = bar.querySelector('[data-role="prev"]');
      var next = bar.querySelector('[data-role="next"]');
      if (!rangeText || !pageText || !prev || !next) return;
      bar.setAttribute('data-pagination-ready', '1');

      var size = 10;
      var page = 1;

      function render() {
        var total = rows.length;
        var pages = Math.max(1, Math.ceil(total / size));
        if (page > pages) page = pages;
        var startIndex = (page - 1) * size;
        var endIndex = Math.min(startIndex + size, total);
        rows.forEach(function (row, i) { row.hidden = !(i >= startIndex && i < endIndex); });
        rangeText.textContent = 'Showing ' + (startIndex + 1) + '–' + endIndex + ' of ' + total + ' records · ' + size + ' per page';
        pageText.textContent = 'Page ' + page + ' of ' + pages;
        prev.disabled = page <= 1;
        next.disabled = page >= pages;
      }

      prev.addEventListener('click', function () { if (page > 1) { page -= 1; render(); } });
      next.addEventListener('click', function () { if (page < Math.ceil(rows.length / size)) { page += 1; render(); } });
      render();
    });
  };
  window.educareInitReportPagination();
</script>

