        <span class="reports-kpi-icon"><%- icon('clipboard') %></span>
        <span class="reports-kpi-copy"><span class="reports-kpi-label">Total Submitted</span><strong class="reports-kpi-value"><%= rep.requestSummary.total %></strong></span>
      </div>
      <div class="reports-kpi">
        <span class="reports-kpi-icon indigo"><%- icon('clock') %></span>
        <span class="reports-kpi-copy"><span class="reports-kpi-label">Average Time to Resolve</span><strong class="reports-kpi-value"><%= reqAvgText %></strong></span>
