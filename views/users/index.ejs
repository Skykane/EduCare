<%- include('../partials/header') %>

<style>
/* =========================================================
   User Accounts — clean, professional redesign
   Scoped to this page only. All account logic is untouched.
   ========================================================= */
.users-page,
.users-page * { text-align: left; }

/* Override the global centred-alignment layer for this page. */
.users-page .dash-header-banner,
.users-page .dash-banner-content,
.users-page .dash-banner-text,
.users-page .dash-banner-text h1,
.users-page .dash-banner-text p,
.users-page .users-section-head h2,
.users-page form.filters label {
  text-align: left !important;
}
.users-page input:not([type='checkbox']):not([type='radio']):not([type='file']):not([type='hidden']),
.users-page select,
.users-page textarea,
.users-page input::placeholder,
.users-page select option {
  text-align: left !important;
}
.app .users-page table.users-table th,
.app .users-page table.users-table th .cell,
.app .users-page table.users-table td.users-col-role,
.app .users-page table.users-table td.users-col-role .cell,
.app .users-page table.users-table td.users-col-status,
.app .users-page table.users-table td.users-col-status .cell,
.app .users-page table.users-table td.users-col-last,
.app .users-page table.users-table td.users-col-last .cell,
.app .users-page table.users-table td.users-col-actions,
.app .users-page table.users-table td.users-col-actions .cell {
  text-align: center !important;
}
.app .users-page table.users-table td.users-col-name,
.app .users-page table.users-table td.users-col-name .cell,
.app .users-page table.users-table td.users-col-email,
.app .users-page table.users-table td.users-col-email .cell,
.app .users-page table.users-table td.users-col-department,
.app .users-page table.users-table td.users-col-department .cell {
  text-align: left !important;
}
.app .users-page table.users-table td.users-col-name .cell,
.app .users-page table.users-table td.users-col-email .cell,
.app .users-page table.users-table td.users-col-department .cell {
  display: block !important;
}

/* --- Page header -------------------------------------------------------
   Metrics intentionally mirror the Equipment Inventory header. */
.app .users-page .dash-header-banner {
  padding: 11px 18px !important;
  min-height: 0 !important;
  margin-bottom: 14px !important;
  border-radius: 12px !important;
  box-shadow: 0 4px 14px rgba(88, 13, 22, 0.22) !important;
  text-align: left !important;
}
.app .users-page .dash-banner-watermark { display: none !important; }
.app .users-page .dash-banner-content {
  align-items: center !important;
  justify-content: space-between !important;
  text-align: left !important;
}
.app .users-page .dash-banner-text {
  min-width: 220px;
  flex: 1 1 auto;
  text-align: left !important;
}
.app .users-page .dash-banner-text h1 {
  margin: 0 0 2px !important;
  font-size: 18px !important;
  line-height: 1.25 !important;
  text-align: left !important;
}
.app .users-page .dash-banner-text p {
  margin: 0 !important;
  font-size: 12px !important;
  line-height: 1.4 !important;
  text-align: left !important;
}
.app .users-page .dash-banner-actions {
  flex: 0 0 auto !important;
  justify-content: flex-end !important;
  flex-wrap: wrap !important;
  text-align: right !important;
}
.app .users-page .btn-banner-sub {
  height: 34px !important;
  min-height: 34px !important;
  padding: 0 13px !important;
  border-radius: 8px !important;
  font-size: 11.5px !important;
  text-align: center !important;
  white-space: nowrap !important;
}

/* --- Section tabs ------------------------------------------------------
   Same full-width, left-aligned nav used by Equipment/Categories/Locations. */
.app .users-page .section-tabs {
  display: flex !important;
  width: 100% !important;
  max-width: 100% !important;
  min-width: 0;
  box-sizing: border-box !important;
  margin: 0 0 14px !important;
  padding: 5px 10px !important;
  gap: 5px !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  justify-content: flex-start !important;
  overflow-x: auto !important;
  background: var(--gray-soft) !important;
  border: 1px solid var(--border) !important;
  border-radius: 10px !important;
}
.app .users-page .section-tabs a {
  flex: 0 0 auto;
  padding: 7px 14px !important;
  min-height: 0 !important;
  border-radius: 7px !important;
  font-size: 12.5px !important;
  font-weight: 700 !important;
  text-align: center !important;
  white-space: nowrap !important;
  background: transparent !important;
  color: var(--muted) !important;
}
.app .users-page .section-tabs a:hover { color: var(--text) !important; text-decoration: none; }
.app .users-page .section-tabs a.active {
  background: #ffffff !important;
  color: var(--primary) !important;
  box-shadow: var(--shadow) !important;
}

/* --- Pending approvals notice ------------------------------------------ */
.users-page .users-pending-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  padding: 11px 16px;
  margin: 0 0 16px;
  border: 1px solid rgba(245, 158, 11, 0.3);
  border-left: 4px solid #f59e0b;
  border-radius: 10px;
  background: rgba(245, 158, 11, 0.08);
}
.users-page .users-pending-notice-copy { display: flex; align-items: center; gap: 11px; min-width: 0; }
.users-page .users-pending-notice-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  background: rgba(245, 158, 11, 0.16);
  color: #d97706;
}
.users-page .users-pending-notice-icon .ic { width: 17px; height: 17px; }
.users-page .users-pending-notice strong { display: block; font-size: 13px; line-height: 1.3; }
.users-page .users-pending-notice p { margin: 2px 0 0; font-size: 11.5px; color: var(--muted); }

/* --- Search & Filters -------------------------------------------------- */
.users-page .users-section-head { display: flex; align-items: center; margin: 0 0 10px; }
.users-page .users-section-head h2 { margin: 0; font-size: 15px; font-weight: 700; color: var(--text); }
/* app.js injects a toggle button; this page uses a static heading instead. */
.users-page > .filter-toggle { display: none !important; }
.users-page form.filters,
.users-page form.filters.collapsed {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: flex-end !important;
  gap: 14px !important;
  padding: 16px 18px !important;
  margin: 0 0 16px !important;
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  background: var(--surface) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06) !important;
}
.users-page form.filters .field { margin: 0 !important; flex: 1 1 0; min-width: 0; }
.users-page form.filters .field.wide { flex: 2.2 1 0; }
.users-page form.filters label {
  font-size: 12px !important;
  font-weight: 600 !important;
  color: var(--muted) !important;
  margin: 0 0 5px !important;
}
.users-page form.filters input,
.users-page form.filters select {
  height: 38px !important;
  min-height: 38px !important;
  padding: 0 11px !important;
  border-radius: 8px !important;
  font-size: 12.5px !important;
}
.users-page form.filters .actions {
  display: flex !important;
  flex-direction: row !important;
  gap: 8px !important;
  margin: 0 !important;
  flex: 0 0 auto !important;
  align-items: center !important;
  justify-content: flex-start !important;
}
.users-page form.filters .actions .btn {
  height: 38px !important;
  min-height: 38px !important;
  padding: 0 16px !important;
  border-radius: 8px !important;
  font-size: 12.5px !important;
  box-shadow: none !important;
}

/* --- Results table ----------------------------------------------------- */
.users-page .users-table-card { margin-bottom: 16px !important; }
.users-page .users-table-card .table-wrap {
  border: 1px solid var(--border) !important;
  border-radius: 12px !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06) !important;
}
.app .users-page table.users-table { width: 100% !important; table-layout: fixed !important; }
.users-page table.users-table col:nth-child(1) { width: 16%; }
.users-page table.users-table col:nth-child(2) { width: 21%; }
.users-page table.users-table col:nth-child(3) { width: 10%; }
.users-page table.users-table col:nth-child(4) { width: 13%; }
.users-page table.users-table col:nth-child(5) { width: 9%; }
.users-page table.users-table col:nth-child(6) { width: 11%; }
.users-page table.users-table col:nth-child(7) { width: 20%; }
.app .users-page table.users-table thead th {
  height: 42px !important;
  padding: 8px 10px !important;
  font-size: 10.5px !important;
  color: #fff !important;
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%) !important;
  border-right: 1px solid rgba(255, 255, 255, 0.18) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.18) !important;
  white-space: nowrap !important;
}
/* Text-heavy columns keep their header aligned with the data below. */
.app .users-page table.users-table thead th:nth-child(1),
.app .users-page table.users-table thead th:nth-child(2),
.app .users-page table.users-table thead th:nth-child(4) { text-align: left !important; }
.app .users-page table.users-table thead th:last-child { border-right: 0 !important; }
.app .users-page table.users-table tbody td {
  padding: 9px 10px !important;
  height: 72px !important;
  font-size: 12.5px !important;
  vertical-align: middle !important;
  border-right: 1px solid var(--border) !important;
  border-bottom: 1px solid var(--border) !important;
  overflow-wrap: anywhere !important;
}
/* Subtle alternating rows; the surface colour follows the active theme. */
.app .users-page table.users-table tbody tr,
.app .users-page table.users-table tbody tr:nth-child(odd) > td { background: var(--surface) !important; }
.app .users-page table.users-table tbody tr:nth-child(even),
.app .users-page table.users-table tbody tr:nth-child(even) > td { background: var(--gray-soft) !important; }
.app .users-page table.users-table tbody tr:hover > td { background: var(--primary-soft) !important; }
.app .users-page table.users-table tbody tr:last-child td { border-bottom: 0 !important; }
.app .users-page table.users-table tbody td:last-child { border-right: 0 !important; }

/* Name + secondary information */
.users-page .users-name { display: block; font-size: 12.5px; font-weight: 700; line-height: 1.3; color: var(--text); }
.users-page .users-sub { display: block; margin-top: 2px; font-size: 11px; line-height: 1.35; color: var(--muted); }
.users-page .users-sub a { color: var(--muted); text-decoration: none; }
.users-page .users-sub a:hover { color: var(--primary); text-decoration: underline; }

/* Compact, consistent badges */
.app .users-page table.users-table .badge {
  min-height: 22px !important;
  padding: 3px 9px !important;
  font-size: 11px !important;
  gap: 4px !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  vertical-align: middle !important;
  max-width: 100% !important;
  white-space: normal !important;
  overflow-wrap: anywhere !important;
}
.app .users-page table.users-table .badge .ic { width: 12px; height: 12px; flex: 0 0 auto; }
.app .users-page table.users-table td.users-col-role .badge { font-size: 10.5px !important; padding: 3px 7px !important; }

/* Actions */
.users-page .row-actions {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: wrap !important;
  gap: 6px !important;
  justify-content: center !important;
  align-items: center !important;
  margin: 0 !important;
}
.users-page .row-actions .btn {
  height: 30px !important;
  min-height: 30px !important;
  padding: 0 10px !important;
  font-size: 11.5px !important;
  border-radius: 7px !important;
  box-shadow: none !important;
  gap: 5px !important;
}
.users-page .row-actions .btn .ic { width: 13px; height: 13px; }
.users-page .row-actions .users-action-edit {
  background: #fff !important;
  color: var(--primary) !important;
  border: 1px solid var(--primary) !important;
}
.users-page .row-actions .users-action-edit:hover { background: var(--primary-soft) !important; }
.users-page .row-actions .users-action-toggle {
  background: #fff !important;
  color: var(--muted) !important;
  border: 1px solid var(--border) !important;
}
.users-page .row-actions .users-action-toggle:hover { background: var(--primary-soft) !important; color: var(--primary) !important; }
/* Deactivate keeps a subtle amber warning treatment; Activate stays neutral. */
.users-page .row-actions .users-action-deactivate {
  color: #b45309 !important;
  border-color: rgba(245, 158, 11, 0.5) !important;
  background: rgba(245, 158, 11, 0.08) !important;
}
.users-page .row-actions .users-action-deactivate:hover { background: rgba(245, 158, 11, 0.16) !important; color: #92400e !important; }

/* --- Responsive -------------------------------------------------------- */
@media (min-width: 861px) and (max-width: 1200px) {
  .users-page form.filters { flex-wrap: wrap !important; }
  .users-page form.filters .field.wide { flex: 1 1 200px !important; }
  .users-page form.filters .field { flex: 1 1 140px !important; }
  /* Widen Actions so Edit/Deactivate stay side by side instead of stacking. */
  .users-page table.users-table col:nth-child(1) { width: 18%; }
  .users-page table.users-table col:nth-child(2) { width: 17%; }
  .users-page table.users-table col:nth-child(3) { width: 10%; }
  .users-page table.users-table col:nth-child(4) { width: 10%; }
  .users-page table.users-table col:nth-child(5) { width: 9%; }
  .users-page table.users-table col:nth-child(6) { width: 8%; }
  .users-page table.users-table col:nth-child(7) { width: 28%; }
  .app .users-page table.users-table tbody td { height: 84px !important; font-size: 11px !important; line-height: 1.25 !important; }
  .users-page .users-name { font-size: 11px !important; line-height: 1.25 !important; }
  .users-page .users-sub { font-size: 10px !important; line-height: 1.25 !important; }
  .app .users-page table.users-table tbody td,
  .app .users-page table.users-table thead th { padding: 8px !important; }
  .app .users-page table.users-table .badge { font-size: 10px !important; padding: 3px 6px !important; }
  .users-page .row-actions .btn { padding: 0 6px !important; font-size: 10.5px !important; white-space: nowrap !important; }
}
@media (max-width: 900px) {
  .app .users-page .dash-banner-content { align-items: flex-start !important; }
  .app .users-page .dash-banner-actions { justify-content: flex-end !important; text-align: right !important; }
}
@media (max-width: 860px) {
  /* stack-table turns each account into a card: cells must size naturally. */
  .app .users-page table.users-table tbody tr { padding: 10px 12px !important; }
  .app .users-page table.users-table tbody td {
    height: auto !important;
    min-height: 0 !important;
    padding: 7px 0 !important;
  }
  .app .users-page table.users-table tbody td.users-col-actions { justify-content: center !important; }
  .users-page .row-actions {
    flex-direction: row !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    width: 100%;
  }
  .users-page .row-actions .btn { width: auto !important; flex: 0 0 auto !important; }
}
@media (max-width: 760px) {
  .app .users-page .dash-header-banner { padding: 10px 13px !important; }
  .app .users-page .dash-banner-text h1 { font-size: 17px !important; }
  .app .users-page .dash-banner-text p { font-size: 11.5px !important; }
  .app .users-page .dash-banner-actions { width: 100% !important; }
}
@media (max-width: 640px) {
  .users-page form.filters,
  .users-page form.filters.collapsed {
    flex-direction: column !important;
    align-items: stretch !important;
    flex-wrap: nowrap !important;
    gap: 12px !important;
    padding: 14px !important;
  }
  .users-page form.filters .field,
  .users-page form.filters .field.wide { flex: 1 1 auto !important; width: 100% !important; }
  .users-page form.filters .actions { width: 100% !important; }
  .users-page form.filters .actions .btn { flex: 0 0 auto !important; min-width: 96px; }
}
@media (max-width: 420px) {
  .app .users-page .btn-banner-sub { width: 100%; justify-content: center; }
}
@media (max-width: 380px) {
  .app .users-page .section-tabs a { padding: 7px 10px !important; font-size: 12px !important; }
  /* Keep the shared topbar from forcing horizontal scroll on this page only. */
  .app:has(.users-page) .topbar { gap: 8px; padding-left: 12px; padding-right: 12px; }
  .app:has(.users-page) .brand-mini { display: none; }
}
</style>

<%
  var userExtraActions = `
    <a class="btn-banner-sub" href="/users/new" onclick="if(window.openNewAccountModal){openNewAccountModal();return false;}">${icon('plus')} New Account</a>
  `;
%>

<div class="users-page">
<%- include('../partials/header-banner', {
  title: 'User Accounts',
  subtitle: 'Manage administrative privileges, technicians, faculty, and student requesters.',
  extraActions: userExtraActions
}) %>

<!-- Pending Approvals Alert Banner (Quick Link to Approvals Tab) -->
<% if (typeof pendingUsers !== 'undefined' && pendingUsers.length) { %>
  <div class="users-pending-notice">
    <div class="users-pending-notice-copy">
      <span class="users-pending-notice-icon"><%- icon('shield') %></span>
      <div>
        <strong><%= pendingUsers.length %> Account Registration<%= pendingUsers.length > 1 ? 's' : '' %> Waiting for Approval</strong>
        <p>New user accounts need admin approval before they can log in.</p>
      </div>
    </div>
    <a href="/users/approvals" class="btn btn-sm btn-primary users-notice-link">
      <%- icon('shield') %> Review in Approvals &rarr;
    </a>
  </div>
<% } %>

<div class="users-section-head"><h2>Search &amp; Filters</h2></div>
<form class="card filters" method="get" action="/users" data-auto-filter data-auto-results="#users-results">
  <div class="field wide">
    <label for="q">Search</label>
    <span class="search-input">
      <span class="search-input-icon"><%- icon('search') %></span>
      <input type="search" id="q" name="q" value="<%= f.q %>" placeholder="Name, email, department, student ID">
    </span>
  </div>
  <div class="field">
    <label for="role">Role</label>
    <select data-ec-select="1" id="role" name="role">
      <option value="">All Roles</option>
      <% Object.keys(C.ROLES).forEach(function (k) { %><option value="<%= k %>" <%= f.role === k ? 'selected' : '' %>><%= C.ROLES[k] %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="status">Status</label>
    <select data-ec-select="1" id="status" name="status">
      <option value="" <%= !f.status ? 'selected' : '' %>>All Statuses</option>
      <option value="pending" <%= f.status === 'pending' ? 'selected' : '' %>>Pending Approval</option>
      <option value="approved" <%= f.status === 'approved' ? 'selected' : '' %>>Active / Approved</option>
      <option value="inactive" <%= f.status === 'inactive' ? 'selected' : '' %>>Inactive / Deactivated</option>
    </select>
  </div>
  <div class="actions"><a class="btn btn-light" href="/users" data-filter-clear>Clear</a></div>
</form>

<div class="card users-table-card" id="users-results" data-auto-results>
  <div class="table-wrap">
  <table class="stack-table users-table">
    <colgroup>
      <col><col><col><col><col><col><col>
    </colgroup>
    <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Department</th><th>Status</th><th>Last sign-in</th><th>Actions</th></tr></thead>
    <tbody>
      <% if (!users.length) { %><tr><td colspan="7" class="empty">No accounts found.</td></tr><% } %>
      <% users.forEach(function (u) { %>
        <tr>
          <td data-label="Name" class="users-col-name">
            <div class="ec-identity ec-identity--table">
              <%- include('../partials/avatar', { user: u, name: u.name, size: 'sm' }) %>
              <span class="ec-identity__text">
                <strong class="users-name"><%= u.name %></strong>
                <% if (u.studentId) { %><span class="sub users-sub ec-identity__meta">ID: <%= u.studentId %></span><% } %>
                <% if (u.role === 'technician') { %><span class="sub users-sub ec-identity__meta"><a href="/technicians/<%= u.id %>">Technician profile</a></span><% } %>
              </span>
            </div>
          </td>
          <td data-label="Email" class="users-col-email"><%= u.email %></td>
          <td data-label="Role" class="users-col-role"><span class="badge <%= u.role === 'admin' ? 'badge-indigo' : u.role === 'technician' ? 'badge-teal' : 'badge-gray' %>"><%= C.ROLES[u.role] %></span></td>
          <td data-label="Department" class="users-col-department">
            <% if (u.role === 'requester' && (u.gradeLevel || u.section)) { %>
              <%= u.gradeLevel || '—' %>
              <span class="sub users-sub">Section: <%= u.section || 'None assigned' %></span>
            <% } else { %>
              <%= u.department || '—' %>
            <% } %>
          </td>
          <td data-label="Status" class="users-col-status">
            <% if (u.approvalStatus === 'pending') { %>
              <span class="badge badge-amber"><%- icon('clock') %> Pending</span>
            <% } else if (u.approvalStatus === 'rejected') { %>
              <span class="badge badge-red"><%- icon('x-circle') %> Rejected</span>
            <% } else if (u.active) { %>
              <span class="badge badge-green"><%- icon('check-circle') %> Active</span>
            <% } else { %>
              <span class="badge badge-gray">Inactive</span>
            <% } %>
          </td>
          <td data-label="Last sign-in" class="users-col-last nowrap"><%= u.lastLoginAt ? timeAgo(u.lastLoginAt) : 'Never' %></td>
          <td data-label="" class="users-col-actions">
            <div class="row-actions">
              <% if (u.approvalStatus === 'pending') { %>
                <a class="btn btn-light btn-sm" href="/users/approvals" title="Review in Approvals tab"><%- icon('shield') %> Review</a>
                <form method="post" action="/users/<%= u.id %>/approve" class="inline-form" data-confirm="Approve <%= u.name %>?">
                  <button class="btn btn-success btn-sm" type="submit"><%- icon('check') %> Approve</button>
                </form>
                <button class="btn btn-danger btn-sm js-reject-account" type="button" data-id="<%= u.id %>" data-name="<%= u.name %>"><%- icon('x') %> Reject</button>
              <% } else { %>
                <a class="btn btn-light btn-sm users-action-edit" href="/users/<%= u.id %>/edit"><%- icon('edit') %> Edit</a>
                <% if (u.id !== currentUser.id) { %>
                  <form method="post" action="/users/<%= u.id %>/toggle" class="inline-form" data-confirm="<%= u.active ? 'Deactivate' : 'Activate' %> <%= u.name %>?">
                    <button class="btn btn-light btn-sm users-action-toggle <%= u.active ? 'users-action-deactivate' : '' %>" type="submit"><%- icon(u.active ? 'pause' : 'check-circle') %> <%= u.active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                <% } %>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
</div><!-- /.users-page -->
<%- include('../partials/reject-account-modal') %>
<%- include('../partials/footer') %>
