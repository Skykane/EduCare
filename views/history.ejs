<%- include('partials/header') %>
<%
  var histExtraActions = '';
  if (currentUser.role === 'admin') {
    histExtraActions = `<a class="btn-banner-sub" href="/reports/export/maintenance${qs({ from: f.from, to: f.to })}">${icon('upload')} Export CSV</a>`;
  }
%>
<%- include('partials/header-banner', {
  breadcrumb: '<a href="/">Home</a> &rsaquo; Maintenance History',
  title: 'Maintenance Service History',
  subtitle: 'History log of ' + rows.length + ' completed equipment repairs and checkups.',
  extraActions: histExtraActions
}) %>

<form class="card filters" method="get" action="/history">
  <div class="field wide"><label for="q">Search</label><input type="search" id="q" name="q" value="<%= f.q %>" placeholder="Problem, action, part, equipment"></div>
  <div class="field">
    <label for="equipmentId">Equipment</label>
    <select id="equipmentId" name="equipmentId">
      <option value="">All</option>
      <% equipment.forEach(function (e) { %><option value="<%= e.id %>" <%= f.equipmentId === e.id ? 'selected' : '' %>><%= e.code %> – <%= e.name %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="categoryId">Category</label>
    <select id="categoryId" name="categoryId">
      <option value="">All</option>
      <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= f.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="location">Location</label>
    <select id="location" name="location">
      <option value="">All</option>
      <% locations.forEach(function (l) { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
  </div>
  <% if (currentUser.role !== 'technician') { %>
  <div class="field">
    <label for="technicianId">Technician</label>
    <select id="technicianId" name="technicianId">
      <option value="">All</option>
      <% technicians.forEach(function (t) { %><option value="<%= t.id %>" <%= f.technicianId === t.id ? 'selected' : '' %>><%= t.name %></option><% }) %>
    </select>
  </div>
  <% } %>
  <div class="field">
    <label for="type">Type</label>
    <select id="type" name="type">
      <option value="">All</option>
      <% C.REQUEST_TYPES.forEach(function (t) { %><option <%= f.type === t ? 'selected' : '' %>><%= t %></option><% }) %>
    </select>
  </div>
  <div class="field"><label for="from">Service date from</label><input type="date" id="from" name="from" value="<%= f.from %>"></div>
  <div class="field"><label for="to">to</label><input type="date" id="to" name="to" value="<%= f.to %>"></div>
  <div class="actions"><button class="btn" type="submit">Filter</button><a class="btn btn-light" href="/history">Clear</a></div>
</form>

<div class="card">
  <div class="table-wrap">
  <table class="stack-table">
    <thead><tr><th>Service date</th><th>Equipment</th><th>Type</th><th>Problem identified</th><th>Actions performed</th><th>Parts replaced</th><th>Technician</th><th>Result</th></tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="8" class="empty">No maintenance records match your filters.</td></tr><% } %>
      <% rows.forEach(function (m) { %>
        <tr>
          <td class="nowrap"><%= fmtDate(m.serviceDate) %><% if (m.request) { %><span class="sub"><a href="/requests/<%= m.request.id %>" class="mono"><%= m.request.code %></a></span><% } %></td>
          <td><% if (m.equipment) { %><a href="/equipment/<%= m.equipment.id %>"><%= m.equipment.name %></a><span class="sub"><%= m.equipment.code %> · <%= m.equipment.location %></span><% } else { %>—<% } %></td>
          <td><span class="<%= statusClass(m.type) %>"><%= m.type %></span></td>
          <td><%= m.problem || '—' %></td>
          <td><%= m.actionsTaken %><% if (m.remarks) { %><span class="sub"><%= m.remarks %></span><% } %></td>
          <td><%= m.partsReplaced || '—' %></td>
          <td><%= m.technician ? m.technician.name : '—' %></td>
          <td><span class="<%= statusClass(m.resultingStatus) %>"><%= m.resultingStatus %></span></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('partials/footer') %>
