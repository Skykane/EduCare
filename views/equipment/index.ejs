<%- include('../partials/header') %>
<%
  var eqExtraActions = '';
  if (currentUser.role === 'admin') {
    eqExtraActions = `
      <a class="btn-banner-sub" href="/equipment/new">${icon('plus')} Add Equipment</a>
      <a class="btn-banner-sub" href="/reports/export/equipment">${icon('upload')} Export CSV</a>
    `;
  }
%>
<div class="admin-ui-page admin-ui-equipment">
  <%- include('../partials/header-banner', {
    breadcrumb: '<a href="/">Home</a> &rsaquo; Equipment',
    title: 'Equipment Inventory',
    subtitle: 'List of all school equipment, locations, condition, and maintenance checkups.',
    extraActions: eqExtraActions
  }) %>

  <form class="admin-ui-filter-card" method="get" action="/equipment" data-auto-filter data-auto-results="#equipment-results">
    <div class="admin-ui-filter-grid">
      <div class="admin-ui-field wide">
        <label for="q">Search</label>
        <span class="search-input">
          <span class="search-input-icon"><%- icon('search') %></span>
          <input type="search" id="q" name="q" value="<%= f.q %>" placeholder="ID, name, model, or serial number" aria-label="Search equipment">
        </span>
      </div>
      <div class="admin-ui-field">
        <label for="categoryId">Category</label>
        <select id="categoryId" name="categoryId" data-ec-select="1">
          <option value="">All</option>
          <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= f.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
        </select>
      </div>
      <div class="admin-ui-field">
        <label for="location">Location</label>
        <select id="location" name="location" data-ec-select="1">
          <option value="">All</option>
          <% if (typeof C !== 'undefined' && C.CAMPUS_ROOMS) { %>
            <% Object.keys(C.CAMPUS_ROOMS).forEach(function (groupName) { %>
              <optgroup label="<%= groupName %>">
                <% C.CAMPUS_ROOMS[groupName].forEach(function (room) { %>
                  <option value="<%= room %>" <%= f.location === room ? 'selected' : '' %>><%= room %></option>
                <% }) %>
              </optgroup>
            <% }) %>
            <% var _selLoc = f.location || ''; %>
            <% if (_selLoc && !C.CAMPUS_LOCATIONS.includes(_selLoc)) { %>
              <option value="<%= _selLoc %>" selected><%= _selLoc %> (Current)</option>
            <% } %>
          <% } else { %>
            <% locations.forEach(function (l) { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
          <% } %>
        </select>
      </div>
      <div class="admin-ui-field">
        <label for="department">Department</label>
        <select id="department" name="department" data-ec-select="1">
          <option value="">All</option>
          <% departments.forEach(function (d) { %><option <%= f.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
        </select>
      </div>
      <div class="admin-ui-field">
        <label for="status">Condition</label>
        <select id="status" name="status" data-ec-select="1">
          <option value="">All</option>
          <% C.EQUIPMENT_STATUSES.forEach(function (s) { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
      <div class="admin-ui-field">
        <label for="pm">Checkup Status</label>
        <select id="pm" name="pm" data-ec-select="1">
          <option value="">All</option>
          <% ['Overdue', 'Due Soon', 'Scheduled', 'No maintenance recorded'].forEach(function (s) { %><option <%= f.pm === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
      <div class="admin-ui-actions">
        <a class="btn btn-light" href="/equipment" data-filter-clear>Clear</a>
      </div>
    </div>
  </form>

  <div id="equipment-results" data-auto-results>
  <section class="admin-ui-card">
    <div class="admin-ui-card-head">
      <div>
        <h2>Equipment records (<%= rows.length %>)</h2>
        <p class="admin-ui-muted">Click a name or View Details to inspect specifications, checkup status, and active requests.</p>
      </div>
    </div>
    <div class="admin-ui-table-box equipment-table-wrap">
      <table class="stack-table admin-ui-table equipment-table">
        <thead>
          <tr>
            <th class="au-center">Equipment ID</th>
            <th class="au-left">Name</th>
            <th class="au-center">Category</th>
            <th class="au-left">Location</th>
            <th class="au-center">Condition</th>
            <th class="au-center">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="6" class="empty">No equipment matches your filters.</td></tr>
          <% } %>
          <% rows.forEach(function (e) { %>
            <tr>
              <td data-label="Equipment ID" class="au-center">
                <a class="mono admin-ui-code" href="/equipment/<%= e.id %>" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);return false;}"><strong><%= e.code %></strong></a>
              </td>
              <td data-label="Name" class="au-left">
                <span class="eq-media">
                  <% if (e.photo) { %>
                    <img src="/uploads/<%= e.photo %>" alt="" class="eq-thumb" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-grid';">
                    <span class="eq-thumb-placeholder" style="display:none;"><%- icon(categoryIcon(e.category ? e.category.name : '')) %></span>
                  <% } else { %>
                    <span class="eq-thumb-placeholder"><%- icon(categoryIcon(e.category ? e.category.name : '')) %></span>
                  <% } %>
                  <span>
                    <a class="admin-ui-primary-link" href="/equipment/<%= e.id %>" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);return false;}"><strong><%= e.name %></strong></a>
                  </span>
                </span>
              </td>
              <td data-label="Category" class="au-center"><%= e.category ? e.category.name : '—' %></td>
              <td data-label="Location" class="au-left"><%= e.location %></td>
              <td data-label="Condition" class="au-center"><span class="<%= statusClass(e.status) %>"><%= e.status %></span></td>
              <td data-label="Action" class="au-center">
                <button type="button" class="btn btn-sm btn-light" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);}" title="View all specifications and details">
                  <%- icon('eye') %> View Details
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
    <script type="application/json" id="equipment-map-json"><%- JSON.stringify(rows.reduce(function(acc, r) {
      acc[r.id] = {
        id: r.id,
        code: r.code,
        name: r.name,
        model: r.model,
        serialNumber: r.serialNumber,
        department: r.department,
        location: r.location,
        status: r.status,
        importance: r.importance,
        acquisitionDate: r.acquisitionDate,
        notes: r.notes,
        photo: r.photo,
        category: r.category ? { name: r.category.name, id: r.category.id } : null,
        schedule: r.schedule ? {
          nextDue: r.schedule.hasHistory ? fmtDate(r.schedule.nextDue) : null,
          base: r.schedule.hasHistory ? fmtDate(r.schedule.base) : null,
          basedOn: r.schedule.basedOn,
          hasHistory: !!r.schedule.hasHistory,
          status: r.schedule.status,
          interval: r.schedule.interval
        } : null,
        openRequests: r.openRequests || 0
      };
      return acc;
    }, {})).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026') %></script>
  </div>
  <script>
    window.educareSetEquipmentMap = function (map) { window.EQUIPMENT_MAP = map; };
    window.educareSetEquipmentMap(JSON.parse(document.getElementById('equipment-map-json').textContent));
  </script>
  <%- include('../partials/equipment-details-modal') %>
</div>
<%- include('../partials/footer') %>
