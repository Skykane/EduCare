<%- include('../partials/header') %>
<%
  var eqExtraActions = '';
  if (currentUser.role === 'admin') {
    eqExtraActions = `
      <a class="btn-banner-sub" href="/equipment/new">${icon('plus')} Add Equipment</a>
      <a class="btn-banner-sub" href="/reports/export/equipment">${icon('upload')} Export CSV</a>
    `;
  }
%>
<%- include('../partials/header-banner', {
  breadcrumb: '<a href="/">Home</a> &rsaquo; Equipment',
  title: 'Equipment Inventory',
  subtitle: 'List of all school equipment, locations, condition, and maintenance checkups.',
  extraActions: eqExtraActions
}) %>

<form class="card filters" method="get" action="/equipment">
  <div class="field wide">
    <label for="q">Search</label>
    <input type="search" id="q" name="q" value="<%= f.q %>" placeholder="ID, name, model, or serial number">
  </div>
  <div class="field">
    <label for="categoryId">Category</label>
    <select id="categoryId" name="categoryId">
      <option value="">All</option>
      <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= f.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="location">Location</label>
    <select id="location" name="location">
      <option value="">All</option>
      <% if (typeof C !== 'undefined' && C.HIGH_SCHOOL_ROOMS) { %>
        <% Object.keys(C.HIGH_SCHOOL_ROOMS).forEach(function (groupName) { %>
          <optgroup label="<%= groupName %>">
            <% C.HIGH_SCHOOL_ROOMS[groupName].forEach(function (room) { %>
              <option value="<%= room %>" <%= f.location === room ? 'selected' : '' %>><%= room %></option>
            <% }) %>
          </optgroup>
        <% }) %>
        <% var otherLocs = (locations || []).filter(function (l) { return !C.HIGH_SCHOOL_LOCATIONS.includes(l); }); %>
        <% if (otherLocs.length > 0) { %>
          <optgroup label="Other Locations">
            <% otherLocs.forEach(function (room) { %>
              <option value="<%= room %>" <%= f.location === room ? 'selected' : '' %>><%= room %></option>
            <% }) %>
          </optgroup>
        <% } %>
      <% } else { %>
        <% locations.forEach(function (l) { %><option <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
      <% } %>
    </select>
  </div>
  <div class="field">
    <label for="department">Department</label>
    <select id="department" name="department">
      <option value="">All</option>
      <% departments.forEach(function (d) { %><option <%= f.department === d ? 'selected' : '' %>><%= d %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="status">Condition</label>
    <select id="status" name="status">
      <option value="">All</option>
      <% C.EQUIPMENT_STATUSES.forEach(function (s) { %><option <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div class="field">
    <label for="pm">Checkup Status</label>
    <select id="pm" name="pm">
      <option value="">All</option>
      <% ['Overdue', 'Due Soon', 'Scheduled'].forEach(function (s) { %><option <%= f.pm === s ? 'selected' : '' %>><%= s %></option><% }) %>
    </select>
  </div>
  <div class="actions">
    <button class="btn" type="submit">Filter</button>
    <a class="btn btn-light" href="/equipment">Clear</a>
  </div>
</form>

<div class="card">
  <div class="table-wrap">
  <table class="stack-table">
    <thead>
      <tr>
        <th style="width:140px;white-space:nowrap;">Equipment ID</th>
        <th>Name</th>
        <th style="width:160px;white-space:nowrap;">Category</th>
        <th style="width:180px;white-space:nowrap;">Location</th>
        <th style="width:160px;white-space:nowrap;text-align:center;">Condition</th>
        <th style="width:150px;white-space:nowrap;text-align:right;">Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">No equipment matches your filters.</td></tr><% } %>
      <% rows.forEach(function (e) { %>
        <tr>
          <td class="nowrap"><a class="mono" href="/equipment/<%= e.id %>" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);return false;}"><strong><%= e.code %></strong></a></td>
          <td>
            <div class="eq-media">
              <% if (e.photo) { %>
                <img src="/uploads/<%= e.photo %>" alt="" class="eq-thumb" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='inline-grid';">
                <span class="eq-thumb-placeholder" style="display:none;"><%- icon(categoryIcon(e.category ? e.category.name : '')) %></span>
              <% } else { %>
                <span class="eq-thumb-placeholder"><%- icon(categoryIcon(e.category ? e.category.name : '')) %></span>
              <% } %>
              <div>
                <a href="/equipment/<%= e.id %>" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);return false;}"><strong><%= e.name %></strong></a>
              </div>
            </div>
          </td>
          <td><%= e.category ? e.category.name : '—' %></td>
          <td><%= e.location %></td>
          <td style="text-align:center;"><span class="<%= statusClass(e.status) %>"><%= e.status %></span></td>
          <td style="text-align:right;" class="nowrap">
            <button type="button" class="btn btn-sm btn-light" onclick="if(window.openEquipmentDetailsModal){openEquipmentDetailsModal(<%= e.id %>);}" title="View all specifications and details" style="padding:6px 14px;font-size:12.5px;display:inline-flex;align-items:center;gap:6px;font-weight:600;">
              <%- icon('eye') %> View Details
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>

<script>
  window.EQUIPMENT_MAP = <%- JSON.stringify(rows.reduce(function(acc, r) {
    acc[r.id] = {
      id: r.id,
      code: r.code,
      name: r.name,
      model: r.model,
      serialNumber: r.serialNumber,
      department: r.department,
      location: r.location,
      status: r.status,
      importance: r.importance,
      acquisitionDate: r.acquisitionDate,
      notes: r.notes,
      photo: r.photo,
      category: r.category ? { name: r.category.name, id: r.category.id } : null,
      schedule: r.schedule ? { nextDue: fmtDate(r.schedule.nextDue), status: r.schedule.status, interval: r.schedule.interval } : null,
      openRequests: r.openRequests || 0
    };
    return acc;
  }, {})) %>;
</script>
<%- include('../partials/equipment-details-modal') %>
<%- include('../partials/footer') %>
