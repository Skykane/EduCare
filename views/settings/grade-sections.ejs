<%- include('../partials/header') %>

<style>
  .gs-page, .gs-page * { text-align: left; }
  .gs-page .dash-header-banner { text-align: left; }
  /* Section tabs: full-width, left aligned, matching Equipment Inventory. */
  .app .gs-page .section-tabs {
    display: flex !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0;
    box-sizing: border-box !important;
    margin: 0 0 14px !important;
    padding: 5px 10px !important;
    gap: 5px !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    justify-content: flex-start !important;
    overflow-x: auto !important;
    /* Swipe/scroll behaviour: keep gestures inside this strip only. */
    -webkit-overflow-scrolling: touch !important;
    overscroll-behavior-x: contain !important;
    touch-action: pan-x pan-y !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    background: var(--gray-soft) !important;
    border: 1px solid var(--border) !important;
    border-radius: 10px !important;
  }
  .app .gs-page .section-tabs::-webkit-scrollbar { display: none !important; }
  .app .gs-page .section-tabs a {
    flex: 0 0 auto;
    padding: 7px 14px !important;
    min-height: 0 !important;
    border-radius: 7px !important;
    font-size: 12.5px !important;
    font-weight: 700 !important;
    text-align: center !important;
    white-space: nowrap !important;
    touch-action: pan-x pan-y !important;
    background: transparent !important;
    color: var(--muted) !important;
  }
  .app .gs-page .section-tabs a:hover { color: var(--text) !important; text-decoration: none; }
  .app .gs-page .section-tabs a.active {
    background: #ffffff !important;
    color: var(--primary) !important;
    box-shadow: var(--shadow) !important;
  }
  .gs-card { padding: 14px 16px !important; margin-bottom: 12px; }
  .app .gs-page .gs-card h2 { margin: 0; color: var(--text); text-align: left !important; }
  .gs-form-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px; }
  .gs-form-title { display: inline-flex; align-items: center; justify-content: flex-start; gap: 8px; min-width: 0; }
  .gs-form-title-icon {
    width: 26px; height: 26px; flex: 0 0 26px;
    display: inline-grid; place-items: center;
    border-radius: 8px; background: var(--primary-soft); color: var(--primary);
  }
  .gs-form-title-icon .ic { width: 14px; height: 14px; }
  .gs-note { margin: 0; line-height: 1.5; color: var(--muted); }
  .gs-form-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.9fr) minmax(220px, 1.1fr) auto;
    align-items: end;
    gap: 12px;
  }
  .gs-form-row .field { margin: 0; min-width: 0; }
  .gs-form-row label {
    display: block; margin: 0 0 5px;
    color: var(--text); text-align: left !important;
  }
  .gs-form-row select,
  .gs-form-row input:not([type='hidden']) {
    display: block; width: 100%; min-width: 0; height: 38px;
    padding: 0 11px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--surface); color: var(--text); font: inherit;
    text-align: left !important;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .app .gs-page .gs-form-row input:not([type='checkbox']):not([type='radio']):not([type='file']):not([type='hidden']),
  .app .gs-page .gs-form-row select {
    text-align: left !important;
  }
  .gs-page .gs-form-row input::placeholder,
  .gs-page .gs-form-row select option { color: var(--muted); text-align: left !important; }
  .gs-page .gs-form-row select:focus,
  .gs-page .gs-form-row input:focus {
    outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(140, 23, 36, 0.14);
  }
  .gs-form-actions {
    display: flex; flex-wrap: nowrap; gap: 8px;
    align-items: center; justify-content: flex-end; min-width: 0;
  }
  .gs-form-row .btn {
    height: 38px; padding: 0 14px; border-radius: 8px;
    box-shadow: 0 2px 8px rgba(110, 15, 23, 0.18);
  }
  .gs-form-row .btn .ic { width: 14px; height: 14px; }
  .gs-form-row .btn-primary:hover:not(:disabled) {
    background: #5c0b13; box-shadow: 0 4px 12px rgba(110, 15, 23, 0.24);
  }
  .gs-form-row .btn-primary:active:not(:disabled) {
    transform: translateY(1px); box-shadow: 0 1px 4px rgba(110, 15, 23, 0.22);
  }
  .gs-form-row .btn:disabled { opacity: 0.55; cursor: not-allowed; box-shadow: none; }
  .gs-form-row .btn:focus-visible { outline: 3px solid rgba(140, 23, 36, 0.28); outline-offset: 2px; }
  @media (max-width: 760px) {
    .gs-form-row { grid-template-columns: 1fr; gap: 10px; }
    .gs-form-actions { width: 100%; justify-content: stretch; }
    .gs-form-row .btn { width: 100%; }
  }
  .gs-table-wrap { overflow-x: auto; }
  .gs-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .gs-table th, .gs-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
  .gs-table th { font-size: 11.5px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .gs-table tbody tr:last-child td { border-bottom: 0; }
  .gs-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .gs-empty { padding: 22px 12px; color: var(--muted); text-align: center !important; }
  .gs-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 99px; font-size: 11.5px; font-weight: 700; }
  .gs-badge.active { background: rgba(22, 163, 74, .12); color: #15803d; }
  .gs-badge.inactive { background: rgba(100, 116, 139, .14); color: #64748b; }
  [data-theme="dark"] .gs-badge.active { color: #86efac; }
  [data-theme="dark"] .gs-badge.inactive { color: #cbd5e1; }
</style>

<div class="gs-page">
  <%- include('../partials/header-banner', {
    title: 'Grade & Section Management',
    subtitle: 'Configure the official grade levels and sections offered in Student registration.'
  }) %>

  <div class="card gs-card">
    <% if (editing) { %>
      <h2>Edit section</h2>
      <p class="gs-note">Change the grade or section name below. Deactivating a section is done from the list.</p>
      <form method="post" action="/settings/grade-sections/<%= editing.id %>/edit" class="gs-form-row">
        <div class="field">
          <label for="edit-gradeLevel">Grade Level</label>
          <select data-ec-select="1" id="edit-gradeLevel" name="gradeLevel" required>
            <% grades.forEach(function (grade) { %>
              <option value="<%= grade %>" <%= form.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option>
            <% }) %>
          </select>
        </div>
        <div class="field section-field">
          <label for="edit-section">Section Name</label>
          <input id="edit-section" name="section" type="text" value="<%= form.section %>" maxlength="50" required placeholder="e.g. STEM A">
        </div>
        <div class="gs-form-actions">
          <button class="btn btn-primary" type="submit"><%- icon('check') %> Save Changes</button>
          <a class="btn btn-light" href="/settings/grade-sections">Cancel</a>
        </div>
      </form>
    <% } else { %>
      <div class="gs-form-head">
        <div class="gs-form-title">
          <span class="gs-form-title-icon"><%- icon('building') %></span>
          <h2>Add a Grade & Section</h2>
        </div>
        <p class="gs-note muted">
          Grades 7&ndash;12 only. Add the sections used by your school; each active entry appears as one
          <strong>Grade &amp; Section</strong> option in Student registration. Duplicate sections under the same grade are blocked.
        </p>
      </div>
      <form method="post" action="/settings/grade-sections/add" class="gs-form-row">
        <div class="field">
          <label for="add-gradeLevel">Grade Level</label>
          <select data-ec-select="1" id="add-gradeLevel" name="gradeLevel" required>
            <option value="">Select a grade</option>
            <% grades.forEach(function (grade) { %>
              <option value="<%= grade %>" <%= form.gradeLevel === grade ? 'selected' : '' %>><%= grade %></option>
            <% }) %>
          </select>
        </div>
        <div class="field section-field">
          <label for="add-section">Section Name</label>
          <input id="add-section" name="section" type="text" value="<%= form.section %>" maxlength="50" required placeholder="e.g. STEM A">
        </div>
        <div class="gs-form-actions">
          <button class="btn btn-primary" type="submit"><%- icon('plus') %> Add Section</button>
        </div>
      </form>
    <% } %>
  </div>

  <div class="card gs-card">
    <h2>Configured sections (<%= rows.length %>)</h2>
    <p class="gs-note">Inactive sections are kept for historical records but are hidden from new registrations.</p>
    <div class="gs-table-wrap">
      <table class="gs-table">
        <thead>
          <tr><th>Grade Level</th><th>Section</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="4" class="gs-empty">No sections have been configured yet. Add the school's first grade &amp; section using the form above.</td></tr>
          <% } %>
          <% rows.forEach(function (row) { %>
            <tr>
              <td data-label="Grade Level"><%= row.gradeLevel %></td>
              <td data-label="Section"><strong><%= row.section %></strong></td>
              <td data-label="Status">
                <span class="gs-badge <%= isActive(row) ? 'active' : 'inactive' %>"><%= isActive(row) ? 'Active' : 'Inactive' %></span>
              </td>
              <td data-label="Actions">
                <div class="gs-actions">
                  <a class="btn btn-light btn-sm" href="/settings/grade-sections?edit=<%= row.id %>"><%- icon('edit') %> Edit</a>
                  <form method="post" action="/settings/grade-sections/<%= row.id %>/toggle" class="inline-form" data-confirm="<%= isActive(row) ? 'Deactivate' : 'Activate' %> <%= row.section %>?">
                    <button class="btn <%= isActive(row) ? 'btn-light' : 'btn-success' %> btn-sm" type="submit">
                      <%- icon(isActive(row) ? 'pause' : 'check-circle') %> <%= isActive(row) ? 'Deactivate' : 'Activate' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
