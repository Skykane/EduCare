<%- include('partials/header') %>

<div class="page-head">
  <div>
    <h1>Set Your Password</h1>
    <p class="muted">Your account was created with a temporary password. Choose a new one to continue.</p>
  </div>
</div>

<div class="card card-floating" style="max-width:560px;margin:0 auto;">
  <div class="alert alert-info">
    <strong>Action required:</strong> you must replace the temporary password before accessing the rest of EduCare.
    Use at least 8 characters, including letters and numbers or symbols.
  </div>

  <form method="post" action="/profile/password">
    <div class="field">
      <label for="current">Temporary / Current Password <span class="req">*</span></label>
      <div class="pw-toggle-wrap">
        <input type="password" id="current" name="current" required autocomplete="current-password" autofocus>
        <button type="button" class="btn-toggle-pw" data-target="current" aria-label="Show password" title="Show password" aria-pressed="false"><%- icon('eye') %></button>
      </div>
    </div>
    <div class="field">
      <label for="password">New Password <span class="req">*</span></label>
      <div class="pw-toggle-wrap">
        <input type="password" id="password" name="password" minlength="8" required autocomplete="new-password">
        <button type="button" class="btn-toggle-pw" data-target="password" aria-label="Show password" title="Show password" aria-pressed="false"><%- icon('eye') %></button>
      </div>
    </div>
    <div class="field">
      <label for="confirm">Confirm New Password <span class="req">*</span></label>
      <div class="pw-toggle-wrap">
        <input type="password" id="confirm" name="confirm" minlength="8" required autocomplete="new-password">
        <button type="button" class="btn-toggle-pw" data-target="confirm" aria-label="Show password" title="Show password" aria-pressed="false"><%- icon('eye') %></button>
      </div>
    </div>
    <div class="maintenance-actions" style="padding:16px 0 0;border-top:0;background:transparent;">
      <button class="btn" type="submit"><%- icon('lock') %> Save New Password</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
